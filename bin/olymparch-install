term_background_bright: ff08080c
term_foreground_bright: ffea76
term_palette: 08080c;e0605e;d4a73a;f4c634;3a3644;b08ad0;6fb3c0;e8e6df
term_palette_bright: 3a3644;f08a88;f4c634;ffea76;9cbde6;c9a9e3;93cad4;ffffff
term_font_scale: 2x2
term_margin: 0
term_margin_gradient: 0
interface_help_hidden: yes
interface_help_colour: d4a73a
interface_help_colour_bright: ffea76
interface_branding:
EOF
# snapper wants to create /.snapshots itself; we keep our own @snapshots subvolume mounted there instead
umount /mnt/.snapshots
rmdir /mnt/.snapshots
arch-chroot /mnt snapper --no-dbus -c root create-config /
btrfs -q subvolume delete /mnt/.snapshots
mkdir /mnt/.snapshots
mount -o "$opts,subvol=@snapshots" /dev/mapper/root /mnt/.snapshots
chmod 750 /mnt/.snapshots
arch-chroot /mnt snapper --no-dbus -c root set-config TIMELINE_CREATE=no NUMBER_LIMIT=10 NUMBER_LIMIT_IMPORTANT=5 NUMBER_MIN_AGE=0
arch-chroot /mnt systemctl enable snapper-cleanup.timer >/dev/null 2>&1
arch-chroot /mnt snapper --no-dbus -c root create --type single --description "installert" --cleanup-algorithm number
arch-chroot /mnt olymparch-boot sync

# Self-check before the disk is closed: what every user and pacman's download user (alpm) must be able to read.
# A umask leak once made all of this 0700/0600: no /etc/profile for the user, no DNS for pacman in the chroot.
step "$(L "Checking the installed system" "Sjekker det installerte systemet")"
bad=''
mode_is() {  # mode_is MODE PATH...: each existing path has exactly that mode
    local want=$1 f m; shift
    for f in "$@"; do [ -e "/mnt$f" ] || continue; m=$(stat -c %a "/mnt$f"); [ "$m" = "$want" ] || bad+=" $f ($m)"; done
}
mode_is 755 /etc /etc/profile.d /etc/pacman.d /etc/systemd /var /var/lib /var/lib/pacman /usr /usr/bin /usr/lib /usr/share \
    /usr/share/olymparch /usr/lib/olymparch /usr/share/plymouth/themes/olymparch /etc/olymparch
mode_is 644 /etc/profile /etc/profile.d/zz-olymparch-session.sh /etc/fstab /etc/locale.conf /etc/hostname /etc/vconsole.conf \
    /etc/passwd /etc/group /etc/pacman.conf /usr/lib/locale/locale-archive /usr/lib/os-release
# and nothing Olymparch put in place is closed to other users
while IFS= read -r f; do bad+=" ${f#/mnt} ($(stat -c %a "$f"))"; done < <(find /mnt/usr/share/olymparch /mnt/usr/lib/olymparch \
    /mnt/usr/share/plymouth/themes/olymparch /mnt/etc/olymparch /mnt/etc/xdg/foot -xdev \( -type d ! -perm -005 -o -type f ! -perm -004 \) 2>/dev/null | head -n 20)
# as the user and as alpm, without PAM (setpriv, not runuser: no login session in the chroot). stdin is
# /dev/null: the installer runs on tty1, and a login shell on tty1 is the one the session script turns into the
# desktop (it would try to start Hyprland, and switch off echo on the installer's console).
as_user() { local u=$1; shift; arch-chroot /mnt setpriv --reuid "$u" --regid "$u" --init-groups env -i HOME=/ PATH=/usr/bin "$@" </dev/null 2>&1; }
me=$(as_user "$USERNAME" sh -c '. /etc/profile >/dev/null 2>&1; id -un' | tail -n 1)
[ "$me" = "$USERNAME" ] || bad+=" ($USERNAME cannot read /etc/profile or has no name: «$me»)"
as_user alpm test -r /etc/pacman.conf >/dev/null || bad+=" (pacman's user alpm cannot read /etc)"
[ -z "$bad" ] || die "$(L "wrong permissions in the installed system:$bad" "feil rettigheter i det installerte systemet:$bad")"
[ "${OLYMPARCH_TEST:-0}" = 1 ] && echo '<2>TARGET-CHECK-OK' >/dev/kmsg

rm -f -- "$2"   # the answers file holds the password in plain text
if [ -z "$KEYFILE" ]; then
    printf '\n  %s:\n\n    %s\n' "$(L "Recovery key (unlocks the disk if you forget the password; write it down)" \
        "Gjenopprettingsnøkkel (låser opp disken hvis du glemmer passordet; skriv den ned)")" "$RECOVERY_KEY"
fi
step "$(L "Done. Remove the installation medium and restart." "Ferdig. Ta ut installasjonsmediet og start på nytt.")"
umount -R /mnt
cryptsetup close root
