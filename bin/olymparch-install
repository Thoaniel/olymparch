#!/bin/bash
# Olymparch installer, piece 2: unattended install from an answers file. The interactive wizard is olymparch-setup.
# and will write the same answers file.
#
#   olymparch-install --answers FILE [--recovery-key-file FILE]
#
# The disk also gets a recovery key (systemd-cryptenroll). It is written to the --recovery-key-file (mode 0600,
# for the wizard to show), or printed at the end when there is none. It is never stored on the installed system.
#
# Answers (bash syntax): DISK, DISK_SERIAL, HOSTNAME, USERNAME, PASSWORD, KEYMAP, LOCALE, TIMEZONE, KERNEL,
# OPTIONS (comma list: games,emu,zeus,discord,spotify,obs,code,hibernate, and from the second checklist
# lutris,moonlight,minecraft,cloud,obsidian,localsend,neovim,helix,zed,shelltools,tuis,alacritty,kitty,ghostty),
# AGENTS (comma list of default/agents ids: installed as the user at the first login)
# Safety: DISK_SERIAL must match the disk's serial number, or nothing is touched.
set -euo pipefail
# Everything this script creates must be readable by the new system's users and pacman's download user (alpm),
# whatever umask it was started with: a 077 here once made /etc, /var/lib and /usr/share/olymparch 0700.
umask 022

step() {  # progress line on screen; in tests also on the serial console via the kernel log
    printf '\n\033[1;33m==> %s\033[0m\n' "$*"
    if [ "${OLYMPARCH_TEST:-0}" = 1 ]; then echo "<2>olymparch-install: $*" >/dev/kmsg; fi
}
# Messages in the language picked in the wizard (LANGUAGE=nb), English otherwise
L() { if [ "${LANGUAGE:-en}" = nb ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }
die() { step "$(L ERROR FEIL): $*"; exit 1; }

# ---- Options (OPTIONS=games,emu,zeus,discord,spotify,obs,code,hibernate from the wizard) ----------------------
# Kept in one block: called once after the desktop is in place, before the boot menu and the first snapshot.
OLYMPUS_COMMIT=f3730588c6355c6e12caae962def88419c27f997   # Zeus: the public Olympus release this ISO installs
has_opt() { [[ ",${OPTIONS:-}," == *",$1,"* ]]; }
gpu_vendors() {  # vendor IDs of every display controller (PCI class 0x03xxxx): amd intel nvidia other
    local d
    for d in /sys/bus/pci/devices/*; do
        [[ $(cat "$d/class" 2>/dev/null) == 0x03* ]] || continue
        case $(cat "$d/vendor") in
            0x1002) echo amd ;; 0x8086) echo intel ;; 0x10de) echo nvidia ;; *) echo other ;;
        esac
    done | sort -u
}
install_options() {
    install_shell_tools_hook
    [ -n "${OPTIONS:-}${AGENTS:-}" ] || return 0
    local pkgs=() conf=/tmp/olymparch-pacman.conf home=/mnt/home/$USERNAME v gpus=''
    step "$(L Options Valg): ${OPTIONS//,/, }"
    if has_opt games; then
        # Steam is 32-bit: [multilib] on in the new system, and for this install
        sed -i '/^#\[multilib\]$/,/^#Include/ s/^#//' /mnt/etc/pacman.conf
        pkgs+=(steam lib32-mesa ttf-liberation gamemode lib32-gamemode mangohud lib32-mangohud gamescope umu-launcher
               ntsync-autoload lib32-pipewire)
        # The 32-bit Vulkan driver must match the GPU; named here so pacman never picks one on its own
        gpus=$(gpu_vendors)
        for v in $gpus; do
            case $v in
                amd) pkgs+=(vulkan-radeon lib32-vulkan-radeon lact) ;;
                intel) pkgs+=(vulkan-intel lib32-vulkan-intel) ;;
                nvidia) pkgs+=(lib32-nvidia-utils) ;;
            esac
        done
        [[ $gpus == *amd* || $gpus == *intel* || $gpus == *nvidia* ]] || pkgs+=(vulkan-swrast lib32-vulkan-swrast)
    fi
    has_opt emu && pkgs+=(retroarch retroarch-assets-ozone libretro-core-info libretro-snes9x libretro-mgba
                          libretro-genesis-plus-gx libretro-beetle-psx-hw libretro-mupen64plus-next libretro-flycast
                          libretro-melonds dolphin-emu ppsspp)
    has_opt discord && pkgs+=(discord)
    has_opt spotify && pkgs+=(spotify-launcher)
    has_opt obs && pkgs+=(obs-studio)
    has_opt code && pkgs+=(code)
    # zeus: llama.cpp (Vulkan works on AMD, Intel and NVIDIA) and uv; Olympus itself is installed for the user below
    has_opt zeus && pkgs+=(uv llama-cpp ggml-vulkan qrencode)   # qrencode: the QR code for pairing a phone
    extra_option_packages   # the second checklist (more apps and tools): adds to pkgs
    if [ ${#pkgs[@]} -gt 0 ]; then
        sed '/^#\[multilib\]$/,/^#Include/ s/^#//' /etc/pacman.conf >"$conf"
        local opts=(-C "$conf" -G)
        [ "${OLYMPARCH_HOST_CACHE:-0}" = 1 ] && opts+=(-c)
        pacstrap "${opts[@]}" /mnt "${pkgs[@]}"
    fi
    if has_opt games; then
        local g=/usr/share/olymparch/games
        install -Dm644 "$g/gamemode.ini" /mnt/etc/gamemode.ini
        install -Dm644 "$g/sysctl.conf" /mnt/etc/sysctl.d/75-olymparch-gaming.conf
        arch-chroot /mnt usermod -aG gamemode "$USERNAME"
        [[ $gpus == *amd* ]] && arch-chroot /mnt systemctl enable lactd >/dev/null 2>&1
        # Steam starts through our wrapper: queued Proton changes, MangoHud (hidden), the crash watcher
        mkdir -p /mnt/usr/local/share/applications
        sed -E 's|^Exec=/usr/bin/steam|Exec=/usr/bin/olymparch-launch-steam|' /mnt/usr/share/applications/steam.desktop \
            >/mnt/usr/local/share/applications/steam.desktop
        mkdir -p "$home/.config/olymparch"
        [ -f "$home/.config/olymparch/games.conf" ] || install -m644 "$g/games.conf" "$home/.config/olymparch/games.conf"
    fi
    if has_opt zeus; then
        # Olympus at a pinned commit, as the user (it lives in ~/.local), and its server as a user service that always
        # runs (the bar, the phone and the panels talk to it; nothing opens a terminal for it). No model is
        # downloaded here: the Zeus panel and Settings → Zeus ask first.
        if arch-chroot /mnt sudo -u "$USERNAME" -H uv tool install -q "git+https://github.com/Thoaniel/olympus@$OLYMPUS_COMMIT"; then
            # `olympus service install` writes the unit (its systemctl calls fail harmlessly in the chroot); enabled by hand
            arch-chroot /mnt sudo -u "$USERNAME" -H "/home/$USERNAME/.local/bin/olympus" service install >/dev/null 2>&1 || true
            if [ -f "$home/.config/systemd/user/olympus-web.service" ]; then
                arch-chroot /mnt sudo -u "$USERNAME" -H mkdir -p "/home/$USERNAME/.config/systemd/user/default.target.wants"
                arch-chroot /mnt sudo -u "$USERNAME" -H ln -sf ../olympus-web.service "/home/$USERNAME/.config/systemd/user/default.target.wants/olympus-web.service"
            fi
        else
            step "$(L "Zeus could not be installed now; install it later with: uv tool install git+https://github.com/Thoaniel/olympus" \
                      "Zeus kunne ikke installeres nå; installer senere med: uv tool install git+https://github.com/Thoaniel/olympus")"
        fi
    fi
    # AI agents ticked in the wizard (AGENTS): installed as the user at the first login (olymparch-welcome asks), from
    # each tool's official installer: they need the network and a terminal, never root, never the chroot
    local ids=() id
    for id in ${AGENTS//,/ }; do
        [[ $id =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] && [ -f "/usr/share/olymparch/agents/$id.toml" ] && ids+=("$id")
    done
    if [ ${#ids[@]} -gt 0 ]; then
        arch-chroot /mnt sudo -u "$USERNAME" -H mkdir -p "/home/$USERNAME/.config/olymparch"
        printf '%s\n' "${ids[@]}" | arch-chroot /mnt sudo -u "$USERNAME" -H tee "/home/$USERNAME/.config/olymparch/agents-pending" >/dev/null
    fi
    if has_opt hibernate && ls /sys/class/power_supply/BAT* >/dev/null 2>&1; then
        # Swap file as big as RAM on its own subvolume (no snapshots, no compression). systemd finds it on resume
        # through the HibernateLocation EFI variable, so no resume= argument is needed.
        local mem; mem=$(awk '/^MemTotal:/ {print int($2 / 1024 / 1024 + 1)}' /proc/meminfo)
        mount -o subvolid=5 /dev/mapper/root /mnt/mnt
        btrfs -q subvolume create /mnt/mnt/@swap
        umount /mnt/mnt
        mkdir -p /mnt/swap
        mount -o noatime,subvol=@swap /dev/mapper/root /mnt/swap
        btrfs filesystem mkswapfile --size "${mem}g" /mnt/swap/swapfile >/dev/null
        printf '/dev/mapper/root  /swap  btrfs  noatime,subvol=@swap  0 0\n/swap/swapfile  none  swap  defaults  0 0\n' \
            >>/mnt/etc/fstab
    fi
    extra_option_setup
    return 0
}
# ---- More apps and tools (the wizard's second checklist; the same apps as default/menu/catalog.json) --------
# lutris moonlight minecraft cloud obsidian localsend neovim helix zed shelltools tuis alacritty kitty ghostty.
# Official Arch packages go in with the rest of pacstrap; LocalSend (AUR) only from Olymparch's repo [olymparch].
extra_option_packages() {
    has_opt lutris && pkgs+=(lutris)
    has_opt moonlight && pkgs+=(moonlight-qt)
    has_opt minecraft && pkgs+=(prismlauncher)          # Minecraft: the open launcher; sign in with Microsoft there
    has_opt cloud && pkgs+=(chromium)                   # cloud gaming: Xbox Cloud Gaming and GeForce NOW web apps
    has_opt obsidian && pkgs+=(obsidian)
    has_opt neovim && pkgs+=(neovim)
    has_opt helix && pkgs+=(helix)
    has_opt zed && pkgs+=(zed)
    has_opt shelltools && pkgs+=(fzf zoxide ripgrep starship)
    has_opt tuis && pkgs+=(btop lazygit lazydocker)
    # terminals: foot stays the default (Settings → Default apps → Terminal switches)
    has_opt alacritty && pkgs+=(alacritty)
    has_opt kitty && pkgs+=(kitty)
    has_opt ghostty && pkgs+=(ghostty)
    return 0
}
extra_option_setup() {
    if has_opt neovim; then   # a small default config; ~/.config/nvim wins
        install -Dm644 /usr/share/olymparch/nvim/init.lua /mnt/etc/xdg/nvim/init.lua
    fi
    if has_opt localsend; then
        if grep -qx '\[olymparch\]' /mnt/etc/pacman.conf; then
            arch-chroot /mnt pacman -S --noconfirm --needed localsend-bin ||
                step "$(L "LocalSend could not be installed now; the menu offers it later" "LocalSend kunne ikke installeres nå; menyen tilbyr den senere")"
        else
            step "$(L "LocalSend comes from Olymparch's own repo, which could not be reached: skipped" "LocalSend kommer fra Olymparchs egen pakkebrønn, som ikke kunne nås: hoppet over")"
        fi
    fi
    if has_opt cloud; then   # the two cloud-gaming web apps, for the user (their icons are fetched now if they can be)
        local w
        for w in xbox-cloud-gaming geforce-now; do
            arch-chroot /mnt sudo -u "$USERNAME" -H /usr/share/olymparch/system/bin/olymparch-webapp add "$w" >/dev/null ||
                step "$(L "The web app $w was not added; the menu offers it later" "Webappen $w ble ikke lagt til; menyen tilbyr den senere")"
        done
    fi
    return 0
}
install_shell_tools_hook() {  # always (tiny): fzf, zoxide and starship come on in bash once they are installed
    [ -f /usr/share/olymparch/shell-tools/olymparch-shell-tools.sh ] || return 0
    install -Dm644 /usr/share/olymparch/shell-tools/olymparch-shell-tools.sh /mnt/etc/profile.d/olymparch-shell-tools.sh
    local line='[ -r /etc/profile.d/olymparch-shell-tools.sh ] && . /etc/profile.d/olymparch-shell-tools.sh   # Olymparch: shell tools'
    local f
    # (and the folder for the user's own .desktop files, so the launcher watches it from the first login: web apps)
    arch-chroot /mnt sudo -u "$USERNAME" mkdir -p "/home/$USERNAME/.local/share/applications"
    for f in /mnt/etc/skel/.bashrc "/mnt/home/$USERNAME/.bashrc"; do
        [ -f "$f" ] && ! grep -qF 'olymparch-shell-tools.sh' "$f" && printf '%s\n' "$line" >>"$f"
    done
    return 0
}
# ---- end of options ------------------------------------------------------------------------------------------

[ "${1:-}" = --answers ] && [ -f "${2:-}" ] || die "usage: olymparch-install --answers FILE [--recovery-key-file FILE]"
KEYFILE=''
[ "${3:-}" = --recovery-key-file ] && KEYFILE=${4:?}
CMDLINE_EXTRA='' KERNEL=linux KEYMAP=us LOCALE=en_US.UTF-8 TIMEZONE=UTC HOSTNAME=olymparch
# shellcheck disable=SC1090
. "$2"
for v in DISK DISK_SERIAL USERNAME PASSWORD; do [ -n "${!v:-}" ] || die "$v $(L "is missing from the answers file" "mangler i svarfila")"; done
[ -b "$DISK" ] || die "$DISK $(L "is not a disk" "er ikke en disk")"
serial=$(lsblk -dno SERIAL "$DISK" | tr -d ' ')
[ "$serial" = "$DISK_SERIAL" ] || die "$(L "the serial number of $DISK is '$serial', not '$DISK_SERIAL'. Nothing was changed." "serienummeret på $DISK er «$serial», ikke «$DISK_SERIAL». Ingenting er endret.")"
[[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "$(L "invalid user name" "ugyldig brukernavn")"
[ -d /sys/firmware/efi ] || die "$(L "the machine was not started with UEFI" "maskinen er ikke startet med UEFI")"

step "Disk: $DISK ($(lsblk -dno SIZE,MODEL "$DISK" | xargs))"
case $DISK in *nvme*|*mmcblk*) P=${DISK}p ;; *) P=$DISK ;; esac
ESP=${P}1 ROOT=${P}2
umount -R /mnt 2>/dev/null || true
cryptsetup close root 2>/dev/null || true
wipefs -aq "$DISK"
sfdisk -q "$DISK" <<EOF
label: gpt
size=2GiB, type=uefi, name=ESP
type=linux, name=olymparch
EOF
udevadm settle

step "$(L "Encryption (LUKS2)" "Kryptering (LUKS2)")"
printf '%s' "$PASSWORD" | cryptsetup luksFormat --batch-mode --type luks2 --pbkdf argon2id --label OLYMPARCH --key-file=- "$ROOT"
printf '%s' "$PASSWORD" | cryptsetup open --allow-discards --key-file=- "$ROOT" root
step "$(L "Recovery key" "Gjenopprettingsnøkkel")"
# 8 groups of 8 letters; unlocks the disk at the same prompt as the password
RECOVERY_KEY=$(PASSWORD=$PASSWORD systemd-cryptenroll --recovery-key "$ROOT" 2>/dev/null \
    | grep -oE '[a-z]{8}(-[a-z]{8}){7}' | head -n 1) || true
[ -n "$RECOVERY_KEY" ] || die "$(L "could not create the recovery key" "fikk ikke laget gjenopprettingsnøkkelen")"
if [ -n "$KEYFILE" ]; then (umask 077; printf '%s\n' "$RECOVERY_KEY" >"$KEYFILE"); fi

step "$(L "File systems (btrfs with subvolumes)" "Filsystemer (btrfs med volumer)")"
mkfs.fat -F 32 -n ESP "$ESP" >/dev/null
mkfs.btrfs -q -L olymparch /dev/mapper/root
mount /dev/mapper/root /mnt
for sv in @ @home @snapshots @var_log @pkg; do btrfs -q subvolume create "/mnt/$sv"; done
umount /mnt
opts=noatime,compress=zstd:1
mount -o "$opts,subvol=@" /dev/mapper/root /mnt
mkdir -p /mnt/{boot,home,.snapshots,var/log,var/cache/pacman/pkg}
mount -o "$opts,subvol=@home" /dev/mapper/root /mnt/home
mount -o "$opts,subvol=@snapshots" /dev/mapper/root /mnt/.snapshots
mount -o "$opts,subvol=@var_log" /dev/mapper/root /mnt/var/log
mount -o "$opts,subvol=@pkg" /dev/mapper/root /mnt/var/cache/pacman/pkg
mount "$ESP" /mnt/boot

step "$(L "The system (pacstrap)" "Systemet (pacstrap)")"
mkdir -p /mnt/etc
printf 'KEYMAP=%s\n' "$KEYMAP" >/mnt/etc/vconsole.conf   # before mkinitcpio runs, so the LUKS prompt has the layout
pacstrap_opts=(-K)
[ "${OLYMPARCH_HOST_CACHE:-0}" = 1 ] && pacstrap_opts+=(-c)   # tests: reuse the package cache mounted from the host
# ── everyday tools (olymparch-tool, olymparch-remind): screenshots + editor, screen recording (hardware encoding;
#    wf-recorder for machines without an encoder), colour picker, OCR in English and Norwegian, clipboard history,
#    typing emoji (and the font to show them)
tools_pkgs=(wl-clipboard cliphist grim slurp satty hyprpicker gpu-screen-recorder wf-recorder
    tesseract tesseract-data-eng tesseract-data-nor wtype noto-fonts-emoji)
# ── end everyday tools
# ── what people expect to just work: printers (IPP Everywhere, found on the network by avahi) and scanners,
#    the file picker in apps (the GTK portal next to Hyprland's), a plain text editor, and iPhones (photos, files)
everyday_pkgs=(cups cups-filters cups-pdf system-config-printer avahi nss-mdns sane-airscan simple-scan
    xdg-desktop-portal-gtk gnome-text-editor libimobiledevice usbmuxd gvfs-afc)
pacstrap "${pacstrap_opts[@]}" /mnt base "$KERNEL" mkinitcpio btrfs-progs cryptsetup limine sudo networkmanager snapper libnewt \
    hyprland hypridle quickshell foot adwaita-cursors ttf-jetbrains-mono ttf-nerd-fonts-symbols-mono libnotify polkit \
    pipewire pipewire-pulse wireplumber xdg-desktop-portal-hyprland plymouth upower \
    firefox thunar tumbler gvfs gvfs-mtp gvfs-gphoto2 thunar-volman imv mpv xdg-utils xdg-user-dirs udiskie udisks2 clamav pacman-contrib fakeroot tmux \
    "${tools_pkgs[@]}" "${everyday_pkgs[@]}"

# --- Hardware (olymparch-hw): the live system is the same machine, so its plan is the new system's plan.
# Drivers, microcode and only the firmware this machine needs, the initramfs MODULES for a built-in keyboard,
# and the boot check, hotplug offers and pkexec helper. Not fatal: mesa drives any screen, and what is
# missing is offered with one click after boot. Runs before mkinitcpio -P below, so the drop-in is used.
step "$(L "Hardware (olymparch-hw)" "Maskinvare (olymparch-hw)")"
# 32-bit drivers (lib32-vulkan-*) are in [multilib]: on for every install, so the plan can be applied in full
sed -i '/^#\[multilib\]$/,/^#Include/ s/^#//' /mnt/etc/pacman.conf
# Most of it may wait until after boot (offered with one click), but not what the screen needs: the GPU
# firmware and driver (olymparch-hw plan --list essential). Without them the install stops with a clear error,
# instead of finishing a machine that boots to a black screen after the disk password.
sync_db() {
    local try
    for try in 1 2 3 4 5; do
        arch-chroot /mnt pacman -Sy --noconfirm >/dev/null && return 0
        sleep $((try * 3))
    done
    return 1
}
synced=0
sync_db && synced=1
(( synced )) || step "$(L "Warning: could not reach the package mirrors" "Advarsel: fikk ikke kontakt med pakkespeilene")"
hw=/usr/share/olymparch/system/bin/olymparch-hw
if [ ! -x "$hw" ]; then
    step "$(L "Warning: olymparch-hw is missing from the ISO; drivers are offered after boot" "Advarsel: olymparch-hw mangler på ISO-en; drivere tilbys etter oppstart")"
else
    mkdir -p /mnt/var/log
    "$hw" plan --root /mnt | tee /mnt/var/log/olymparch-hw-install.txt
    essential=$("$hw" plan --root /mnt --list essential | paste -sd' ')
    hw_apply() {
        set +e
        "$hw" apply --root /mnt --when install 2>&1 | tee -a /mnt/var/log/olymparch-hw-install.txt
        local rc=${PIPESTATUS[0]}
        set -e
        return "$rc"
    }
    rc=0; hw_apply || rc=$?
    if [ "$rc" = 3 ]; then   # something the screen needs is missing: fresh databases and one more try
        step "$(L "The graphics drivers did not install; trying again" "Grafikkdriverne ble ikke installert; prøver igjen")"
        arch-chroot /mnt pacman -Syy --noconfirm >/dev/null 2>&1 || sync_db || true
        rc=0; hw_apply || rc=$?
    fi
    [ "$rc" = 0 ] || step "$(L "Warning: some drivers were not installed. They are offered after boot (see /var/log/olymparch-hw-install.txt)." "Advarsel: noen drivere ble ikke installert. De tilbys etter oppstart (se /var/log/olymparch-hw-install.txt).")"
    missing=''
    for p in $essential; do arch-chroot /mnt pacman -Q "$p" >/dev/null 2>&1 || missing+=" $p"; done
    [ -z "$missing" ] || die "$(L "the graphics card needs packages that could not be installed:$missing. The screen would stay black after the disk password. Check the network (nmtui) and run olymparch-setup again; the log is in /mnt/var/log/olymparch-hw-install.txt" \
        "skjermkortet trenger pakker som ikke kunne installeres:$missing. Skjermen ville blitt svart etter diskpassordet. Sjekk nettet (nmtui) og kjør olymparch-setup på nytt; loggen ligger i /mnt/var/log/olymparch-hw-install.txt")"
    "$hw" setup-system --root /mnt || step "$(L "Warning: the hardware check at boot was not set up" "Advarsel: maskinvaresjekken ved oppstart ble ikke satt opp")"
fi

step "$(L "Configuration" "Oppsett")"
genfstab -U /mnt | sed -E 's/,subvolid=[0-9]+//' >/mnt/etc/fstab
echo "$HOSTNAME" >/mnt/etc/hostname
ln -sf "/usr/share/zoneinfo/$TIMEZONE" /mnt/etc/localtime
sed -i "s/^#\\($LOCALE\\)/\\1/" /mnt/etc/locale.gen
echo "LANG=$LOCALE" >/mnt/etc/locale.conf
arch-chroot /mnt locale-gen >/dev/null
cat >/mnt/etc/mkinitcpio.conf.d/10-olymparch.conf <<'EOF'
HOOKS=(base systemd sd-volatile autodetect microcode modconf kms keyboard sd-vconsole plymouth olymparch block sd-encrypt filesystems fsck)
EOF
# Olymparch name and the pixel password screen (before mkinitcpio, so the theme is in the initramfs)
install -Dm644 /usr/share/olymparch/branding/os-release /mnt/usr/lib/os-release
install -Dm644 /usr/share/olymparch/branding/olymparch-os-release.hook /mnt/etc/pacman.d/hooks/olymparch-os-release.hook
install -Dm644 /usr/share/olymparch/branding/issue /mnt/etc/issue
theme=/mnt/usr/share/plymouth/themes/olymparch
mkdir -p "$theme"
cp /usr/share/olymparch/plymouth/olymparch.plymouth /usr/share/olymparch/plymouth/olymparch.script /usr/share/olymparch/plymouth/s*.png "$theme/"
# the boot screen's signals: "unlocked" from the initramfs, "handoff" just before it quits (and it keeps its last frame)
install -Dm644 /usr/share/olymparch/plymouth/olymparch-mkinitcpio-install /mnt/usr/lib/initcpio/install/olymparch
install -Dm644 -t /mnt/usr/lib/systemd/system /usr/share/olymparch/plymouth/units/olymparch-unlocked.service /usr/share/olymparch/plymouth/units/olymparch-handoff.service
install -Dm644 /usr/share/olymparch/plymouth/units/plymouth-quit-retain.conf /mnt/etc/systemd/system/plymouth-quit.service.d/olymparch.conf
install -Dm755 /usr/share/olymparch/plymouth/olymparch-plymouth-handoff /mnt/usr/lib/olymparch/plymouth-handoff
arch-chroot /mnt systemctl mask plymouth-quit-wait.service >/dev/null 2>&1
arch-chroot /mnt systemctl enable olymparch-handoff.service >/dev/null 2>&1
printf '[Daemon]\nTheme=olymparch\nShowDelay=0\nDeviceScale=1\n' >/mnt/etc/plymouth/plymouthd.conf
arch-chroot /mnt mkinitcpio -P
arch-chroot /mnt useradd -m -G wheel "$USERNAME"
printf '%s:%s\n' "$USERNAME" "$PASSWORD" | arch-chroot /mnt chpasswd
echo '%wheel ALL=(ALL:ALL) ALL' >/mnt/etc/sudoers.d/10-wheel
chmod 440 /mnt/etc/sudoers.d/10-wheel
arch-chroot /mnt systemctl enable NetworkManager >/dev/null 2>&1
# printers: CUPS starts when something prints; avahi finds network printers and scanners (mDNS)
arch-chroot /mnt systemctl enable cups.socket avahi-daemon.service >/dev/null 2>&1
sed -i 's/^hosts: mymachines resolve/hosts: mymachines mdns_minimal [NOTFOUND=return] resolve/' /mnt/etc/nsswitch.conf
# the network the installer used (Wi-Fi with its password): online at the first login without typing it again
if compgen -G '/etc/NetworkManager/system-connections/*.nmconnection' >/dev/null; then
    install -d -m700 /mnt/etc/NetworkManager/system-connections
    install -m600 /etc/NetworkManager/system-connections/*.nmconnection /mnt/etc/NetworkManager/system-connections/
fi

step "$(L "The desktop (Hyprland and the shell)" "Skrivebordet (Hyprland og skallet)")"
