#!/bin/bash
# Olymparch installer, piece 2: unattended install from an answers file. The interactive wizard comes later
# and will write the same answers file.
#
#   olymparch-install --answers FILE
#
# Answers (bash syntax): DISK, DISK_SERIAL, HOSTNAME, USERNAME, PASSWORD, KEYMAP, LOCALE, TIMEZONE, KERNEL
# Safety: DISK_SERIAL must match the disk's serial number, or nothing is touched.
set -euo pipefail

step() {  # progress line on screen; in tests also on the serial console via the kernel log
    printf '\n\033[1;33m==> %s\033[0m\n' "$*"
    if [ "${OLYMPARCH_TEST:-0}" = 1 ]; then echo "<2>olymparch-install: $*" >/dev/kmsg; fi
}
die() { step "FEIL: $*"; exit 1; }

[ "${1:-}" = --answers ] && [ -f "${2:-}" ] || die "bruk: olymparch-install --answers FIL"
CMDLINE_EXTRA='' KERNEL=linux KEYMAP=us LOCALE=en_US.UTF-8 TIMEZONE=UTC HOSTNAME=olymparch
# shellcheck disable=SC1090
. "$2"
for v in DISK DISK_SERIAL USERNAME PASSWORD; do [ -n "${!v:-}" ] || die "$v mangler i svarfila"; done
[ -b "$DISK" ] || die "$DISK er ikke en disk"
serial=$(lsblk -dno SERIAL "$DISK" | tr -d ' ')
[ "$serial" = "$DISK_SERIAL" ] || die "serienummeret på $DISK er «$serial», ikke «$DISK_SERIAL». Ingenting er endret."
[[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "ugyldig brukernavn"
[ -d /sys/firmware/efi ] || die "maskinen er ikke startet med UEFI"

step "Disk: $DISK ($(lsblk -dno SIZE,MODEL "$DISK" | xargs))"
case $DISK in *nvme*|*mmcblk*) P=${DISK}p ;; *) P=$DISK ;; esac
ESP=${P}1 ROOT=${P}2
umount -R /mnt 2>/dev/null || true
cryptsetup close root 2>/dev/null || true
wipefs -aq "$DISK"
sfdisk -q "$DISK" <<EOF
label: gpt
size=2GiB, type=uefi, name=ESP
type=linux, name=olymparch
EOF
udevadm settle

step "Kryptering (LUKS2)"
printf '%s' "$PASSWORD" | cryptsetup luksFormat --batch-mode --type luks2 --pbkdf argon2id --label OLYMPARCH --key-file=- "$ROOT"
printf '%s' "$PASSWORD" | cryptsetup open --allow-discards --key-file=- "$ROOT" root

step "Filsystemer (btrfs med volumer)"
mkfs.fat -F 32 -n ESP "$ESP" >/dev/null
mkfs.btrfs -q -L olymparch /dev/mapper/root
mount /dev/mapper/root /mnt
for sv in @ @home @snapshots @var_log @pkg; do btrfs -q subvolume create "/mnt/$sv"; done
umount /mnt
opts=noatime,compress=zstd:1
mount -o "$opts,subvol=@" /dev/mapper/root /mnt
mkdir -p /mnt/{boot,home,.snapshots,var/log,var/cache/pacman/pkg}
mount -o "$opts,subvol=@home" /dev/mapper/root /mnt/home
mount -o "$opts,subvol=@snapshots" /dev/mapper/root /mnt/.snapshots
mount -o "$opts,subvol=@var_log" /dev/mapper/root /mnt/var/log
mount -o "$opts,subvol=@pkg" /dev/mapper/root /mnt/var/cache/pacman/pkg
mount "$ESP" /mnt/boot

step "Systemet (pacstrap)"
mkdir -p /mnt/etc
printf 'KEYMAP=%s\n' "$KEYMAP" >/mnt/etc/vconsole.conf   # before mkinitcpio runs, so the LUKS prompt has the layout
pacstrap_opts=(-K)
[ "${OLYMPARCH_HOST_CACHE:-0}" = 1 ] && pacstrap_opts+=(-c)   # tests: reuse the package cache mounted from the host
pacstrap "${pacstrap_opts[@]}" /mnt base "$KERNEL" mkinitcpio btrfs-progs cryptsetup limine sudo networkmanager snapper \
    hyprland hypridle quickshell foot adwaita-cursors ttf-jetbrains-mono ttf-nerd-fonts-symbols-mono libnotify polkit \
    pipewire pipewire-pulse wireplumber xdg-desktop-portal-hyprland plymouth

step "Oppsett"
genfstab -U /mnt | sed -E 's/,subvolid=[0-9]+//' >/mnt/etc/fstab
echo "$HOSTNAME" >/mnt/etc/hostname
ln -sf "/usr/share/zoneinfo/$TIMEZONE" /mnt/etc/localtime
sed -i "s/^#\\($LOCALE\\)/\\1/" /mnt/etc/locale.gen
echo "LANG=$LOCALE" >/mnt/etc/locale.conf
arch-chroot /mnt locale-gen >/dev/null
cat >/mnt/etc/mkinitcpio.conf.d/10-olymparch.conf <<'EOF'
HOOKS=(base systemd sd-volatile autodetect microcode modconf kms keyboard sd-vconsole plymouth block sd-encrypt filesystems fsck)
EOF
# Olymparch name and the pixel password screen (before mkinitcpio, so the theme is in the initramfs)
install -Dm644 /usr/share/olymparch/branding/os-release /mnt/usr/lib/os-release
install -Dm644 /usr/share/olymparch/branding/olymparch-os-release.hook /mnt/etc/pacman.d/hooks/olymparch-os-release.hook
install -Dm644 /usr/share/olymparch/branding/issue /mnt/etc/issue
mkdir -p /mnt/usr/share/plymouth/themes
cp -r /usr/share/olymparch/plymouth /mnt/usr/share/plymouth/themes/olymparch
printf '[Daemon]\nTheme=olymparch\nShowDelay=0\nDeviceScale=1\n' >/mnt/etc/plymouth/plymouthd.conf
arch-chroot /mnt mkinitcpio -P
arch-chroot /mnt useradd -m -G wheel "$USERNAME"
printf '%s:%s\n' "$USERNAME" "$PASSWORD" | arch-chroot /mnt chpasswd
echo '%wheel ALL=(ALL:ALL) ALL' >/mnt/etc/sudoers.d/10-wheel
chmod 440 /mnt/etc/sudoers.d/10-wheel
arch-chroot /mnt systemctl enable NetworkManager >/dev/null 2>&1

step "Skrivebordet (Hyprland og skallet)"
cp -r /usr/share/olymparch /mnt/usr/share/
install -Dm755 /usr/lib/olymparch/launch-shell /mnt/usr/lib/olymparch/launch-shell
install -Dm644 /usr/share/olymparch/foot/foot.ini /mnt/etc/xdg/foot/foot.ini
install -Dm644 /usr/share/olymparch/idle/olymparch-lock.pam /mnt/etc/pam.d/olymparch-lock
# 10 tries before a 2 minute pause (Arch's default is 3 tries, then 10 minutes, for lock, sudo and tty alike)
sed -i -E 's/^#? *deny *=.*/deny = 10/; s/^#? *unlock_time *=.*/unlock_time = 120/' /mnt/etc/security/faillock.conf
xkb=$KEYMAP
case $KEYMAP in no-latin1) xkb=no ;; sv-latin1) xkb=se ;; dk-latin1) xkb=dk ;; de-latin1) xkb=de ;; fr-latin1) xkb=fr ;; uk) xkb=gb ;; esac
home=/mnt/home/$USERNAME
mkdir -p "$home/.config/hypr"
cat >"$home/.config/hypr/hyprland.lua" <<LUA
-- Olymparch: the defaults load first. Your own settings go below this line and win.
package.path = "/usr/share/olymparch/hypr/?.lua;" .. package.path
require("olymparch")

hl.config({ input = { kb_layout = "$xkb" } })
LUA
arch-chroot /mnt chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"

# Log in automatically once per boot. After a logout you get a normal login prompt.
cat >/mnt/usr/lib/olymparch/autologin-getty <<GETTY
#!/bin/sh
if [ ! -e /run/olymparch/autologin-used ]; then
    mkdir -p /run/olymparch && touch /run/olymparch/autologin-used
    exec /sbin/agetty -o '-p -f -- \\u' --noclear --autologin $USERNAME "\$1" linux
fi
exec /sbin/agetty -o '-p -- \\u' --noclear "\$1" linux
GETTY
chmod 755 /mnt/usr/lib/olymparch/autologin-getty
mkdir -p /mnt/etc/systemd/system/getty@tty1.service.d
cat >/mnt/etc/systemd/system/getty@tty1.service.d/olymparch-autologin.conf <<'UNIT'
[Service]
ExecStart=
ExecStart=-/usr/lib/olymparch/autologin-getty %I
Environment=XDG_SESSION_TYPE=wayland
UNIT
cat >/mnt/etc/profile.d/zz-olymparch-session.sh <<'SESSION'
# Olymparch: a login on tty1 starts the desktop
if [ -z "$WAYLAND_DISPLAY" ] && [ "$(tty)" = /dev/tty1 ] && [ "$(id -u)" != 0 ]; then
    if command -v start-hyprland >/dev/null 2>&1; then exec start-hyprland; else exec Hyprland; fi
fi
SESSION

step "Oppstartsmeny (Limine) og øyeblikksbilder"
uuid=$(blkid -s UUID -o value "$ROOT")
mkdir -p /mnt/boot/EFI/BOOT /mnt/etc/olymparch
cp /mnt/usr/share/limine/BOOTX64.EFI /mnt/boot/EFI/BOOT/BOOTX64.EFI
install -m755 /usr/share/olymparch/system/bin/* /mnt/usr/bin/
mkdir -p /mnt/etc/pacman.d/hooks
install -m644 /usr/share/olymparch/system/hooks/*.hook /mnt/etc/pacman.d/hooks/
cat >/mnt/etc/olymparch/boot.conf <<EOF
# Read by olymparch-boot. Written by the installer.
KERNEL=$KERNEL
ROOTARGS="rd.luks.name=$uuid=root root=/dev/mapper/root"
CMDLINE="quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0 $CMDLINE_EXTRA"
EOF
cat >/mnt/etc/olymparch/limine-header.conf <<'EOF'
timeout: 3
interface_branding: Olymparch
interface_branding_colour: d4a73a
term_palette: 08080c;e0605e;d4a73a;d4a73a;3a3644;b08ad0;6fb3c0;e8e6df
term_background: 08080c
term_foreground: e8e6df
EOF
# snapper wants to create /.snapshots itself; we keep our own @snapshots subvolume mounted there instead
umount /mnt/.snapshots
rmdir /mnt/.snapshots
arch-chroot /mnt snapper --no-dbus -c root create-config /
btrfs -q subvolume delete /mnt/.snapshots
mkdir /mnt/.snapshots
mount -o "$opts,subvol=@snapshots" /dev/mapper/root /mnt/.snapshots
chmod 750 /mnt/.snapshots
arch-chroot /mnt snapper --no-dbus -c root set-config TIMELINE_CREATE=no NUMBER_LIMIT=10 NUMBER_LIMIT_IMPORTANT=5 NUMBER_MIN_AGE=0
arch-chroot /mnt systemctl enable snapper-cleanup.timer >/dev/null 2>&1
arch-chroot /mnt snapper --no-dbus -c root create --type single --description "installert" --cleanup-algorithm number
arch-chroot /mnt olymparch-boot sync

rm -f -- "$2"   # the answers file holds the password in plain text
step "Ferdig. Ta ut installasjonsmediet og start på nytt."
umount -R /mnt
cryptsetup close root
