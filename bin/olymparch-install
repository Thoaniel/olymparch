install -Dm644 /usr/share/olymparch/idle/olymparch-lock.pam /mnt/etc/pam.d/olymparch-lock
# Settings (olymparch-settings migrates the keyboard line in hyprland.lua and adds its loader on first use)
install -Dm644 /usr/share/olymparch/settings/olymparch-settings.desktop /mnt/usr/share/applications/olymparch-settings.desktop
xkb=$KEYMAP
case $KEYMAP in no-latin1) xkb=no ;; sv-latin1) xkb=se ;; dk-latin1) xkb=dk ;; de-latin1) xkb=de ;; fr-latin1) xkb=fr ;; uk) xkb=gb ;; esac
home=/mnt/home/$USERNAME
mkdir -p "$home/.config/hypr"
cat >"$home/.config/hypr/hyprland.lua" <<LUA
-- Olymparch: the defaults load first. Your own settings go below this line and win.
