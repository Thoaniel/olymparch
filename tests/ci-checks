#!/bin/bash
# The checks that need no VM: syntax of every script, shellcheck errors, and the data-driven test suites.
# Run by .github/workflows/checks.yml, and locally before a commit.
set -uo pipefail
cd "$(dirname "$0")/.."
fail=0
check() {
    local out
    if out=$("$@" 2>&1); then printf '%s\n' "$out" | grep -v '^$' | tail -n 3; return; fi
    printf '%s\n' "$out"
    echo "FAIL: $*" >&2
    fail=1
    # on GitHub: an annotation with the end of the output, readable from the run's page and its public API
    if [ -n "${GITHUB_ACTIONS:-}" ]; then
        local msg; msg=$(printf '%s\n' "$out" | grep -E 'FAIL|Error|error|differ|^[-+] ' | tail -n 15 | sed 's/%/%25/g' | sed ':a;N;$!ba;s/\n/%0A/g')
        echo "::error title=FAIL: ${1##*/}::${msg:-exit code only}"
    fi
}
mapfile -t scripts < <(grep -rlE '^#!/bin/(ba)?sh' bin system default dev repo tests 2>/dev/null | grep -v '/out/')
for f in "${scripts[@]}"; do check bash -n "$f"; done
command -v shellcheck >/dev/null && check shellcheck -S error "${scripts[@]}"
while IFS= read -r f; do check python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])' "$f"; done < <(grep -rlE '^#!/usr/bin/(env )?python3' bin system tests 2>/dev/null; ls art/*.py art/illustrations/*.py tests/vm/*.py)
command -v luac >/dev/null && for f in default/hypr/*.lua; do check luac -p -- "$f"; done
for t in tests/settings-coverage tests/menu-check tests/hw/run tests/catalog-check tests/mcp-check tests/umask-check tests/keys-check tests/agents-check tests/i18n-check; do [ -x "$t" ] && check "$t"; done
[ -x tests/themes ] && check tests/themes   # every theme valid and readable (docs/themes.md)
[ $fail = 0 ] && echo "ci-checks: all OK"
exit $fail
