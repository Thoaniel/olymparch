#!/usr/bin/env python3
"""Settings coverage (no VM): nothing in Olymparch may be configurable without a schema entry.

  tests/settings-coverage        exit 0 and a summary, or 1 and one line per problem

Fails if
- an option in default/hypr/olymparch.lua (hl.config keys, hl.bind keys, hl.env, hl.monitor) has no schema entry
  and is not listed under "internal" with a reason. The file is run in Lua with a stand-in `hl`, so loops and
  computed keys count too;
- the shell reads a setting (Settings.get("…")) that the schema doesn't have, or a ready shell setting is never read;
- olymparch-settings uses a key or an apply.via the schema doesn't have, or the schema uses a via it can't apply;
- a schema entry lacks en/nb labels or descriptions, has a bad page, level, type, default or option;
- a page from the spec is missing, or the shell uses an I18n key with no Norwegian text.
"""
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
problems = []
bad = problems.append

schema = json.loads((root / "default/settings/schema.json").read_text())
settings = schema["settings"]
keys = {s["key"]: s for s in settings}
internal = schema.get("internal", {})

# ── the schema itself
SPEC_PAGES = ["display", "audio", "input", "network", "bluetooth", "power", "disks", "hardware", "games", "zeus",
              "events", "apps", "account", "keyboard", "appearance", "notifications", "accessibility", "privacy",
              "updates", "backup", "about"]
groups = {g["id"] for g in schema["groups"]}
pages = {p["id"]: p for p in schema["pages"]}
for p in SPEC_PAGES:
    if p not in pages:
        bad(f"page missing: {p}")
for p in schema["pages"]:
    if p["group"] not in groups:
        bad(f"page {p['id']}: unknown group {p['group']}")
    if not (p["label"].get("en") and p["label"].get("nb")):
        bad(f"page {p['id']}: needs en and nb labels")
for g in schema["groups"]:
    if not (g["label"].get("en") and g["label"].get("nb")):
        bad(f"group {g['id']}: needs en and nb labels")
    if not any(p["group"] == g["id"] for p in schema["pages"]):
        bad(f"group {g['id']}: no pages")

VIAS = {"shell", "hypr", "monitor", "idle", "audio", "cursor", "stored", "action", "info", "bluetooth", "power", "mime", "terminal", "unit", "dropin", "headset", "mangohud", "envd", "brightness", "system", "pwclock",
        "olympus"}   # olympus = Zeus, through Olympus' own CLI (olympus modell / config set)
seen = set()
for s in settings:
    k = s.get("key", "?")
    if k in seen:
        bad(f"{k}: listed twice")
    seen.add(k)
    for field in ("label", "description"):
        d = s.get(field) or {}
        if not (d.get("en") and d.get("nb")):
            bad(f"{k}: needs {field} in en and nb")
    if s.get("page") not in pages:
        bad(f"{k}: unknown page {s.get('page')}")
    if s.get("level") not in ("simple", "advanced"):
        bad(f"{k}: level must be simple or advanced")
    t = s.get("type")
    if t not in ("bool", "choice", "number", "text", "action"):
        bad(f"{k}: unknown type {t}")
    if not isinstance(s.get("ready"), bool):
        bad(f"{k}: ready must be true or false")
    a = s.get("apply") or {}
    if a.get("via") not in VIAS:
        bad(f"{k}: apply.via must be one of {sorted(VIAS)}")
    if not (a.get("command") or a.get("file")):
        bad(f"{k}: apply needs a command, or a file and key")
    if t == "action":
        if a.get("via") not in ("action",):
            bad(f"{k}: actions apply via action")
        continue
    if "default" not in s:
        bad(f"{k}: no default")
        continue
    dv = s["default"]
    if t == "bool" and not isinstance(dv, bool):
        bad(f"{k}: default must be true or false")
    if t == "number":
        if not isinstance(dv, (int, float)) or isinstance(dv, bool):
            bad(f"{k}: default must be a number")
        elif not (s.get("min", dv) <= dv <= s.get("max", dv)):
            bad(f"{k}: default {dv} is outside min/max")
    if t == "choice":
        opts = s.get("options") or []
        for o in opts:
            if not (o.get("label", {}).get("en") and o.get("label", {}).get("nb")):
                bad(f"{k}: option {o.get('value')} needs en and nb labels")
        if not s.get("options_from") and dv not in [o["value"] for o in opts]:
            bad(f"{k}: default {dv!r} is not one of its options")
        if not opts and not s.get("options_from"):
            bad(f"{k}: a choice needs options or options_from")

# ── Hyprland: run olymparch.lua with a stand-in hl and collect everything it sets
LUA = r'''
local out = {}
local function any() return setmetatable({}, { __index = function() return any() end, __call = function() return any() end }) end
local function flat(prefix, t)
    for k, v in pairs(t) do
        local p = prefix == "" and tostring(k) or prefix .. "." .. tostring(k)
        if type(v) == "table" and type(k) == "string" and next(v) ~= nil and type(next(v)) == "string" and k ~= "col" then flat(p, v)
        elseif type(v) == "table" and k == "col" then for c in pairs(v) do out[#out + 1] = "config " .. p .. "." .. c end
        else out[#out + 1] = "config " .. p end
    end
end
hl = setmetatable({
    config = function(t) flat("", t) end,
    bind = function(k) out[#out + 1] = "bind " .. k; return any() end,
    env = function(k) out[#out + 1] = "env " .. k end,
    monitor = function(m) out[#out + 1] = "monitor " .. (m.output or "") end,
}, { __index = function() return any() end })
dofile(arg[1])
for _, l in ipairs(out) do print(l) end
'''
lua = shutil.which("lua") or shutil.which("lua5.4")
if not lua:
    bad("lua not found (Hyprland needs it; install lua)")
else:
    r = subprocess.run([lua, "-", str(root / "default/hypr/olymparch.lua")], input=LUA, capture_output=True, text=True)
    if r.returncode:
        bad(f"olymparch.lua did not run: {r.stderr.strip()}")
    hypr_keys = {s["apply"]["key"]: s["key"] for s in settings if s["apply"].get("via") == "hypr"}
    binds = [(re.compile(b), s["key"]) for s in settings for b in s.get("binds", [])]
    covered_env = set(internal.get("env", {}))
    n = {"config": 0, "bind": 0, "env": 0, "monitor": 0}
    for line in r.stdout.splitlines():
        kind, _, name = line.partition(" ")
        n[kind] += 1
        if kind == "config" and name not in hypr_keys and name not in internal.get("hypr", {}):
            bad(f"olymparch.lua: {name} has no schema entry (apply.via hypr, apply.key {name}) and is not internal")
        if kind == "bind" and not any(rx.search(name) for rx, _ in binds):
            bad(f"olymparch.lua: shortcut {name!r} has no schema entry (keys.*, binds)")
        if kind == "env" and name not in covered_env:
            bad(f"olymparch.lua: hl.env {name} has no schema entry and is not internal")
        if kind == "monitor" and name not in internal.get("monitor", {}):
            bad(f"olymparch.lua: monitor rule {name!r} is not covered")
    for k in internal.get("hypr", {}):
        if k in hypr_keys:
            bad(f"internal.hypr {k} is also a setting ({hypr_keys[k]}); pick one")
    # the Hyprland option names must exist (when the stubs are installed)
    stubs = Path("/usr/share/hypr/stubs/hl.meta.lua")
    if stubs.exists():
        known = set(re.findall(r'"([a-z_]+(?:\.[a-z_]+)+)"', stubs.read_text()))
        for hk, sk in hypr_keys.items():
            if hk != "bind" and hk not in known:
                bad(f"{sk}: {hk} is not a Hyprland option")

# ── the shell
shell_reads = set()
for f in list((root / "default/shell").glob("*.qml")) + list((root / "default/lock").glob("*.qml")):
    text = f.read_text()
    # the lock screen is a process of its own: it reads settings.json with setting("…")
    for k in re.findall(r'(?:Settings\.(?:get|set|reset)|\bsetting)\("([^"@]+)', text):
        shell_reads.add(k)
        if k not in keys:
            bad(f"{f.name}: reads setting {k}, which the schema doesn't have")
# Text size (accessibility.text_size) and high contrast only work if every font and colour goes through the theme
for f in (root / "default/shell").glob("*.qml"):
    if f.name != "shell.qml" and re.search(r'"#(?:9a96a3|3a3644|e8e6df)"', f.read_text(), re.I):
        bad(f"{f.name}: a fixed text/muted/line colour; use theme.text, theme.muted or theme.line so high contrast reaches it")
for f in (root / "default/shell").glob("*.qml"):
    for m in re.finditer(r'pixelSize: *\d', f.read_text()):
        bad(f"{f.name}: a fixed font size ({m.group(0)}…); use theme.px(N) so Settings → Text size scales it")
for s in settings:
    if s["apply"].get("via") == "shell" and s["ready"] and s["key"] not in shell_reads:
        bad(f"{s['key']}: ready, applied by the shell, but no QML reads it")

# ── olymparch-settings
cli = (root / "system/bin/olymparch-settings").read_text()
appliers = set(re.findall(r'appliers\["([a-z]+)"\]', cli))
for v in sorted({s["apply"]["via"] for s in settings} - appliers):
    bad(f"olymparch-settings has no applier for apply.via {v}")
for v in sorted(appliers - VIAS):
    bad(f"olymparch-settings applies via {v}, which the schema doesn't know")
for k in set(re.findall(r'(?:byKey|values)\["([a-z_]+\.[a-z_.]+)"\]|value_of\(values, "([a-z_.]+)"\)', cli)):
    k = k[0] or k[1]
    if k not in keys:
        bad(f"olymparch-settings uses {k}, which the schema doesn't have")

# ── olymparch-settings never lets a bad value from settings.json into Lua, conf files or commands
import os
import tempfile
with tempfile.TemporaryDirectory() as home:
    conf = Path(home, ".config")
    (conf / "olymparch").mkdir(parents=True)
    (conf / "hypr").mkdir()
    evil = 'x") os.execute("touch PWNED") --'
    (conf / "olymparch/settings.json").write_text(json.dumps({
        "accessibility.cursor_size": '24") os.execute("touch PWNED") --',
        "appearance.gaps_in": "1 }) os.execute('touch PWNED') --",
        "keyboard.layout": evil, "keyboard.variant": evil, "keyboard.options": "a\nos.execute('x')",
        "display.position@Virtual-1": evil, "display.scale@Virtual-1": "1 }) os.execute('x') --",
        "display.resolution@Bad\"Out": "1920x1080", "account.lock_minutes": "5\nlistener {", "power.suspend": 99999,
        "appearance.rounding": 4, "keyboard.model": "pc105",
    }))
    env = {k: v for k, v in os.environ.items() if k not in ("HYPRLAND_INSTANCE_SIGNATURE", "WAYLAND_DISPLAY", "XDG_CONFIG_HOME")}
    env.update(HOME=home, XDG_RUNTIME_DIR=home, OLYMPARCH_SETTINGS_SCHEMA=str(root / "default/settings/schema.json"))
    cli_path = str(root / "system/bin/olymparch-settings")
    r = subprocess.run([cli_path, "apply"], env=env, capture_output=True, text=True)
    written = "".join(p.read_text() for p in conf.rglob("*") if p.is_file() and p.name != "settings.json")
    if r.returncode or "os.execute" in written or "PWNED" in written or "listener {\n" in written.split("listener")[0]:
        bad(f"olymparch-settings let a malicious settings.json value through (rc {r.returncode}):\n{written}{r.stderr}")
    if r.stderr.count("ignoring") != 10:
        bad(f"olymparch-settings should ignore 10 bad values, said:\n{r.stderr}")
    if "rounding = 4" not in written or 'kb_model = "pc105"' not in written:
        bad("olymparch-settings dropped good values next to bad ones")
    for p in conf.rglob("*.lua"):
        if lua and subprocess.run([lua, "-e", f"assert(loadfile({str(p)!r}))"], capture_output=True).returncode:
            bad(f"{p.name} written by olymparch-settings is not valid Lua")
    for args in (["set", "keyboard.variant", evil], ["set", "display.position@Virtual-1", evil],
                 ["set", "display.scale@x;rm", "1"], ["set", "accessibility.cursor_size", "24 && rm -rf ~"],
                 ["set", "updates.snapshots", "51"], ["set", "updates.snapshots", "10; reboot"], ["set", "power.suspend", "-5"]):
        if subprocess.run([cli_path, *args], env=env, capture_output=True).returncode != 2:
            bad(f"olymparch-settings {' '.join(args)!r} was not refused")
    if list(Path(home).rglob("PWNED")) or list(Path(home).rglob(".*.??????")):
        bad("olymparch-settings left PWNED or temp files behind")

# ── system state: olymparch-settings never escalates (no pkexec/sudo), and only switches units from its allow-list
allowed_units = set(re.findall(r'\["(olymp(?:arch|us)-[\w.-]+\.(?:path|timer|service))"\] = true', cli))
for s in settings:
    a = s["apply"]
    for u in a.get("units", []) + ([a["unit"]] if a.get("unit") else []):
        if u not in allowed_units:
            bad(f"{s['key']}: unit {u} is not in olymparch-settings' USER_UNITS allow-list")
code = re.sub(r'--[^\n]*', '', cli)
if re.search(r'\b(sudo|pacman)\b', code) or code.count("pkexec") != code.count('"pkexec " .. HELPER .. " "') or code.count("pkexec") > 1:
    bad("olymparch-settings may only run pkexec on its own helper (HELPER), never sudo or pacman")
if 'local HELPER = "/usr/lib/olymparch/settings-apply"' not in cli:
    bad("olymparch-settings: HELPER must be /usr/lib/olymparch/settings-apply")
# the helper and the CLI allow exactly the same actions and values, and the schema stays inside them
helper = (root / "system/lib/settings-apply").read_text()
helper_globs = [g.strip() for g in helper.split('case "$action:$value" in')[1].split(';;')[0].replace("\\", " ").replace(")", " ").split("|")]
if not helper_globs or any(re.search(r'[*?]|[^a-z0-9:\[\]-]', g) for g in helper_globs):
    bad(f"settings-apply: allowed values must be fixed words or digit classes, not {helper_globs}")
from fnmatch import fnmatchcase
def helper_ok(av):
    return any(fnmatchcase(av, g) for g in helper_globs)
cli_sys = cli.split("local SYSTEM_ACTIONS")[1].split("appliers")[0]
cli_allowed = set()
for m in re.finditer(r'(?:\["([a-z-]+)"\]|\b([a-z]+)) = \{ ((?:[a-z0-9]+ = true,? ?)+)\}', cli_sys):
    act = m.group(1) or m.group(2)
    for v in re.findall(r"([a-z0-9]+) = true", m.group(3)):
        cli_allowed.add(f"{act}:{v}")
ranges = {(m.group(1) or m.group(2)): (int(m.group(3)), int(m.group(4)))
          for m in re.finditer(r'(?:\["([a-z-]+)"\]|\b([a-z]+)) = \{ (\d+), (\d+) \}', cli_sys)}
for act, (lo, hi) in ranges.items():
    cli_allowed |= {f"{act}:{n}" for n in range(lo, hi + 1)}
probe = set(cli_allowed) | {g for g in helper_globs if "[" not in g} | {f"{a.split(':')[0]}:{x}" for a in cli_allowed for x in ("", "x", "0", "1", "01", "05", "51", "99", "100", "-1", "2a", "on", "off")}
helper_allowed = {av for av in probe if helper_ok(av)}
if not cli_allowed or helper_allowed != cli_allowed:
    bad(f"settings-apply and olymparch-settings must allow the same values; differ on {sorted(helper_allowed ^ cli_allowed)}")
for s in settings:
    a = s["apply"]
    if a.get("via") == "system":
        if s["type"] == "number":
            lo, hi = ranges.get(a.get("action"), (None, None))
            if (lo, hi) != (s.get("min"), s.get("max")):
                bad(f"{s['key']}: min/max {s.get('min')}–{s.get('max')} must match SYSTEM_RANGES {lo}–{hi}")
            continue
        vals = ["on", "off"] if s["type"] == "bool" else [o["value"] for o in s.get("options", [])]
        for v in vals:
            if f"{a.get('action')}:{v}" not in helper_allowed:
                bad(f"{s['key']}: {a.get('action')} {v} is not allowed by settings-apply")
if "PATH=/usr/bin" not in helper or '"$(id -u)" = 0' not in helper:
    bad("settings-apply must reset PATH and refuse to run without root")
pol = (root / "system/polkit/50-olymparch-settings.rules").read_text()
if 'action.id == "org.olymparch.settings-apply"' not in pol or "subject.local && subject.active" not in pol:
    bad("50-olymparch-settings.rules must be scoped to org.olymparch.settings-apply and the active local session")
if "<annotate key=\"org.freedesktop.policykit.exec.path\">/usr/lib/olymparch/settings-apply</annotate>" not in (root / "system/polkit/org.olymparch.settings.policy").read_text():
    bad("org.olymparch.settings.policy must name exactly /usr/lib/olymparch/settings-apply")

# ── Wi-Fi: a saved WPA network is never joined through an open twin with the same name; a saved one is joined by
#    UUID; no password ever reaches a command line. A stand-in nmcli logs every call.
with tempfile.TemporaryDirectory() as home:
    fake = Path(home, "bin")
    fake.mkdir()
    log = Path(home, "nmcli.log")
    (fake / "nmcli").write_text(f'''#!/bin/sh
echo "$*" >> {str(log)!r}
case "$*" in
  *"device wifi list"*) printf '%s\\n' "$NM_SCAN" ;;
  *"-f UUID,TYPE connection show"*) printf '11111111-2222-3333-4444-555555555555:802-11-wireless\\n' ;;
  *"connection show uuid"*) printf 'Home\\nwpa-psk\\n' ;;
  *"-f TYPE device"*) printf 'wifi\\nethernet\\n' ;;
esac
exit 0
''')
    (fake / "nmcli").chmod(0o755)
    env2 = dict(env, HOME=home, XDG_RUNTIME_DIR=home, PATH=f"{fake}:{os.environ['PATH']}")
    def pick(scan):
        log.write_text("")
        r = subprocess.run([cli_path, "pick", "network.wifi", "Home"], env=dict(env2, NM_SCAN=scan), capture_output=True, text=True)
        return r.returncode, log.read_text()
    rc, calls = pick(":70::Home")   # only an open «Home» nearby
    if rc != 3 or "connection up" in calls or "wifi connect" in calls:
        bad(f"Wi-Fi: joined (or tried) an open twin of the saved WPA network «Home» (rc {rc}):\n{calls}")
    rc, calls = pick(":70:WPA2:Home")
    if rc != 0 or "connection up uuid 11111111-2222-3333-4444-555555555555" not in calls:
        bad(f"Wi-Fi: the saved WPA network «Home» was not joined by its UUID (rc {rc}):\n{calls}")
    r = subprocess.run([cli_path, "items", "network.wifi"], env=dict(env2, NM_SCAN=":70::Home"), capture_output=True, text=True)
    if "\tsaved\t" in r.stdout or "⚠" not in r.stdout:
        bad(f"Wi-Fi: the list shows an open twin of a saved WPA network as saved:\n{r.stdout}")
    if re.search(r'password|psk|wifi-sec', log.read_text()):
        bad("Wi-Fi: a password went through nmcli's command line")

# ── Zeus and Backup: models only from what Olympus lists, through its own CLI with fixed subcommands; free text
#    (parameters, the repository, the folders) only in its own grammar. A stand-in olympus logs every call.
with tempfile.TemporaryDirectory() as home:
    zbin = Path(home, ".local/bin")
    zbin.mkdir(parents=True)
    zlog = Path(home, "olympus.log")
    (zbin / "olympus").write_text(f'''#!/bin/sh
echo "$*" >> {str(zlog)!r}
case "$1" in
  modell) [ -z "$2" ] && printf '\\342\\227\\217 \\342\\230\\201 groq/openai/gpt-oss-120b           gratisniv\\303\\245\\n\\342\\227\\213   gemma4-26b-a4b                     Gemma 4\\n\\nBytt med `olympus modell <id>`\\n' ;;
  config) [ "$2" = get ] && echo gemma4-26b-a4b ;;
esac
exit 0
''')
    (zbin / "olympus").chmod(0o755)
    zenv = {k: v for k, v in os.environ.items() if k not in ("HYPRLAND_INSTANCE_SIGNATURE", "WAYLAND_DISPLAY", "XDG_CONFIG_HOME")}
    zenv.update(HOME=home, XDG_RUNTIME_DIR=home, OLYMPARCH_SETTINGS_SCHEMA=str(root / "default/settings/schema.json"))
    def zrun(*args):
        return subprocess.run([cli_path, *args], env=zenv, capture_output=True, text=True)
    r = zrun("choices", "zeus.model")
    if r.stdout.split("\n")[:2] != ["groq/openai/gpt-oss-120b\t☁ groq/openai/gpt-oss-120b", "gemma4-26b-a4b\tgemma4-26b-a4b"]:
        bad(f"Zeus: choices zeus.model should list what `olympus modell` lists, said:\n{r.stdout}{r.stderr}")
    if zrun("get", "zeus.model").stdout.strip() != "groq/openai/gpt-oss-120b":
        bad("Zeus: the model in use (● in `olympus modell`) was not taken into settings.json")
    if zrun("choices", "zeus.local_model").stdout.strip() != "gemma4-26b-a4b\tgemma4-26b-a4b":
        bad("Zeus: choices zeus.local_model must list local models only")
    zlog.write_text("")
    good = [(("zeus.model", "gemma4-26b-a4b"), "modell gemma4-26b-a4b"),
            (("zeus.local_model", "gemma4-26b-a4b"), 'config set general.local_model "gemma4-26b-a4b"'),
            (("zeus.params", "temperature=0.3, context=8192"), "config set llamacpp.ctx_size 8192"),
            (("zeus.vram_limit", "12"), "config set vram.budget_gb 12.0")]
    for args, want in good:
        r = zrun("set", *args)
        if r.returncode or want not in zlog.read_text():
            bad(f"Zeus: set {' '.join(args)} should run `olympus {want}` (rc {r.returncode}):\n{zlog.read_text()}{r.stderr}")
    if "config set agents.zeus.temperature 0.30" not in zlog.read_text():
        bad("Zeus: zeus.params did not set agents.zeus.temperature")
    zlog.write_text("")
    for args in (("zeus.model", "llama-not-downloaded"), ("zeus.model", "x; touch PWNED"), ("zeus.model", "-rf"),
                 ("zeus.local_model", "groq/openai/gpt-oss-120b"), ("zeus.params", "temperature=5"),
                 ("zeus.params", "temperature=0.3; rm -rf ~"), ("zeus.params", "context=1e9"), ("zeus.vram_limit", "65"),
                 ("backup.repo", "ext::sh -c touch% PWNED"), ("backup.repo", "git@github.com:-oProxyCommand=x/r.git"),
                 ("backup.repo", "https://github.com/me/..git"), ("backup.repo", "https://evil.example/me/r.git"),
                 ("backup.include", "~/../etc"), ("backup.include", "/etc"), ("backup.include", "~/a,~/b/../../x"),
                 ("backup.include", "~/$(touch PWNED)"), ("backup.days", "0")):
        r = zrun("set", *args)
        if r.returncode != 2:
            bad(f"olymparch-settings set {' '.join(args)!r} was not refused (rc {r.returncode})")
    if [l for l in zlog.read_text().splitlines() if l != "modell"] or list(Path(home).rglob("PWNED")):
        bad(f"Zeus: a refused value reached olympus:\n{zlog.read_text()}")
    for args in (("backup.repo", "git@github.com:me/olymparch-backup.git"), ("backup.repo", "https://github.com/me/backup.git"),
                 ("backup.include", "~/Documents, ~/My Pictures/Screens"), ("backup.include", ""), ("backup.days", "14")):
        r = zrun("set", *args)
        if r.returncode:
            bad(f"olymparch-settings set {' '.join(args)!r} was refused: {r.stderr}")
    # no Olympus: the Zeus rows are hidden, except Install (and the on/off switch for the login offer)
    (zbin / "olympus").unlink()
    hidden = set(zrun("missing").stdout.split())
    for s in settings:
        if s["page"] == "zeus" and s["key"] not in ("zeus.install", "zeus.enabled") and s["key"] not in hidden:
            bad(f"{s['key']}: shown without Olympus (needs_file ~/.local/bin/olympus)")
    if "zeus.install" in hidden:
        bad("zeus.install must show when Olympus is missing")
# olymparch-gitbackup checks backup.repo and backup.include with the same rules (and the timer only runs it when due)
gb = root / "system/bin/olymparch-gitbackup"
r = subprocess.run(["bash", str(gb), "selftest"], capture_output=True, text=True)
if r.returncode or "selftest ok" not in r.stdout:
