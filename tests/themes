#!/usr/bin/env python3
"""Themes (no VM): every built-in theme is valid and readable, and olymparch-theme never takes a bad one.

  tests/themes        exit 0 and a table of contrast ratios, or 1 and one line per problem

Fails if
- a theme in default/themes is refused by `olymparch-theme validate`, its folder is not its id, or it lacks en/nb text;
- text, muted text, the accents or danger fall below 4.5:1 (WCAG AA) on the background, surface or raised colour,
  or the background on the accent (text on an accent button) does;
- there are fewer than 10 themes, Zeus is missing, or there is no light theme;
- olymparch-theme takes a theme with a bad colour, an unknown field, a symlink, a wrong id or unreadable text, an
  install URL that is not https://github.com/OWNER/REPO, or removes a built-in theme;
- olymparch-settings takes an appearance.theme that is no theme;
- a theme does not have the temple and its god's illustration (art/illustrations/<id>.svg, self-contained: no
  pictures, text, fonts, scripts or links out), or olymparch-theme lists a picture that is no picture (wrong first
  bytes, over 20 MiB, a symlink), forgets a theme's background across a switch or takes a bad background id.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET   # our own SVGs only (DOCTYPE and ENTITY are refused first)
from pathlib import Path

root = Path(__file__).resolve().parent.parent
cli = str(root / "system/bin/olymparch-theme")
settings_cli = str(root / "system/bin/olymparch-settings")
problems = []
bad = problems.append


def lum(h):
    def ch(v):
        v /= 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = (int(h[i:i + 2], 16) for i in (1, 3, 5))
    return 0.2126 * ch(r) + 0.7152 * ch(g) + 0.0722 * ch(b)


def contrast(a, b):
    x, y = sorted((lum(a), lum(b)), reverse=True)
    return (x + 0.05) / (y + 0.05)


PAIRS = [("text", "bg"), ("text", "surface"), ("text", "raised"), ("muted", "bg"), ("muted", "surface"),
         ("accent", "bg"), ("accent", "surface"), ("accentHi", "bg"), ("accentHi", "raised"), ("danger", "bg"),
         ("danger", "surface"), ("bg", "accent")]
env = {k: v for k, v in os.environ.items() if k not in ("HYPRLAND_INSTANCE_SIGNATURE", "WAYLAND_DISPLAY", "XDG_CONFIG_HOME")}

themes = sorted(p for p in (root / "default/themes").iterdir() if p.is_dir())
ids = [p.name for p in themes]
if len(themes) < 10:
    bad(f"only {len(themes)} themes; at least 10")
if "zeus" not in ids:
    bad("the default theme zeus is missing")
rows, light = [], 0
for d in themes:
    r = subprocess.run([cli, "validate", str(d)], capture_output=True, text=True, env=env)
    if r.returncode or r.stdout.strip() != f"ok {d.name}":
        bad(f"{d.name}: olymparch-theme validate refused it: {r.stderr.strip()}")
        continue
    t = json.loads((d / "theme.json").read_text())
    light += t.get("light") is True
    for f in ("name", "description"):
        if not (t[f].get("en") and t[f].get("nb")):
            bad(f"{d.name}: {f} needs en and nb")
    p = t["palette"]
    ratios = {f"{a}/{b}": contrast(p[a], p[b]) for a, b in PAIRS}
    for k, v in ratios.items():
        if v < 4.5:
            bad(f"{d.name}: {k} contrast {v:.2f}:1 is below 4.5:1")
    rows.append((d.name, ratios))
if not light:
    bad("no light theme")
SVG = "{http://www.w3.org/2000/svg}"
ART = root / "art/illustrations"
for d in themes:   # the temple and the god's illustration: theme.json names one background, art/illustrations/<id>.svg draws it
    t = json.loads((d / "theme.json").read_text())
    named = [b["id"] for b in t.get("backgrounds", [])]
    svg = ART / f"{d.name}.svg"
    if len(named) != 1:
        bad(f"{d.name}: {len(named) + 1} backgrounds; 2 expected (the temple and the god's illustration)")
    if named and not svg.exists():
        bad(f"{d.name}: theme.json names the background {named[0]}, but {svg.relative_to(root)} is missing")
    if svg.exists() and not named:
        bad(f"{d.name}: {svg.relative_to(root)} exists, but theme.json names no background for it")
for svg in sorted(ART.glob("*.svg")):   # drawn here, self-contained: no pictures, fonts, text, scripts or links out
    if not (root / "default/themes" / svg.stem / "theme.json").exists():
        bad(f"{svg.relative_to(root)}: no theme called {svg.stem}")
    if re.search(r"<!(DOCTYPE|ENTITY)", svg.read_text()):
        bad(f"{svg.relative_to(root)}: no DOCTYPE or ENTITY")
        continue
    try:
        top = ET.parse(svg).getroot()
    except ET.ParseError as e:
        bad(f"{svg.relative_to(root)}: not valid XML ({e})")
        continue
    if top.tag != SVG + "svg" or top.get("viewBox") != "0 0 2560 1440":
        bad(f"{svg.relative_to(root)}: must be <svg viewBox=\"0 0 2560 1440\">")
    for el in top.iter():
        tag = el.tag.split("}")[-1]
        if tag in ("image", "text", "tspan", "textPath", "font", "font-face", "script", "foreignObject", "style", "a"):
            bad(f"{svg.relative_to(root)}: <{tag}> is not allowed (everything is drawn in the SVG itself)")
        for k, v in el.attrib.items():
            if k.split("}")[-1] == "href" and not v.startswith("#"):
                bad(f"{svg.relative_to(root)}: a link out ({v[:40]})")
            if "url(" in v and not all(u.startswith("#") for u in re.findall(r"url\(\s*([^)]*)\)", v)):
                bad(f"{svg.relative_to(root)}: url() that is not #local ({v[:40]})")
    if svg.stat().st_size > 400_000:
        bad(f"{svg.relative_to(root)}: {svg.stat().st_size // 1000} kB; keep an illustration under 400 kB")

# ── olymparch-theme refuses bad themes, URLs and removals
GOOD = json.loads((root / "default/themes/zeus/theme.json").read_text())
with tempfile.TemporaryDirectory() as home:
    e = dict(env, HOME=home, XDG_RUNTIME_DIR=home, OLYMPARCH_SETTINGS_SCHEMA=str(root / "default/settings/schema.json"))
    user = Path(home, ".config/olymparch/themes")

    def theme(id_, data=None, raw=None):
        d = user / id_
        d.mkdir(parents=True, exist_ok=True)
        (d / "theme.json").write_text(raw if raw is not None else json.dumps(data))
        return d

    def variant(**kw):
        t = json.loads(json.dumps(GOOD))
        t["id"] = "evil"
        for k, v in kw.items():
            if k.startswith("palette_"):
                t["palette"][k[8:]] = v
            elif v is None:
                t.pop(k, None)
            else:
                t[k] = v
        return t
    evil = {
        "colour": variant(palette_bg='#000000"); os.execute("touch PWNED'),
        "short colour": variant(palette_accent="#fff"),
        "named colour": variant(palette_text="white"),
        "unknown field": variant(exec="touch PWNED"),
        "unknown palette": variant(palette_shader="#000000"),
        "terminal 15": variant(terminal=GOOD["terminal"][:15]),
        "terminal bad": variant(terminal=GOOD["terminal"][:15] + ["rgb(1,2,3)"]),
        "wrong id": dict(variant(), id="other"),
        "id pattern": dict(variant(), id="Evil/../x"),
        "control char": variant(name={"en": "Evil\nline"}),
        "no en": variant(name={"nb": "Ond"}),
        "unreadable": variant(palette_text="#111111", palette_bg="#000000"),
        "glyph": variant(glyph="41"),
        "number": variant(light=1),
    }
    for label, data in evil.items():
        d = theme("evil", data)
        r = subprocess.run([cli, "validate", str(d)], capture_output=True, text=True, env=e)
        if r.returncode == 0 and label != "wrong id":   # (validate checks a cloned repo, whose folder is no id)
            bad(f"olymparch-theme validate took an evil theme ({label})")
        r = subprocess.run([settings_cli, "set", "appearance.theme", "evil"], capture_output=True, text=True, env=e)
        out = Path(home, ".config/olymparch/theme/theme.json")
        if out.exists() and '"evil"' in out.read_text():
            bad(f"olymparch-theme applied an evil theme ({label})")
    # a symlinked theme.json or theme folder is never read
    secret = Path(home, "secret.json")
    secret.write_text(json.dumps(variant()))
    d = user / "evil"
    (d / "theme.json").unlink()
    (d / "theme.json").symlink_to(secret)
    r = subprocess.run([cli, "list"], capture_output=True, text=True, env=e)
    if " evil " in r.stdout or subprocess.run([cli, "validate", str(d)], capture_output=True, env=e).returncode == 0:
        bad("olymparch-theme followed a symlinked theme.json")
    (d / "theme.json").unlink()
    d.rmdir()
    real = Path(home, "elsewhere/evil")
    real.mkdir(parents=True)
    (real / "theme.json").write_text(json.dumps(variant()))
    (user / "evil").symlink_to(real)
    r = subprocess.run([cli, "list"], capture_output=True, text=True, env=e)
    if " evil " in r.stdout:
        bad("olymparch-theme followed a symlinked theme folder")
    (user / "evil").unlink()
    # a good user theme is listed, can be used, overrides nothing it shouldn't, and can be removed
    theme("mine", dict(variant(), id="mine"))
    r = subprocess.run([cli, "set", "mine"], capture_output=True, text=True, env=e)
    out = Path(home, ".config/olymparch/theme")
    if r.returncode or '"id": "mine"' not in (out / "theme.json").read_text() or "background=0a0a0e" not in (out / "foot.ini").read_text() \
            or 'active_border = "rgb(d4a73a)"' not in (out / "hypr.lua").read_text():
        bad(f"olymparch-theme set mine did not write the theme files: {r.stderr}")
    for p in out.iterdir():
        if p.suffix == ".lua" and subprocess.run(["luac", "-p", str(p)], capture_output=True).returncode:
            bad(f"{p.name} written by olymparch-theme is not valid Lua")
    r = subprocess.run([cli, "remove", "mine"], capture_output=True, text=True, env=e)
    if r.returncode or (user / "mine").exists() or subprocess.run([cli, "current"], capture_output=True, text=True, env=e).stdout.strip() != "zeus":
        bad(f"olymparch-theme remove mine did not remove it and go back to zeus: {r.stderr}")
    if subprocess.run([cli, "remove", "zeus"], capture_output=True, env=e).returncode != 2:
        bad("olymparch-theme removed a built-in theme")
    for url in ("http://github.com/a/b", "https://github.com/a/b;touch PWNED", "git@github.com:a/b.git", "https://evil.example/a/b",
                "https://github.com/-a/b", "https://github.com/a/..", "https://github.com/a/b/c", "ext::sh -c touch PWNED",
                "--upload-pack=touch PWNED", "https://github.com/a/b.git --depth", "file:///etc"):
        r = subprocess.run([cli, "install", url], capture_output=True, text=True, env=e)
        if r.returncode != 2:
            bad(f"olymparch-theme install {url!r} was not refused (rc {r.returncode})")
    for v in ("../zeus", "Zeus", "x" * 33, "nope", "zeus; rm -rf ~"):
        if subprocess.run([settings_cli, "set", "appearance.theme", v], capture_output=True, env=e).returncode != 2:
            bad(f"olymparch-settings set appearance.theme {v!r} was not refused")

    # ── backgrounds (docs/themes.md): scenes named in theme.json, your pictures, remembered per theme
    PNG = b"\x89PNG\r\n\x1a\n" + b"\0" * 40   # only the first bytes are checked; the shell decodes it
    for label, bgs in {"temple id": [{"id": "temple", "name": {"en": "T"}}], "unknown field": [{"id": "a", "name": {"en": "A"}, "cmd": "x"}],
                       "bad id": [{"id": "../a", "name": {"en": "A"}}], "twice": [{"id": "a", "name": {"en": "A"}}] * 2,
                       "no name": [{"id": "a"}], "object": {"a": {"en": "A"}}, "too many": [{"id": f"b{i}", "name": {"en": "B"}} for i in range(17)]}.items():
        d = theme("evil", variant(backgrounds=bgs))
        if subprocess.run([cli, "validate", str(d)], capture_output=True, env=e).returncode == 0:
            bad(f"olymparch-theme validate took bad backgrounds ({label})")
    shutil.rmtree(user / "evil")
    d = theme("mine", dict(variant(), id="mine", backgrounds=[{"id": "dawn", "name": {"en": "Dawn", "nb": "Daggry"}},
                                                               {"id": "gone", "name": {"en": "Not built", "nb": "Ikke laget"}}]))
    for rel in ("wallpaper/1080", "backgrounds/dawn/1080", "backgrounds/dawn/1440"):
        (d / rel).mkdir(parents=True)
        for i in range(3):
            (d / rel / f"frame-{i:02d}.png").write_bytes(PNG)
    mine_bg = Path(home, ".config/olymparch/backgrounds/mine")
    all_bg = Path(home, ".config/olymparch/backgrounds/all")
    mine_bg.mkdir(parents=True)
    all_bg.mkdir(parents=True)
    (mine_bg / "beach.png").write_bytes(PNG)
    (mine_bg / "Photo (2).JPG").write_bytes(b"\xff\xd8\xff\xe0" + b"\0" * 40)
    (all_bg / "sky.webp").write_bytes(b"RIFF\0\0\0\0WEBPVP8 " + b"\0" * 40)
    (d / "backgrounds/pack.png").write_bytes(PNG)
    (mine_bg / "fake.png").write_text("#!/bin/sh\ntouch PWNED\n" * 4)          # not a PNG inside
    (mine_bg / "big.png").write_bytes(PNG)
    os.truncate(mine_bg / "big.png", 20 * 1024 * 1024 + 1)                       # over 20 MiB
    secret.write_bytes(PNG)
    (mine_bg / "link.png").symlink_to(secret)                                     # a symlink
    (mine_bg / ".hidden.png").write_bytes(PNG)
    (mine_bg / "notes.txt").write_bytes(PNG)
    subprocess.run([cli, "set", "mine"], capture_output=True, env=e)
    r = subprocess.run([cli, "background", "list", "--json"], capture_output=True, text=True, env=e)
    try:
        got = [b["id"] for b in json.loads(r.stdout)]
    except ValueError:
        got = r.stdout + r.stderr
    want = ["temple", "dawn", "pack:pack.png", "mine:Photo (2).JPG", "mine:beach.png", "all:sky.webp"]
    if got != want:
        bad(f"olymparch-theme background list: {got}, expected {want}")
    r = subprocess.run([cli, "background", "set", "2"], capture_output=True, text=True, env=e)
    out_theme = json.loads(Path(home, ".config/olymparch/theme/theme.json").read_text())
    if r.returncode or out_theme.get("background") != "dawn" or not out_theme.get("wallpaper", "").endswith("/mine/backgrounds/dawn") \
            or out_theme.get("frames") != 3 or out_theme.get("sets") != ["1080", "1440"]:
        bad(f"olymparch-theme background set 2 did not use dawn: {out_theme} {r.stderr}")
    subprocess.run([cli, "background", "next"], capture_output=True, env=e)
    subprocess.run([cli, "background", "set", "mine:beach.png"], capture_output=True, env=e)
    out_theme = json.loads(Path(home, ".config/olymparch/theme/theme.json").read_text())
    if out_theme.get("image") != str(mine_bg / "beach.png") or out_theme.get("frames") != 1:
        bad(f"a picture of yours did not reach the shell: {out_theme}")
    subprocess.run([cli, "set", "zeus"], capture_output=True, env=e)
    if json.loads(Path(home, ".config/olymparch/theme/theme.json").read_text()).get("background") != "temple":
        bad("zeus did not start on its temple")
    subprocess.run([cli, "set", "mine"], capture_output=True, env=e)
    if json.loads(Path(home, ".config/olymparch/theme/theme.json").read_text()).get("background") != "mine:beach.png":
        bad("mine did not remember its background across a theme switch")
    (mine_bg / "beach.png").unlink()
    subprocess.run([cli, "apply"], capture_output=True, env=e)
    if json.loads(Path(home, ".config/olymparch/theme/theme.json").read_text()).get("background") != "temple":
        bad("a deleted picture did not fall back to the temple")
    for v in ("fake.png", "link.png", "big.png", "nope", "99", "0"):
        if subprocess.run([cli, "background", "set", "mine:" + v if v.endswith(".png") else v], capture_output=True, env=e).returncode != 2:
            bad(f"olymparch-theme background set {v!r} was not refused")
    for v in ("mine:../../secret.json", "mine:/etc/passwd", "file:x.png", "mine:a.png; rm", "mine:.hidden.png", "Temple", "x" * 33, "mine:a.txt"):
        if subprocess.run([settings_cli, "set", "appearance.background@mine", v], capture_output=True, env=e).returncode != 2:
            bad(f"olymparch-settings set appearance.background@mine {v!r} was not refused")
    for k in ("appearance.background", "appearance.background@../x", "appearance.background@Mine"):
        if subprocess.run([settings_cli, "set", k, "temple"], capture_output=True, env=e).returncode != 2:
            bad(f"olymparch-settings set {k} was not refused")
    shutil.rmtree(user / "mine")
    if list(Path(home).rglob("PWNED")):
        bad("something ran PWNED")

if problems:
    print("\n".join(problems))
    print(f"FAIL · {len(problems)} problem(s)")
    sys.exit(1)
cols = ["text/bg", "text/surface", "muted/bg", "accent/bg", "accent/surface", "accentHi/raised", "danger/bg"]
print(f"{'theme':12}" + "".join(f"{c:>16}" for c in cols))
for name, r in rows:
    print(f"{name:12}" + "".join(f"{r[c]:>14.2f}:1" for c in cols))
print(f"PASS · {len(rows)} themes, every pair at least 4.5:1; bad themes, URLs and ids refused; backgrounds listed, remembered per theme and checked")
