#!/usr/bin/env python3
"""olymparch-mcp without a VM: protocol conformance and every refusal.

  tests/mcp-check        exit 0 and «mcp-check: N checks OK», or 1 and one line per failure

Runs system/bin/olymparch-mcp in a throw-away HOME with stand-ins on PATH (qs answers the approval card as the
test says, hyprctl/wpctl/notify-send/systemctl/claude/hermes/openclaw only log), so nothing on this machine is
touched. Checks: initialize / version negotiation, tools/list (a risk on every tool), tools/call, JSON-RPC errors,
argument validation, path traversal and hidden files, approvals (once, always, denied, timed out, game mode,
cancelled), policy and blocked clients, ai.* keys refused, the audit log (no secrets, no content), HTTP (token,
Origin, Host, session, sizes) and registration with the agents (idempotent, reversible, never over yours).
"""
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MCP = str(ROOT / "system/bin/olymparch-mcp")
SETTINGS = str(ROOT / "system/bin/olymparch-settings")
fails, oks = [], 0


def ok(cond, what):
    global oks
    if cond:
        oks += 1
    else:
        fails.append(what)
    return cond


tmp = Path(tempfile.mkdtemp(prefix="mcp-check-"))
home = tmp / "home"
stubs = tmp / "stubs"
run_dir = tmp / "run"
for d in (home, stubs, run_dir):
    d.mkdir(mode=0o700)
os.chmod(run_dir, 0o700)

