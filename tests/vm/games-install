#!/bin/bash
# VM test: a full install from the ISO with OPTIONS=games, then checks on the installed system: Steam, gamemode,
# MangoHud and the 32-bit Vulkan driver are installed, [multilib] is on, the user is in group gamemode,
# /etc/gamemode.ini and the split-lock sysctl are in place, and the Steam menu entry starts our wrapper.
#   tests/vm/games-install [ISO]
set -uo pipefail
cd "$(dirname "$0")/../.."
. dev/env
ISO=${1:-$(ls -t out/*.iso 2>/dev/null | head -n 1)}
[ -f "$ISO" ] || { echo "fant ingen ISO" >&2; exit 2; }
O=tests/vm/out/games-install
rm -rf -- tests/vm/out/games-install
mkdir -p "$O" cache
cp "$OLYMPARCH_OVMF_VARS" "$O/vars.fd"
qemu-img create -q -f qcow2 "$O/disk.qcow2" 24G
PW='olymp-test-123'
cat >"$O/answers.env" <<EOF
DISK=/dev/nvme0n1
DISK_SERIAL=OLYTEST1
HOSTNAME=olymparch
USERNAME=zeus
PASSWORD='$PW'
KEYMAP=us
LOCALE=en_US.UTF-8
TIMEZONE=Europe/Oslo
OPTIONS=games
CMDLINE_EXTRA='console=ttyS0,115200 console=tty0 plymouth.ignore-serial-consoles'
EOF
QMP=$O/qmp.sock
. tests/vm/lib.sh
trap 'kill "$QPID" 2>/dev/null' EXIT
t0=$SECONDS

# --- 1. install from the live ISO, with the host's package cache
vm live.log -cdrom "$ISO" -boot d -fw_cfg name=opt/olymparch/answers,file="$O/answers.env" \
    -virtfs local,path="$PWD/cache",mount_tag=pkgcache,security_model=none,id=c0
wait_for 'login:' 120 || { shot live-feil "Live-miljøet kom ikke opp"; finish "FAIL · live-miljøet startet ikke"; }
sleep 4
keys 'modprobe qemu_fw_cfg && cp /sys/firmware/qemu_fw_cfg/by_name/opt/olymparch/answers/raw /tmp/answers.env && mount -t 9p -o trans=virtio pkgcache /var/cache/pacman/pkg && OLYMPARCH_TEST=1 OLYMPARCH_HOST_CACHE=1 olymparch-install --answers /tmp/answers.env; echo "<2>INSTALL-EXIT=$?" > /dev/kmsg\n'
sleep 3
shot start "Installasjonen startes med OPTIONS=games"
shot_done=0
for ((i = 0; i < 2400; i++)); do
    if ((!shot_done)) && seen 'olymparch-install: Valg'; then
        sleep 20; shot valg "Installasjonen: «Valg: games» (Steam, gamemode, MangoHud, lib32-Vulkan)"; shot_done=1
    fi
    seen 'INSTALL-EXIT=' && break
    kill -0 "$QPID" 2>/dev/null || break
    sleep 1
done
code=$(grep -aoE 'INSTALL-EXIT=[0-9]+' "$O/$LOG" | tail -n 1 | cut -d= -f2)
[ "$code" = 0 ] || { shot feil "Installasjonen stoppet"; finish "FAIL · installasjonen stoppet (kode ${code:-ingen}) etter $((SECONDS - t0)) s"; }
shot ferdig "Installasjonen er ferdig"
keys 'poweroff\n'
for ((i = 0; i < 60; i++)); do kill -0 "$QPID" 2>/dev/null || break; sleep 1; done
kill "$QPID" 2>/dev/null; wait "$QPID" 2>/dev/null

# --- 2. the installed system
vm boot.log
unlock_and_desktop "$PW"
shot skrivebord "Det installerte systemet med spillvalget"
press meta_l+ret; sleep 2
keys "clear; pacman -Q steam gamemode lib32-gamemode mangohud lib32-mangohud gamescope umu-launcher ntsync-autoload lib32-vulkan-swrast; grep -A1 '^\\[multilib\\]' /etc/pacman.conf; id -nG; sysctl kernel.split_lock_mitigate; grep -E '^(renice|pin_cores|disable_splitlock|start)=' /etc/gamemode.ini; grep ^Exec= /usr/local/share/applications/steam.desktop\n" 3
shot sjekk "pacman -Q, [multilib], gruppen gamemode, sysctl, gamemode.ini og Steam-menyoppføringen"
keys "{ pacman -Q steam gamemode lib32-gamemode mangohud lib32-mangohud lib32-vulkan-swrast && echo PKGS-OK; grep -qx '\\[multilib\\]' /etc/pacman.conf && echo MULTILIB-OK; id -nG | grep -qw gamemode && echo GROUP-OK; grep -qx renice=0 /etc/gamemode.ini && grep -qx disable_splitlock=1 /etc/gamemode.ini && echo INI-OK; [ \"\$(sysctl -n kernel.split_lock_mitigate)\" = 0 ] && echo SYSCTL-OK; grep -q '^Exec=/usr/bin/olymparch-launch-steam' /usr/local/share/applications/steam.desktop && echo DESKTOP-OK; command -v olymparch-game-hook olymparch-proton >/dev/null && echo TOOLS-OK; } >/tmp/c.txt 2>&1; sudo sh -c 'while read -r l; do echo \"<2>CHK: \$l\" >/dev/kmsg; done </tmp/c.txt; echo \"<2>CHK-DONE\" >/dev/kmsg'\n" 1.5
keys "$PW\n" 1
wait_for 'CHK-DONE' 30
missing=()
for k in PKGS MULTILIB GROUP INI SYSCTL DESKTOP TOOLS; do seen "CHK: $k-OK" || missing+=("$k"); done
[ ${#missing[@]} = 0 ] && finish "PASS · installert med OPTIONS=games: steam, gamemode, mangohud, lib32-Vulkan, multilib, gruppe, gamemode.ini, sysctl og Steam-wrapper på $((SECONDS - t0)) s"
finish "FAIL · mangler: ${missing[*]}"
