#!/bin/bash
# VM test: backgrounds (docs/themes.md, «Backgrounds»). Copies the shell, lock screen, settings, olymparch-theme and every
# theme with its temple and scenes (made here at 1080 with art/torch.py and art/scenes/render.py) into a copy of the
# installed disk. Then, for every theme: each background on an empty desktop, and with a floating terminal and two
# notifications over it (is the text readable?); the background picker (Super+Ctrl+Space) with → trying the next one
# and Esc going back; Settings → Appearance → Background with its thumbnails. Then pictures of your own dropped into
# ~/.config/olymparch/backgrounds (and some that must be skipped), the choice remembered per theme across a theme
# switch, and Live wallpaper Off keeping a background still. Pictures in tests/vm/out/backgrounds/ (contact sheets per
# theme in sheets/) and tests/vm/out/backgrounds.html.
#   OLYMPARCH_BASE=$HOME/dev/olymparch-base tests/vm/backgrounds [ID …]
set -uo pipefail
cd "$(dirname "$0")/../.."
. dev/env
SRC=${OLYMPARCH_BASE:-tests/vm/out/install-disk}   # a read-only installed disk to test on (overlay)
[ -f "$SRC/disk.qcow2" ] || { echo "kjør tests/vm/install-disk først (eller sett OLYMPARCH_BASE)" >&2; exit 2; }
O=tests/vm/out/backgrounds
rm -rf -- tests/vm/out/backgrounds
mkdir -p "$O/sheets"
install -m644 "$SRC/vars.fd" "$O/vars.fd"   # a writable copy (the base is read-only)
qemu-img create -q -f qcow2 -b "$(realpath "$SRC/disk.qcow2")" -F qcow2 "$O/disk.qcow2"
QMP=$O/qmp.sock
. tests/vm/lib.sh
PW='olymp-test-123'
trap 'kill "$QPID" 2>/dev/null; python3 -I tests/vm/report.py tests/vm/out/backgrounds.html "$O" >/dev/null 2>&1' EXIT
t0=$SECONDS
fails=()
if [ $# -gt 0 ]; then ids=("$@"); else
    ids=(zeus)
    for t in default/themes/*/theme.json; do id=$(basename "$(dirname "$t")"); [ "$id" = zeus ] || ids+=("$id"); done
fi

# ── the art at 1080 (the VM's screen is smaller), made on this machine and kept between runs
py() { if command -v uv >/dev/null; then uv run -q --no-project --with pillow python "$@"; else python "$@"; fi; }
A=tests/vm/out/backgrounds-art
jobs=()
for id in "${ids[@]}"; do
    t=default/themes/$id/theme.json
    c=$A/$id/temple/1080
    if [ "$id" != zeus ] && ! { [ -s "$c/frame-47.png" ] && [ "$c/frame-47.png" -nt "$t" ] && [ "$c/frame-47.png" -nt art/torch.py ]; }; then
        jobs+=("TORCH $c 1920 1080 48 $t")
    fi
    for scene in $(py art/scenes/render.py "$t" --list | cut -d' ' -f1); do
        c=$A/$id/$scene/1080
        if [ -s "$c/frame-00.png" ] && [ -z "$(find "$t" "art/scenes/$id.py" art/scenes/pixel.py art/scenes/common.py -newer "$c/frame-00.png")" ]; then :; else
            rm -rf -- "$c"
            jobs+=("$t $scene $c 1920 1080")
        fi
    done
done
if [ ${#jobs[@]} -gt 0 ]; then
    printf '%s\n' "${jobs[@]}" | xargs -P "$(nproc)" -L1 sh -c 'if [ "$1" = TORCH ]; then shift; s=art/torch.py; else s=art/scenes/render.py; fi
        if command -v uv >/dev/null; then uv run -q --no-project --with pillow python $s "$@"; else python $s "$@"; fi >/dev/null' art
fi
# pictures of your own: a photo-like JPEG, a PNG for every theme, and a text file called .png (must be skipped)
py - "$A/user" <<'EOF'
import sys
from pathlib import Path
from PIL import Image, ImageDraw
d = Path(sys.argv[1]); d.mkdir(parents=True, exist_ok=True)
if not (d / "Fyrlykt.jpg").exists():
    im = Image.new("RGB", (1600, 1000)); dr = ImageDraw.Draw(im)
    for y in range(1000):
        k = y / 1000
        dr.line((0, y, 1600, y), fill=(int(20 + 90 * k), int(30 + 40 * k), int(70 - 30 * k)) if y < 640 else (10, 20, 35))
    dr.polygon([(1080, 640), (1110, 330), (1150, 330), (1180, 640)], fill=(15, 12, 18))
    dr.rectangle((1100, 290, 1160, 330), fill=(250, 210, 120))
    dr.polygon([(1100, 290), (1130, 250), (1160, 290)], fill=(15, 12, 18))
    im.save(d / "Fyrlykt.jpg", quality=88)
    sk = Image.new("RGB", (1920, 1080)); dr = ImageDraw.Draw(sk)
    for y in range(1080):
        dr.line((0, y, 1920, y), fill=(int(40 + 60 * y / 1080), int(20 + 30 * y / 1080), int(60 + 40 * y / 1080)))
    sk.save(d / "Skumring.png")
    (d / "fake.png").write_text("#!/bin/sh\necho not a picture\n" * 4)
EOF

bar_pixel() {  # the colour of the bar at x=300, as rrggbb
    python3 -I tests/vm/qmp.py "$QMP" screendump "$PWD/$O/probe.ppm" 2>/dev/null
    python3 -I -c 'import sys
d = open(sys.argv[1], "rb").read().split(b"\n", 3)
w = int(d[1].split()[0])
i = (14 * w + 300) * 3
print("%02x%02x%02x" % tuple(d[3][i:i + 3]))' "$O/probe.ppm"
}
same_screen() {  # same_screen: two screen dumps a second apart are identical (0) or not (1); the bar's clock is masked
    python3 -I tests/vm/qmp.py "$QMP" screendump "$PWD/$O/a.ppm" 2>/dev/null; sleep 1.1
    python3 -I tests/vm/qmp.py "$QMP" screendump "$PWD/$O/b.ppm" 2>/dev/null
    python3 -I -c 'import sys
a, b = (open(p, "rb").read().split(b"\n", 3) for p in sys.argv[1:3])
w = int(a[1].split()[0]); row = w * 3
sys.exit(0 if a[3][40 * row:] == b[3][40 * row:] else 1)' "$O/a.ppm" "$O/b.ppm"
}
dismiss() {  # a click dismisses each notification (the critical ones stay until then)
    for _ in 1 2 3; do python3 -I tests/vm/qmp.py "$QMP" click 1088 70 1280 800; sleep 0.6; done
    python3 -I tests/vm/qmp.py "$QMP" click 640 420 1280 800   # the pointer back in the middle: focus follows it
}

vm boot.log -virtfs local,path="$PWD",mount_tag=olysrc,security_model=none,readonly=on,id=src \
    -audiodev none,id=snd0 -device ich9-intel-hda -device hda-output,audiodev=snd0 -device qemu-xhci -device usb-tablet
unlock_and_desktop "$PW"

# This repo's files in place (the themes with their temples and scenes), the shell restarted in Norwegian, the helpers
press meta_l+ret; sleep 2
keys "sudo mount -t 9p -o trans=virtio,ro olysrc /mnt && sudo cp -r /mnt/default/shell/. /usr/share/olymparch/shell/ && sudo cp -r /mnt/default/i18n /mnt/default/settings /mnt/default/lock /usr/share/olymparch/ && sudo cp /mnt/default/hypr/olymparch.lua /usr/share/olymparch/hypr/ && sudo install -Dm644 /mnt/default/foot/foot.ini /etc/xdg/foot/foot.ini && sudo install -m755 /mnt/system/bin/olymparch-settings /mnt/system/bin/olymparch-theme /usr/bin/ && sudo install -m755 /mnt/tests/vm/backgrounds-guest.sh /usr/local/bin/bgt && sudo mkdir -p /usr/share/olymparch/themes && sudo cp -r /mnt/default/themes/. /usr/share/olymparch/themes/ && for d in /mnt/tests/vm/out/backgrounds-art/*/*/1080; do s=\${d%/1080}; sc=\${s##*/}; i=\${s%/*}; i=\${i##*/}; [ \$i = user ] && continue; if [ \$sc = temple ]; then t=/usr/share/olymparch/themes/\$i/wallpaper; else t=/usr/share/olymparch/themes/\$i/backgrounds/\$sc; fi; sudo mkdir -p \$t && sudo cp -r \$d \$t/; done; sudo chmod 666 /dev/kmsg && olymparch-theme apply --quiet; hyprctl reload >/dev/null; pkill -x launch-shell; pkill -x quickshell; sleep 1; LANG=nb_NO.UTF-8 setsid -f /usr/lib/olymparch/launch-shell; echo '<2>BG-UPDATED' > /dev/kmsg\n" 1
keys "$PW\n" 1
wait_for 'BG-UPDATED' 120 || finish "FAIL · fikk ikke kopiert filene inn"
sleep 4
shot start "Skrivebordet før bakgrunnene (Zevs, tempelet)"

for id in "${ids[@]}"; do
    name=$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1]))["name"]["nb"])' "default/themes/$id/theme.json")
    mapfile -t bgs < <(python3 -I -c 'import json, sys
t = json.load(open(sys.argv[1]))
print("Tempelet")
for b in t.get("backgrounds", []): print(b["name"]["nb"])' "default/themes/$id/theme.json")
    bg=$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1]))["palette"]["bg"][1:])' "default/themes/$id/theme.json")
    # switch (the terminal closes), then a new floating terminal in the new colours
    keys "\n" 0.8   # the first key after the lock screen can go missing
    keys " olymparch-theme set $id && sleep 0.5 && bgt term && exit\n" 3
    for i in "${!bgs[@]}"; do
        nr=$((i + 1))
        keys "clear; bgt set $nr $id$nr\n" 0.3
        wait_for "BG-SET-$id$nr-(OK|NO)" 15
        seen "BG-SET-$id$nr-OK" || fails+=("$id-$nr-set")
        press meta_l+2; sleep 2
        shot "$id-$nr-skrivebord" "$name · $nr ${bgs[$i]}: på et tomt skrivebord"
        px=$(bar_pixel)
        python3 -I -c 'import sys
a, b = (bytes.fromhex(x) for x in sys.argv[1:3])
sys.exit(0 if all(abs(x - y) <= 6 for x, y in zip(a, b)) else 1)' "$px" "$bg" || fails+=("$id-$nr-bar ($px, ventet $bg)")
        press meta_l+1; sleep 0.8
        keys "clear; bash /mnt/tests/vm/palette.sh; bgt note\n" 1.5
        shot "$id-$nr-terminal" "$name · $nr ${bgs[$i]}: med en flytende terminal og to varsler over"
        dismiss
    done
    # the picker: → tries the next one at once, Esc goes back to the one in use
    press meta_l+2; sleep 1
    press ctrl+meta_l+spc; sleep 2
    shot "$id-velger" "$name: Super+Ctrl+Space, bakgrunnsvelgeren"
    press right; sleep 2
    shot "$id-velger-prov" "$name: → viser neste bakgrunn med en gang (ikke lagret ennå)"
    press esc; sleep 1.5
    shot "$id-velger-tilbake" "$name: Esc går tilbake til den i bruk"
    press meta_l+1; sleep 0.8
    keys "clear; olymparch-settings open appearance\n" 2.5
    keys "husker sin egen" 1.5
    shot "$id-innstillinger" "$name: Innstillinger → Utseende → Bakgrunn med miniatyrer (søk «husker sin egen»)"
    press esc; press esc; sleep 1.5
    python3 -I tests/vm/qmp.py "$QMP" click 640 420 1280 800
    sleep 0.5
done

# ── your own pictures: in Hades' folder and the one for every theme; a fake, a symlink and a too big one are skipped
keys "\n" 0.5
keys " olymparch-theme set hades && sleep 0.5 && bgt term && exit\n" 3
keys "clear; bgt set 1 egne; bgt user; olymparch-theme background list\n" 2
wait_for 'CHK-user-(OK|NO)' 20
seen 'CHK-user-OK' || fails+=("egne-bilder")
shot egne-liste "Hades: egne bilder i listen (fake.png, en symlenke og en for stor fil er hoppet over)"
press meta_l+2; sleep 1
press ctrl+meta_l+spc; sleep 2
shot egne-velger "Hades: velgeren med egne bilder etter scenene"
for _ in 1 2 3 4; do press right; sleep 0.4; done
sleep 1.5
shot egne-prov "Hades: → til ditt eget bilde (Fyrlykt.jpg), fyller skjermen"
press ret; sleep 2.5
shot egne-valgt "Hades: Enter beholder det; tomt skrivebord med ditt bilde"
press meta_l+1; sleep 0.8
keys "clear; olymparch-theme background current; bgt note\n" 1.5
shot egne-terminal "Hades: ditt bilde med terminal og varsler over"
dismiss

# ── remembered per theme across a theme switch (Hades → Zeus → Athena → Hades)
keys "clear; bgt remember\n" 1
wait_for 'CHK-remember-(OK|NO)' 40
seen 'CHK-remember-OK' || fails+=("husket-per-tema")
grep -aoE 'BG-REMEMBER.*' "$O/$LOG" | head -1 >"$O/remember.txt"
keys "bgt term && exit\n" 2.5
keys "clear; olymparch-theme background list\n" 1.5
shot husket "Zevs etter byttene: «Over skyene» er fortsatt valgt (*)"

# ── Live wallpaper: Torch moves, Off is still (on Zeus' storm, which drifts all the time)
keys "clear; olymparch-theme background set storm >/dev/null; olymparch-settings set appearance.wallpaper torch\n" 2
press meta_l+2; sleep 1.5
same_screen && fails+=("fakkel-står-stille")
press meta_l+1; sleep 0.5
keys "clear; olymparch-settings set appearance.wallpaper off\n" 2
press meta_l+2; sleep 1.5
same_screen || fails+=("av-beveger-seg")
shot av "Zevs, uvær med «Levende bakgrunn: Av»: står stille"
press meta_l+1; sleep 0.5
keys "clear; olymparch-settings set appearance.wallpaper torch\n" 1.5

# The shell's own log on the serial console
keys "sh -c 'tail -n 80 ~/.local/state/olymparch/shell.log | while IFS= read -r l; do echo \"<2>QS: \$l\" > /dev/kmsg; done; echo \"<2>LOG-DONE\" > /dev/kmsg'\n" 1
wait_for 'LOG-DONE' 20
grep -aoE 'QS: .*' "$O/$LOG" | sed 's/\x1b\[[0-9;]*m//g' >"$O/shell-log.txt"
errors=$(awk '/Launching config/ {n = 0} /ERROR|TypeError|ReferenceError/ {n++} END {print n + 0}' "$O/shell-log.txt")
((errors == 0)) || fails+=("$errors feil i skall-loggen")

# contact sheets: every background of a theme on one picture (the empty-desktop shots)
py - "$O" <<'EOF'
import re
import sys
from pathlib import Path
from PIL import Image
o = Path(sys.argv[1])
shots = {}
for p in sorted(o.glob("*-skrivebord.png")):
    m = re.match(r"\d+-(.+)-(\d+)-skrivebord\.png", p.name)
    if m:
        shots.setdefault(m.group(1), []).append(p)
for tid, ps in shots.items():
    tiles = [Image.open(p).convert("RGB") for p in ps]
    w, h = tiles[0].size
    cols = 2
    sheet = Image.new("RGB", (cols * w + (cols + 1) * 16, ((len(tiles) + 1) // 2) * (h + 16) + 16), (12, 12, 14))
    for i, t in enumerate(tiles):
        sheet.paste(t, (16 + (i % cols) * (w + 16), 16 + (i // cols) * (h + 16)))
    sheet.save(o / "sheets" / f"{tid}.png")
EOF
finish "$([ ${#fails[@]} = 0 ] && echo PASS || echo "FAIL (${fails[*]})") · ${#ids[@]} temaer: hver bakgrunn på tomt skrivebord og under terminal og varsler, velgeren, innstillingene; egne bilder, husket per tema, Av står stille, på $((SECONDS - t0)) s"
