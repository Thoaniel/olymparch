#!/bin/bash
# VM test: events go to the right tool. On a copy of the installed disk (OLYMPARCH_BASE), with the event pieces
# copied in from this repo:
#   download virus check (a clamscan stub flags the EICAR test file; no 200 MB virus database in the test),
#   disk nearly full (threshold lowered), archive → extracted with one click, USB disk plugged in → mounted.
#   magnet link with no torrent app → offer; one click installs Transmission (pkexec install-app) and opens it.
set -uo pipefail
cd "$(dirname "$0")/../.."
. dev/env
SRC=${OLYMPARCH_BASE:-tests/vm/out/install-disk}
[ -f "$SRC/disk.qcow2" ] || { echo "kjør tests/vm/install-disk først" >&2; exit 2; }
O=tests/vm/out/events
rm -rf -- tests/vm/out/events
mkdir -p "$O"
install -m644 "$SRC/vars.fd" "$O/vars.fd"   # a writable copy (the base is read-only)
qemu-img create -q -f qcow2 -b "$(realpath "$SRC/disk.qcow2")" -F qcow2 "$O/disk.qcow2"
# a small USB stick with a file on it, plugged in later through QMP
truncate -s 64M "$O/usb.img"
mkfs.fat -n OLYUSB "$O/usb.img" >/dev/null
echo "Hei fra USB-pinnen" >"$O/hei.txt"
mcopy -i "$O/usb.img" "$O/hei.txt" ::/hei.txt
QMP=$O/qmp.sock
. tests/vm/lib.sh
PW='olymp-test-123'
trap 'kill "$QPID" 2>/dev/null' EXIT
t0=$SECONDS
vm boot.log -virtfs local,path="$PWD",mount_tag=olysrc,security_model=none,readonly=on,id=src \
    -device qemu-xhci,id=xhci -drive if=none,id=usbstick,format=raw,file="$O/usb.img"
unlock_and_desktop "$PW"

press meta_l+ret; sleep 2
# put the event pieces in place (packages from the base disk's cache/mirrors), a clamscan stub for the test
keys "sudo mount -t 9p -o trans=virtio,ro olysrc /mnt && sudo install -m755 /mnt/system/bin/olymparch-* /usr/bin/ && sudo install -Dm644 -t /usr/lib/systemd/user /mnt/default/systemd/user/* && sudo install -Dm644 /mnt/default/apps/olymparch-extract.desktop /usr/share/applications/olymparch-extract.desktop && sudo install -Dm644 /mnt/default/apps/mimeapps.list /etc/xdg/mimeapps.list && sudo cp -r /mnt/default/shell/. /usr/share/olymparch/shell/ && sudo cp -r /mnt/default/i18n /usr/share/olymparch/ && pkill -x quickshell; sudo pacman -S --noconfirm --needed udiskie udisks2 xdg-utils xdg-user-dirs >/dev/null && printf '#!/bin/sh\\nr=0; for f; do grep -q EICAR \"\$f\" && { echo \"\$f: Eicar-Signature FOUND\"; r=1; }; done; exit \$r\\n' | sudo tee /usr/local/bin/clamscan >/dev/null && sudo chmod +x /usr/local/bin/clamscan && echo '<2>EVENTS-READY' | sudo tee /dev/kmsg\n" 1
keys "$PW\n" 1
wait_for 'EVENTS-READY' 240 || finish "FAIL · fikk ikke lagt inn hendelsesdelene"
keys "mkdir -p ~/Downloads && systemctl --user daemon-reload && systemctl --user start olymparch-downloads.path && (udiskie --automount --notify --no-tray &) && clear\n" 2
shot klar "Hendelsesdelene er lagt inn"

# 1. A dangerous download (the EICAR test string, harmless) → critical notification
keys "printf 'X5O!P%%@AP[4\\\\\\\\PZX54(P^)7CC)7}\$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!\$H+H*' > ~/Downloads/setup.exe\n" 7
shot virus "Nedlastet setup.exe med EICAR-testteksten: kritisk varsel"
python3 -I tests/vm/qmp.py "$QMP" screendump "$PWD/$O/virus.ppm"
red=$(python3 -I tests/vm/pixels.py "$O/virus.ppm" | sed -E 's/.*red=([0-9]+).*/\1/')

# 2. Disk nearly full (threshold lowered to 1 % for the test) → notification with «Rydd opp»
keys "OLYMPARCH_DISK_LIMIT=1 olymparch-disk-check &\n" 3
shot disk "Disken er «full»: varsel med Rydd opp"

# 3. An archive opens with the extract tool
keys "cd ~/Downloads && echo hei > notat.txt && bsdtar -a -cf pakke.zip notat.txt && rm notat.txt && xdg-open pakke.zip; sleep 2; ls ~/Downloads\n" 4
shot arkiv "pakke.zip åpnet: pakket ut til mappen «pakke»"

# 4. USB stick plugged in → mounted, notification
python3 -I tests/vm/qmp.py "$QMP" cmd device_add '{"driver": "usb-storage", "bus": "xhci.0", "drive": "usbstick", "id": "stick"}' >/dev/null
sleep 5
shot usb "USB-pinnen satt inn: montert, varsel fra udiskie"
keys "clear; findmnt -no TARGET -S LABEL=OLYUSB && cat \"\$(findmnt -no TARGET -S LABEL=OLYUSB)/hei.txt\" && echo '<2>USB-MOUNTED' | sudo tee /dev/kmsg\n" 2
wait_for 'USB-MOUNTED' 15
shot usb-innhold "Filen på USB-pinnen kan leses"

# ── 5. Torrents: a magnet link with no torrent app → offer Transmission; one click installs it and opens the link
torrent=ok
keys "clear; sudo install -m755 /mnt/system/bin/olymparch-open-torrent /usr/bin/ && sudo install -Dm755 /mnt/system/lib/install-app /usr/lib/olymparch/install-app && sudo install -m644 /mnt/system/polkit/org.olymparch.install-app.policy /usr/share/polkit-1/actions/ && sudo install -m644 /mnt/system/polkit/50-olymparch-install-app.rules /usr/share/polkit-1/rules.d/ && sudo install -m644 /mnt/default/apps/olymparch-open-torrent.desktop /usr/share/applications/ && sudo install -m644 /mnt/default/apps/mimeapps.list /etc/xdg/mimeapps.list && sudo systemctl restart polkit && ! command -v transmission-gtk && sudo chmod 666 /dev/kmsg && echo '<2>TORRENT-READY' >/dev/kmsg; clear\n" 2
wait_for 'TORRENT-READY' 30 || torrent="ikke klar"
python3 -I tests/vm/qmp.py "$QMP" cmd device_add '{"driver": "usb-tablet", "bus": "xhci.0", "id": "tablet"}' >/dev/null
# an evil link is refused before anything runs (and never reaches a shell)
keys "xdg-open 'magnet:?xt=urn:btih:0123456789abcdef0123456789abcdef01234567&dn=\$(touch ~/PWNED)' 2>~/torrent.log; sleep 1; cat ~/torrent.log\n" 2
shot torrent-avvist "Magnetlenke med \$(…) i: avvist, varsel «Ikke en torrent», ingenting kjørt"
sleep 8   # until that toast has gone, so the offer is the newest notification
mag='magnet:?xt=urn:btih:0123456789abcdef0123456789abcdef01234567&dn=Olymparch+test'
keys "clear; xdg-mime query default x-scheme-handler/magnet; setsid -f xdg-open '$mag' 2>>~/torrent.log </dev/null\n" 1
if xy=$(for i in $(seq 30); do python3 -I tests/vm/qmp.py "$QMP" screendump "$PWD/$O/probe.ppm" 2>/dev/null &&
        python3 -I tests/vm/button.py "$O/probe.ppm" 0 2>/dev/null && break; sleep 1; done); [ -n "$xy" ]; then
    shot torrent-tilbud "xdg-open magnet:-lenke uten torrent-app: varsel «Ingen torrent-app» med «Installer Transmission»"
else
    shot torrent-feil "Ingen varsel for magnetlenken"; torrent="intet tilbud"
fi
[ "$torrent" = ok ] && {
    # typed first: Transmission takes the keyboard focus when it opens
    keys "clear; for i in \$(seq 120); do pgrep -x transmission-gt >/dev/null && break; sleep 2; done; sleep 4; pgrep -af transmission-gtk | grep -q 'btih:0123456789abcdef0123456789abcdef01234567' && ! [ -e ~/PWNED ] && grep -q 'offering Transmission' ~/torrent.log && grep -q 'refused' ~/torrent.log && echo '<2>TORRENT-OPENED' >/dev/kmsg\n" 1
    # shellcheck disable=SC2086
    python3 -I tests/vm/qmp.py "$QMP" click $xy
    sleep 2
    shot torrent-installerer "Klikk på «Installer Transmission»: pkexec /usr/lib/olymparch/install-app torrent"
    wait_for 'TORRENT-OPENED' 280 || torrent="Transmission åpnet ikke lenken"
    shot torrent-transmission "Transmission installert med ett klikk og åpner magnetlenken"
}

ok=1
[ "$torrent" = ok ] || ok=0
seen 'USB-MOUNTED' || ok=0
(( ${red:-0} > 40 )) || ok=0   # the critical toast has a red border
finish "$([ $ok = 1 ] && echo PASS || echo FAIL) · hendelser: virus (røde piksler: ${red:-0}), disk, arkiv, USB og torrent ($torrent) på $((SECONDS - t0)) s"
