#!/bin/bash
# VM test: the shell. Copies default/shell and default/hypr from this repo into a copy of the installed disk
# (no rebuild needed), restarts the shell, then tries the menu, notifications and the volume OSD.
set -uo pipefail
cd "$(dirname "$0")/../.."
. dev/env
SRC=${OLYMPARCH_BASE:-tests/vm/out/install-disk}   # a read-only installed disk to test on (overlay)
[ -f "$SRC/disk.qcow2" ] || { echo "kjør tests/vm/install-disk først" >&2; exit 2; }
O=tests/vm/out/shell
rm -rf -- tests/vm/out/shell
mkdir -p "$O"
install -m644 "$SRC/vars.fd" "$O/vars.fd"   # a writable copy (the base is read-only)
qemu-img create -q -f qcow2 -b "$(realpath "$SRC/disk.qcow2")" -F qcow2 "$O/disk.qcow2"
QMP=$O/qmp.sock
. tests/vm/lib.sh
PW='olymp-test-123'
trap 'kill "$QPID" 2>/dev/null' EXIT
t0=$SECONDS
vm boot.log -virtfs local,path="$PWD",mount_tag=olysrc,security_model=none,readonly=on,id=src \
    -audiodev none,id=snd0 -device ich9-intel-hda -device hda-output,audiodev=snd0
unlock_and_desktop "$PW"

# Put the shell from the repo in place and restart it
press meta_l+ret; sleep 2
keys "sudo mount -t 9p -o trans=virtio,ro olysrc /mnt && sudo cp -r /mnt/default/shell/. /usr/share/olymparch/shell/ && sudo cp -r /mnt/default/i18n /usr/share/olymparch/ && sudo cp -r /mnt/default/lock /mnt/default/idle /usr/share/olymparch/ && sudo cp /mnt/default/hypr/olymparch.lua /usr/share/olymparch/hypr/ && sudo install -Dm644 /mnt/default/foot/foot.ini /etc/xdg/foot/foot.ini && sudo install -Dm644 /mnt/default/idle/olymparch-lock.pam /etc/pam.d/olymparch-lock && sudo install -m755 /mnt/system/bin/olymparch-lock /usr/bin/ && hyprctl reload >/dev/null; pkill -x quickshell; echo '<2>SHELL-UPDATED' | sudo tee /dev/kmsg; exit\n" 1
keys "$PW\n" 1
wait_for 'SHELL-UPDATED' 30 || finish "FAIL · fikk ikke kopiert skallet inn"
sleep 5
shot skrivebord "Skrivebordet med det nye skallet"

# The menu
press meta_l+spc; sleep 1
shot meny "Super+Space åpner menyen med alle apper"
keys "foo" 1
shot meny-sok "Søk: «foo» finner terminalen"
press ret; sleep 2
shot meny-start "Enter starter terminalen"

# Notifications (from that terminal)
keys "notify-send 'Steam' 'Hades II er oppdatert'; sleep 1; notify-send -u critical 'Disk' 'Disken er 95 % full'\n" 2
shot varsler "Varsler: et vanlig og et kritisk (rød kant)"

# Volume OSD
keys "wpctl set-volume @DEFAULT_AUDIO_SINK@ 65%\n" 0.6
shot volum "Volumvisningen: 65 %"
keys "wpctl set-mute @DEFAULT_AUDIO_SINK@ 1\n" 0.6
shot dempet "Dempet"
python3 -I tests/vm/qmp.py "$QMP" screendump "$PWD/$O/bar-before.ppm"
red_before=$(python3 -I tests/vm/pixels.py "$O/bar-before.ppm" 640 0 1280 34 | sed -E 's/.*red=([0-9]+).*/\1/')

# The bar: an app that records from the microphone gets a red microphone in the bar
# (the VM has no sound card: a virtual microphone in PipeWire, nothing is played on the host)
keys "clear; pw-cli create-node adapter '{ factory.name=support.null-audio-sink node.name=testmic media.class=Audio/Source/Virtual object.linger=true audio.position=[FL FR] }' >/dev/null; sleep 1; pw-record --target testmic /tmp/opptak.wav & sleep 2\n" 1
shot mikrofon "Et program tar opp fra mikrofonen: rød mikrofon i linjen"
python3 -I tests/vm/qmp.py "$QMP" screendump "$PWD/$O/bar-mic.ppm"
red_mic=$(python3 -I tests/vm/pixels.py "$O/bar-mic.ppm" 640 0 1280 34 | sed -E 's/.*red=([0-9]+).*/\1/')
keys "kill %1; clear\n" 2
shot mikrofon-av "Opptaket er stoppet: mikrofonen er borte fra linjen"

# The lock screen: its own process. Wrong password first, then the right one.
press meta_l+l; sleep 2
shot las "Super+L: låseskjermen (stillbilde av tempelet, klokke, passordboks)"
keys "feilpassord" 0.5
shot las-skriver "Tegnene vises som gullfirkanter"
press ret; sleep 4
shot las-feil "Feil passord: boksen blir rød"
keys "$PW\n" 4
shot las-opp "Riktig passord: skrivebordet er tilbake"
keys "pgrep -f share/olymparch/lock >/dev/null || echo '<2>UNLOCKED' | sudo tee /dev/kmsg\n" 1
keys "$PW\n" 1
wait_for 'UNLOCKED' 15 || finish "FAIL · låseskjermen slapp ikke etter riktig passord"

# The shell's own log on the serial console, for debugging
keys "sudo sh -c 'tail -n 40 /home/zeus/.local/state/olymparch/shell.log | while IFS= read -r l; do echo \"<2>QS: \$l\" > /dev/kmsg; done; echo \"<2>LOG-DONE\" > /dev/kmsg'\n" 1
keys "$PW\n" 1
wait_for 'LOG-DONE' 20
grep -aoE 'QS: .*' "$O/$LOG" | sed 's/\x1b\[[0-9;]*m//g' >"$O/shell-log.txt"
# only what happened after the shell's last start counts
errors=$(awk '/Launching config/ {n = 0} /ERROR|TypeError|ReferenceError/ {n++} END {print n + 0}' "$O/shell-log.txt")
mic_ok=$(( ${red_mic:-0} > ${red_before:-0} + 20 ))
finish "$([ "$errors" = 0 ] && [ $mic_ok = 1 ] && echo PASS || echo FAIL) · skallet: meny, varsler, volum og mikrofon i linjen (røde piksler ${red_before:-?} → ${red_mic:-?}; $errors feil i skall-loggen) på $((SECONDS - t0)) s"
