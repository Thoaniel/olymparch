#!/bin/bash
# VM test 1: the ISO boots under UEFI in QEMU/KVM and reaches a login prompt on the serial console.
# Writes serial.log and screenshots to tests/vm/out/boot-live/. Exit 0 = pass.
#   tests/vm/boot-live [ISO]      default: the newest out/*.iso
set -uo pipefail
cd "$(dirname "$0")/../.."
. dev/env
ISO=${1:-$(ls -t out/*.iso 2>/dev/null | head -n 1)}
[ -f "$ISO" ] || { echo "fant ingen ISO" >&2; exit 2; }
O=tests/vm/out/boot-live
rm -rf -- tests/vm/out/boot-live
mkdir -p "$O"
cp "$OLYMPARCH_OVMF_VARS" "$O/vars.fd"
QMP=$O/qmp.sock
TIMEOUT=${TIMEOUT:-180}

qemu-system-x86_64 -L "$OLYMPARCH_QEMU_DATA" -machine q35,accel=kvm -cpu host -smp 4 -m 4096 \
    -drive if=pflash,format=raw,readonly=on,file="$OLYMPARCH_OVMF_CODE" \
    -drive if=pflash,format=raw,file="$O/vars.fd" \
    -cdrom "$ISO" -boot d -vga std -display none \
    -serial file:"$O/serial.log" -qmp unix:"$QMP",server=on,wait=off -no-reboot &
QPID=$!
trap 'kill "$QPID" 2>/dev/null' EXIT
n=0
shot() {  # shot STEP: numbered screenshot of what the VM shows right now, listed in steps.txt for the report
    n=$((n + 1))
    local f; f=$(printf '%02d-%s.png' "$n" "$1")
    python3 -I tests/vm/qmp.py "$QMP" screendump "$PWD/$O/$f" 2>/dev/null && printf '%s\t%s\n' "$f" "$2" >>"$O/steps.txt"
}
seen() { grep -qaE "$1" "$O/serial.log"; }

result=FAIL
sleep 4; shot bootmeny "UEFI-oppstartsmenyen (systemd-boot) med Olymparch installer"
k=0 u=0
for ((i = 0; i < TIMEOUT; i++)); do
    sleep 1
    kill -0 "$QPID" 2>/dev/null || { echo "QEMU stoppet" >&2; break; }
    if ((k == 0)) && seen 'Linux version'; then k=1; shot kjerne "Kjernen har startet"; fi
    if ((u == 0)) && seen 'Reached target|Started '; then u=1; shot systemd "systemd starter tjenestene"; fi
    if seen 'login:'; then result=PASS; break; fi
done
sleep 3
shot innlogging "Live-miljøet er oppe ($result)"
python3 -I tests/vm/qmp.py "$QMP" quit 2>/dev/null
echo "boot-live: $result etter ${i}s ($(basename "$ISO"))"
echo "$result · ${i} s · $(basename "$ISO")" >"$O/result.txt"
grep -aE 'Olymparch|Welcome|login:' "$O/serial.log" | tail -n 3
[ "$result" = PASS ]
