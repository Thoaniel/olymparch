#!/bin/sh
# A stand-in for ~/.local/bin/olympus in tests/vm/settings: answers only the calls Settings makes, logs every call
# to ~/olympus.log, and never downloads or runs a model.
echo "$*" >>"$HOME/olympus.log"
case "${LANG:-}" in en*) en=1 ;; *) en=0 ;; esac   # the chat in English when the shell runs in English
case "$1" in
    --version) echo "olympus 0.0 (test stub)" ;;
    modell)
        if [ -z "${2:-}" ]; then
            cur=$(cat "$HOME/.olympus-stub-model" 2>/dev/null || echo gemma4-26b-a4b)
            for m in gemma4-26b-a4b qwen35-9b groq/openai/gpt-oss-120b; do
                case $m in */*) c='☁ ' ;; *) c='  ' ;; esac
                [ "$m" = "$cur" ] && mark='●' || mark='○'
                printf '%s %s%-34s %s\n' "$mark" "$c" "$m" "test"
            done
            printf '\nBytt med `olympus modell <id>`.\n'
        else
            echo "$2" >"$HOME/.olympus-stub-model"
            echo "Zeus svarer nå med $2."
        fi ;;
    config) [ "$2" = get ] && echo gemma4-26b-a4b ;;
    auth) echo "${3:-anthropic}: ingen nøkkel" ;;
    zeus | status) echo "Zeus (test stub): $1"; sleep 60 ;;
    bar)   # `olympus bar` (the shell's Zeus item and panel): JSON lines, the scenario from ~/.olympus-stub-bar
        sc=${OLYMPUS_STUB_BAR:-$(cat "$HOME/.olympus-stub-bar" 2>/dev/null || echo idle)}   # idle | chat | approval | off
        state=idle ai=true approvals='[]'
        case $sc in
            approval | timeout) state=approval
                approvals='[{"id":"a1","tool":"shell","reason":"kjører en kommando","danger":false,"preview":"$ df -h /home\n(viser ledig plass på hjemmedisken)"}]' ;;
            off) state=off ai=false ;;
        esac
        bar() { printf '{"type":"bar","connected":true,"ai":%s,"model":"gemma4-26b-a4b","provider":"lokal","cloud":false,"answering":"gemma4-26b-a4b","state":"%s","approvals":%s,"plan":null,"media":null,"downloads":null,"phones":null,"last_error":null}\n' "$ai" "$1" "$2"; }
        printf '{"type":"bridge","status":"connected","detail":"stub"}\n'
        bar "$state" "$approvals"
        if [ "$sc" != idle ] && [ "$sc" != off ]; then
            if [ "$en" = 1 ]; then
                printf '%s\n' '{"type":"history","session":"s1","items":[{"kind":"user","text":"How much space do I have left?"},{"kind":"agent","text":"I am checking your home disk.","model":"gemma4-26b-a4b","tools":["df"]}]}'
            else
                printf '%s\n' '{"type":"history","session":"s1","items":[{"kind":"user","text":"Hvor mye plass har jeg igjen?"},{"kind":"agent","text":"Jeg sjekker hjemmedisken for deg.","model":"gemma4-26b-a4b","tools":["df"]}]}'
            fi
        fi
        if [ "$sc" = chat ] && [ "$en" = 1 ]; then
            printf '%s\n' '{"type":"user","text":"And what takes the most space?"}' '{"type":"agent_start","model":"gemma4-26b-a4b"}' \
                '{"type":"tool","id":"t1","name":"du","detail":"~ (depth 1)"}' '{"type":"tool_result","id":"t1","ok":true,"summary":"7 folders"}' \
                '{"type":"chunk","text":"Most of it is **~/Games** (212 GB) and **~/.olympus/models** (14 GB). Shall I look closer at the games?"}' '{"type":"agent_end"}'
        elif [ "$sc" = chat ]; then
            printf '%s\n' '{"type":"user","text":"Og hva er det som tar mest plass?"}' '{"type":"agent_start","model":"gemma4-26b-a4b"}' \
                '{"type":"tool","id":"t1","name":"du","detail":"~ (dybde 1)"}' '{"type":"tool_result","id":"t1","ok":true,"summary":"7 mapper"}' \
                '{"type":"chunk","text":"Mest plass tar **~/Spill** (212 GB) og **~/.olympus/models** (14 GB). Vil du at jeg skal se nærmere på spillene?"}' '{"type":"agent_end"}'
        fi
        # fallback: Groq answers, hits its free quota (429), and Gemini takes over (what the bar then shows)
        if [ "$sc" = fallback ]; then
            printf '%s\n' '{"type":"user","text":"Hva er været?"}' '{"type":"agent_start","model":"groq/openai/gpt-oss-120b"}'
            printf '{"type":"bar","connected":true,"ai":true,"model":"groq/openai/gpt-oss-120b","provider":"Groq","cloud":true,"answering":"groq/openai/gpt-oss-120b","state":"thinking","approvals":[],"plan":null,"media":null,"downloads":null,"phones":null,"last_error":null}\n'
            sleep 2
            printf '%s\n' '{"type":"notice","text":"Groq: gratiskvoten er brukt opp eller du sender for fort (429). Bytter til skymodell gemini/gemini-flash-latest og fortsetter."}' \
                '{"type":"agent_start","model":"gemini/gemini-flash-latest"}' '{"type":"chunk","text":"Det blir sol i Oslo i morgen."}' '{"type":"agent_end"}'
            printf '{"type":"bar","connected":true,"ai":true,"model":"groq/openai/gpt-oss-120b","provider":"Groq","cloud":true,"answering":"gemini/gemini-flash-latest","state":"idle","approvals":[],"plan":null,"media":null,"downloads":null,"phones":null,"last_error":{"text":"Groq: gratiskvoten er brukt opp (429)","at":%s}}\n' "$(date +%s)"
        fi
        # timeout: nobody answers the card; Zeus gives up on it (the server's own timeout, shortened here)
        if [ "$sc" = timeout ]; then
            ( sleep 12; bar idle '[]'; printf '{"type":"approval_done","id":"a1"}\n' ) &
        fi
        while IFS= read -r line; do
            echo "$line" >>"$HOME/olympus-bar.log"
            rid=$(printf '%s' "$line" | sed -n 's/.*"rid": *\([0-9]*\).*/\1/p')
            case $line in
                */api/v1/models*) printf '{"type":"http","rid":%s,"status":200,"json":{"current":"gemma4-26b-a4b","cloud":false,"choices":[{"id":"gemma4-26b-a4b","label":"gemma4-26b-a4b · lokal","cloud":false,"provider":"lokal","cost":"gratis","size":"14.2 GB"},{"id":"groq/openai/gpt-oss-120b","label":"Groq: openai/gpt-oss-120b","cloud":true,"provider":"Groq","cost":"gratisnivå"},{"id":"claude-code/sonnet","label":"Claude Code: sonnet","cloud":true,"provider":"Claude Code","cost":"betalt · abonnement"}],"fallback":[{"id":"groq/openai/gpt-oss-120b","label":"Groq","cloud":true,"available":true,"why":""},{"id":"gemini/gemini-flash-latest","label":"Google Gemini","cloud":true,"available":true,"why":""},{"id":"gemma4-26b-a4b","label":"lokal","cloud":false,"available":true,"why":""}]},"error":null}\n' "${rid:-0}" ;;
                *'"cmd":"approve"'* | *'"cmd":"deny"'* | *'"cmd":"always"'*) bar idle '[]'; printf '{"type":"approval_done","id":"a1"}\n' ;;
                *'"cmd":'*) printf '{"type":"cmd","rid":%s,"ok":true,"result":null,"error":null}\n' "${rid:-null}" ;;
                *'"type":"http"'*) printf '{"type":"http","rid":%s,"status":200,"json":{},"error":null}\n' "${rid:-0}" ;;
            esac
        done ;;
esac
exit 0
