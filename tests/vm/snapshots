#!/bin/bash
# VM test 4: snapshots and rollback, on a copy of the disk from install-disk.
#   1. install a small package: the pacman hooks take a snapshot and add it to the boot menu
#   2. boot that snapshot from the Limine menu (read-only, overlay in RAM)
#   3. olymparch rollback to it, reboot normally: the package is gone again
set -uo pipefail
cd "$(dirname "$0")/../.."
. dev/env
SRC=${OLYMPARCH_BASE:-tests/vm/out/install-disk}   # a read-only installed disk to test on (overlay)
[ -f "$SRC/disk.qcow2" ] || { echo "kjør tests/vm/install-disk først" >&2; exit 2; }
O=tests/vm/out/snapshots
rm -rf -- tests/vm/out/snapshots
mkdir -p "$O"
install -m644 "$SRC/vars.fd" "$O/vars.fd"   # a writable copy (the base is read-only)
qemu-img create -q -f qcow2 -b "$(realpath "$SRC/disk.qcow2")" -F qcow2 "$O/disk.qcow2"
QMP=$O/qmp.sock
. tests/vm/lib.sh
PW='olymp-test-123'
term() {  # run a command line in a new terminal on the desktop
    press meta_l+ret
    sleep 2
    keys "$1\n" 1
}
trap 'kill "$QPID" 2>/dev/null' EXIT
t0=$SECONDS

# --- 1. install a package: snapshot + boot menu entry
vm boot1.log
unlock_and_desktop "$PW"
shot skrivebord "Skrivebordet på den installerte disken"
term "sudo pacman -S --noconfirm sl && sudo snapper --no-dbus -c root list && grep -c '^//' /boot/limine.conf | sed 's/^/<2>SNAPENTRIES=/' | sudo tee /dev/kmsg"
sleep 1
keys "$PW\n" 1
wait_for 'SNAPENTRIES=' 240 || { shot pakke-feil "Pakken ble ikke installert"; finish "FAIL · pacman/snapper stoppet"; }
sleep 1
shot snapper "pacman installerte «sl»; snapper tok et bilde før (snapper list)"
entries=$(grep -aoE 'SNAPENTRIES=[0-9]+' "$O/$LOG" | tail -n 1 | cut -d= -f2)
((entries >= 2)) || finish "FAIL · oppstartsmenyen har bare $entries bilder"
keys "sudo systemctl reboot\n"
stop_after=$SECONDS; for ((i = 0; i < 60; i++)); do kill -0 "$QPID" 2>/dev/null || break; sleep 1; done
stop_vm

# --- 2. boot the newest snapshot from the Limine menu
vm boot2.log
for ((i = 0; i < 40; i++)); do seen 'BdsDxe: starting' && break; sleep 0.25; done
sleep 1
press down
shot meny "Limine-menyen: Olymparch og Snapshots"
press ret
sleep 0.5
shot meny-bilder "Øyeblikksbildene i menyen ($entries stykker, nyeste øverst)"
press down ret
unlock_and_desktop "$PW"
term "grep -oE 'subvol=@snapshots/[0-9]+' /proc/cmdline | sed 's/^/<2>BOOTED=/' | sudo tee /dev/kmsg; command -v sl || echo '<2>SL=ABSENT' | sudo tee /dev/kmsg"
keys "$PW\n" 1
wait_for 'BOOTED=' 60 || { shot bilde-feil "Startet ikke fra et øyeblikksbilde"; finish "FAIL · startet ikke fra øyeblikksbildet"; }
sleep 1
shot fra-bilde "Startet fra øyeblikksbildet (skrivebeskyttet, før «sl» ble installert)"
snap=$(grep -aoE 'BOOTED=subvol=@snapshots/[0-9]+' "$O/$LOG" | tail -n 1 | grep -oE '[0-9]+$')
seen 'SL=ABSENT' || finish "FAIL · «sl» finnes i bildet som skulle være fra før installasjonen"

# --- 3. roll back to that snapshot and boot normally
keys "sudo olymparch rollback $snap && sudo systemctl reboot\n" 1
sleep 8
shot rollback "olymparch rollback $snap"
for ((i = 0; i < 60; i++)); do kill -0 "$QPID" 2>/dev/null || break; sleep 1; done
stop_vm
vm boot3.log
unlock_and_desktop "$PW"
term "findmnt -no OPTIONS / | grep -o 'subvol=/@[^,]*' | sed 's/^/<2>ROOT=/' | sudo tee /dev/kmsg; command -v sl || echo '<2>SL=GONE' | sudo tee /dev/kmsg"
keys "$PW\n" 1
wait_for 'ROOT=' 60
sleep 1
shot etter-rollback "Etter tilbakerulling: vanlig oppstart, og «sl» er borte"
seen 'ROOT=subvol=/@$' || seen 'ROOT=subvol=/@[^.]' || true
seen 'SL=GONE' || finish "FAIL · «sl» finnes fortsatt etter tilbakerulling"
finish "PASS · bilde tatt, startet fra bildet og rullet tilbake på $((SECONDS - t0)) s"
