#!/bin/bash
# VM test: Ctrl+C on the desktop and in a terminal must never end the session (Hyprland must not get the tty's SIGINT).
set -uo pipefail
cd "$(dirname "$0")/../.."
. dev/env
SRC=${OLYMPARCH_BASE:-tests/vm/out/install-disk}
[ -f "$SRC/disk.qcow2" ] || { echo "kjør tests/vm/install-disk først" >&2; exit 2; }
O=tests/vm/out/ctrl-c
rm -rf -- tests/vm/out/ctrl-c
mkdir -p "$O"
install -m644 "$SRC/vars.fd" "$O/vars.fd"   # a writable copy (the base is read-only)
qemu-img create -q -f qcow2 -b "$(realpath "$SRC/disk.qcow2")" -F qcow2 "$O/disk.qcow2"
QMP=$O/qmp.sock
. tests/vm/lib.sh
trap 'kill "$QPID" 2>/dev/null' EXIT
t0=$SECONDS
vm boot.log
unlock_and_desktop 'olymp-test-123'
shot skrivebord "Skrivebordet før Ctrl+C"
press ctrl+c; sleep 1; press ctrl+c; sleep 3
shot etter-skrivebord "Ctrl+C to ganger på skrivebordet: økten skal leve"
g1=$(gold_now)
press meta_l+ret; sleep 2
keys "sleep 100\n" 1
press ctrl+c; sleep 3
shot etter-terminal "Ctrl+C i terminalen stopper bare «sleep»"
g2=$(gold_now)
(( g1 > 90 && g2 > 90 )) && finish "PASS · økten lever etter Ctrl+C (gull $g1 / $g2) på $((SECONDS - t0)) s" ||
    finish "FAIL · økten døde etter Ctrl+C (gull $g1 / $g2)"
