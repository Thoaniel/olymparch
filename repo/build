#!/bin/bash
# Olymparch's pacman repo [olymparch], in two steps that never share a machine in CI:
#
#   repo/build build OUTDIR      build every package in repo/packages.tsv (as root in a throwaway Arch container;
#                                the PKGBUILDs run as an unprivileged user with no sudo, and no secrets exist here)
#   repo/build sign OUTDIR KEY   sign the packages and make the signed database (no PKGBUILD code runs here)
set -euo pipefail
cd "$(dirname "$0")/.."
mode=${1:-} out=$(realpath -m "${2:?usage: repo/build build|sign OUTDIR [KEY]}")

srcinfo_deps() {  # depends + makedepends of a .SRCINFO, without version limits
    sed -nE 's/^\s*(make)?depends(_x86_64)? = ([^<>=]+).*/\3/p' "$1"
}

case $mode in
build)
    [ "$(id -u)" = 0 ] || { echo "repo/build build runs as root in a throwaway container" >&2; exit 2; }
    mkdir -p "$out"
    id builder >/dev/null 2>&1 || useradd -m builder
    work=$(mktemp -d)
    chown builder: "$work"
    mapfile -t ours < <(awk '!/^#/ && NF {print $1}' repo/packages.tsv)
    while read -r name commit; do
        [[ -z $name || $name == \#* ]] && continue
        [[ $name =~ ^[a-z0-9][a-z0-9._+-]*$ && $commit =~ ^[0-9a-f]{40}$ ]] || { echo "bad line: $name $commit" >&2; exit 1; }
        echo "==> $name @ ${commit:0:12}"
        d=$work/$name
        sudo -u builder git clone -q "https://aur.archlinux.org/$name.git" "$d"
        sudo -u builder git -C "$d" -c advice.detachedHead=false checkout -q "$commit"
        # dependencies from the Arch repos are installed here, as root, before any PKGBUILD code runs;
        # our own packages are only runtime dependencies of each other
        deps=()
        while read -r dep; do
            [[ " ${ours[*]} " == *" $dep "* ]] || deps+=("$dep")
        done < <(srcinfo_deps "$d/.SRCINFO")
        [ ${#deps[@]} -eq 0 ] || pacman -S --noconfirm --needed --asdeps "${deps[@]}" >/dev/null
        # packages land next to the PKGBUILD (a PKGDEST was refused inside makepkg's fakeroot step, in CI too)
        (cd "$d" && sudo -u builder makepkg --nodeps --noconfirm --clean --nocheck >/dev/null)
        cp "$d"/*.pkg.tar.zst "$out/"
    done <repo/packages.tsv
    rm -rf -- "$work"
    ;;
sign)
    key=${3:?usage: repo/build sign OUTDIR KEY}
    cd "$out"
    rm -f -- olymparch.* ./*.sig
    for f in ./*.pkg.tar.zst; do gpg --batch --yes --detach-sign --local-user "$key" "$f"; done
    repo-add -q --sign --key "$key" olymparch.db.tar.zst ./*.pkg.tar.zst
    # GitHub release assets cannot be symlinks: the plain names pacman asks for are copies
    for f in olymparch.db olymparch.files; do
        cp -f --remove-destination "$f.tar.zst" "$f"
        cp -f --remove-destination "$f.tar.zst.sig" "$f.sig"
    done
    ;;
*) echo "usage: repo/build build|sign OUTDIR [KEY]" >&2; exit 2 ;;
esac
ls -l "$out"
