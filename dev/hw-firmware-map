#!/bin/bash
# Build default/hw/firmware.map: firmware path prefix → split linux-firmware-* package.
# Uses the file lists of the split packages installed on this machine (pacman -Ql). Run after a firmware update.
# The map uses the shortest prefix that belongs to only one package.
set -euo pipefail
cd "$(dirname "$0")/.."
pkgs=$(pacman -Qq | grep -E '^linux-firmware-' | grep -vx linux-firmware-whence)
[ -n "$pkgs" ] || { echo "no linux-firmware-* packages installed" >&2; exit 1; }
# shellcheck disable=SC2086
pacman -Ql $pkgs | awk '$2 !~ /\/$/ { sub("^/usr/lib/firmware/", "", $2); if ($2 !~ /^\//) print $1, $2 }' |
    sed -E 's/\.(zst|xz)$//' | sort -u | python3 -I -c '
import sys
files = [l.split(None, 1) for l in sys.stdin.read().splitlines()]
out = {}
def walk(items, depth):
    groups = {}
    for pkg, path in items:
        parts = path.split("/")
        key = "/".join(parts[:depth + 1])
        groups.setdefault(key, []).append((pkg, path))
    for key, grp in sorted(groups.items()):
        owners = {p for p, _ in grp}
        if len(owners) == 1 or all(len(p.split("/")) <= depth + 1 for _, p in grp):
            out[key] = sorted(owners)[0]
        else:
            walk(grp, depth + 1)
walk(files, 0)
print("# firmware path prefix → package. Generated by dev/hw-firmware-map; do not edit by hand.")
# files the kernel asks for that live outside linux-firmware-* (longest prefix wins over "intel")
out.update({"regulatory.db": "wireless-regdb", "regulatory.db.p7s": "wireless-regdb"})
for d in ("sof", "sof-tplg", "sof-ipc4", "sof-ipc4-tplg", "sof-ipc4-lib", "sof-ace-tplg"):
    out["intel/" + d] = "sof-firmware"
for k, v in sorted(out.items()):
    print(k, v)
' >default/hw/firmware.map
wc -l default/hw/firmware.map
