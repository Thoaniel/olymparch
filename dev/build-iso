#!/bin/bash
# Build the Olymparch ISO as a normal user. mkarchiso runs pacstrap -N and its other steps in a user
# namespace when it is not root (needs entries for you in /etc/subuid and /etc/subgid).
set -euo pipefail
cd "$(dirname "$0")/.."
. dev/env
mkdir -p cache out
rm -rf -- work profile
# Build from a staged copy of the profile, so the olymparch-* commands come from bin/ without being copied into git
cp -r iso profile
# Packages downloaded for earlier builds are reused (the second cache is this checkout's, so it works for anyone)
sed -i "s|^CacheDir = /var/cache/pacman/pkg/$|&\\nCacheDir = $PWD/cache/|" profile/pacman.conf
# Python with Pillow for the art generators: uv on a dev machine, the system's python-pillow in CI
py() { if command -v uv >/dev/null; then uv run -q --no-project --with pillow python "$@"; else python "$@"; fi; }
install -Dm755 -t profile/airootfs/usr/local/bin bin/olymparch-*
# Olymparch defaults (Hyprland config, shell, wallpaper) for the installer to copy onto the new system
share=profile/airootfs/usr/share/olymparch
mkdir -p "$share"
cp -r default/hypr default/shell default/lock default/idle default/branding default/foot default/i18n default/systemd default/apps default/games system "$share/"
# Boot screen (Plymouth theme for every pixel size) and the Limine wallpapers, made by art/bootart.py
rm -rf -- build/plymouth
py art/bootart.py build/plymouth >/dev/null
mkdir -p "$share/plymouth" "$share/limine"
cp default/plymouth/olymparch.plymouth build/plymouth/olymparch.script build/plymouth/s*.png "$share/plymouth/"
cp -r default/plymouth/units default/plymouth/olymparch-mkinitcpio-install "$share/plymouth/"
cp build/plymouth/limine-s*.png "$share/limine/"
# The live environment calls itself Olymparch too
install -m644 default/branding/os-release profile/airootfs/etc/os-release
install -m644 default/branding/motd profile/airootfs/etc/motd
install -m644 default/branding/issue profile/airootfs/etc/issue
install -Dm755 default/launch-shell profile/airootfs/usr/lib/olymparch/launch-shell
printf 'file_permissions+=(["/usr/lib/olymparch/launch-shell"]="0:0:755")\n' >>profile/profiledef.sh
for size in 1920x1080 2560x1440; do
    w=${size%x*} h=${size#*x}
    if [ -s "build/wallpaper/$h/frame-47.png" ]; then :; else
        py art/torch.py "build/wallpaper/$h" "$w" "$h" 48 >/dev/null
    fi
    mkdir -p "$share/wallpaper/$h"
    cp build/wallpaper/"$h"/frame-*.png "$share/wallpaper/$h/"
done
# archiso gives every file mode 644 unless it is listed in file_permissions
for f in bin/olymparch-*; do
    printf 'file_permissions+=(["/usr/local/bin/%s"]="0:0:755")\n' "${f##*/}" >>profile/profiledef.sh
done
mkarchiso -v -r -w work -o out profile
rm -rf -- profile
ls -lh out/*.iso | tail -1
