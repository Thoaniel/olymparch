#!/bin/bash
# Build the Olymparch ISO as a normal user. mkarchiso runs pacstrap -N and its other steps in a user
# namespace when it is not root (needs entries for you in /etc/subuid and /etc/subgid).
set -euo pipefail
cd "$(dirname "$0")/.."
. dev/env
mkdir -p cache out
# A stopped build leaves read-only folders (dr-xr-xr-x) and files owned by sub-UIDs from the build's user
# namespace (nfs-utils' statd): removed from inside such a namespace, where they are ours.
if [ -d work ]; then
    unshare --map-auto --map-root-user -- sh -c 'chmod -R u+w work 2>/dev/null; rm -rf work' 2>/dev/null ||
        { chmod -R u+w -- work 2>/dev/null; rm -rf -- work; }
fi
rm -rf -- profile
# Build from a staged copy of the profile, so the olymparch-* commands come from bin/ without being copied into git
cp -r iso profile
# Packages downloaded for earlier builds are reused (the second cache is this checkout's, so it works for anyone)
sed -i "s|^CacheDir = /var/cache/pacman/pkg/$|&\\nCacheDir = $PWD/cache/|" profile/pacman.conf
# Python with Pillow for the art generators: uv on a dev machine, the system's python-pillow in CI
py() { if command -v uv >/dev/null; then uv run -q --no-project --with pillow python "$@"; else python "$@"; fi; }
install -Dm755 -t profile/airootfs/usr/local/bin bin/olymparch-*
# Olymparch defaults (Hyprland config, shell, wallpaper) for the installer to copy onto the new system
share=profile/airootfs/usr/share/olymparch
mkdir -p "$share"
cp -r default/hypr default/shell default/lock default/idle default/branding default/foot default/i18n default/systemd default/apps default/audio default/games default/hw default/settings system "$share/"
cp -r default/menu default/webapps default/nvim default/shell-tools "$share/"   # app catalog, web apps, Neovim and shell-tool defaults
cp -r default/skills "$share/"   # AI agents: the Agent Skills olymparch-mcp register links into ~/.claude/skills and the others
# Boot screen (Plymouth theme for every pixel size) and the Limine wallpapers, made by art/bootart.py
rm -rf -- build/plymouth
py art/bootart.py build/plymouth >/dev/null
mkdir -p "$share/plymouth" "$share/limine"
cp default/plymouth/olymparch.plymouth build/plymouth/olymparch.script build/plymouth/s*.png "$share/plymouth/"
cp -r default/plymouth/units default/plymouth/olymparch-mkinitcpio-install default/plymouth/olymparch-plymouth-handoff "$share/plymouth/"
cp build/plymouth/limine-s*.png "$share/limine/"
# The live environment calls itself Olymparch too
install -m644 default/branding/os-release profile/airootfs/etc/os-release
install -m644 default/branding/motd profile/airootfs/etc/motd
install -m644 default/branding/issue profile/airootfs/etc/issue
install -Dm755 default/launch-shell profile/airootfs/usr/lib/olymparch/launch-shell
printf 'file_permissions+=(["/usr/lib/olymparch/launch-shell"]="0:0:755")\n' >>profile/profiledef.sh
for size in 1920x1080 2560x1440; do
    w=${size%x*} h=${size#*x}
    if [ -s "build/wallpaper/$h/frame-47.png" ]; then :; else
        py art/torch.py "build/wallpaper/$h" "$w" "$h" 48 >/dev/null
    fi
    mkdir -p "$share/wallpaper/$h"
    cp build/wallpaper/"$h"/frame-*.png "$share/wallpaper/$h/"
done
# ── Themes (docs/themes.md): every built-in theme, and its own recoloured torch frames (Zeus uses the ones above).
# Made once per palette and kept in build/wallpaper/themes/<id>/<h>; a changed theme.json makes them again.
mkdir -p "$share/themes"
cp -r default/themes/. "$share/themes/"
for t in default/themes/*/theme.json; do
    id=$(basename "$(dirname "$t")")
    [ "$id" = zeus ] && continue
    for size in 1920x1080 2560x1440; do
        w=${size%x*} h=${size#*x}
        cache=build/wallpaper/themes/$id/$h
        if [ -s "$cache/frame-47.png" ] && [ "$cache/frame-47.png" -nt "$t" ] && [ "$cache/frame-47.png" -nt art/torch.py ]; then :; else
            py art/torch.py "$cache" "$w" "$h" 48 "$t" >/dev/null
        fi
        mkdir -p "$share/themes/$id/wallpaper/$h"
        cp "$cache"/frame-*.png "$share/themes/$id/wallpaper/$h/"
    done
done
# Every god's illustration (art/illustrations/<id>.svg, the second background in its theme.json): one still frame per
# size, drawn by rsvg-convert, in themes/<id>/backgrounds/<bg>/<h>/frame-00.png. Kept in build/illustrations/<id>/<h>
# until the SVG changes. All 14 together stay under 80 MB on the ISO (docs/themes.md).
command -v rsvg-convert >/dev/null || { echo "dev/build-iso: rsvg-convert mangler (pacman -S librsvg)" >&2; exit 1; }
jobs=()
for svg in art/illustrations/*.svg; do
    id=$(basename "$svg" .svg)
    for size in 1920x1080 2560x1440; do
        w=${size%x*} h=${size#*x}
        cache=build/illustrations/$id/$h
        if [ -s "$cache/frame-00.png" ] && [ "$cache/frame-00.png" -nt "$svg" ] && [ "$cache/frame-00.png" -nt art/illustrations/render.py ]; then :; else
            jobs+=("$svg $cache $w $h")
        fi
    done
done
if [ ${#jobs[@]} -gt 0 ]; then
    printf '%s\n' "${jobs[@]}" | xargs -P "$(nproc)" -L1 sh -c 'if command -v uv >/dev/null; then uv run -q --no-project --with pillow python art/illustrations/render.py "$@"; else python art/illustrations/render.py "$@"; fi >/dev/null' render
fi
for svg in art/illustrations/*.svg; do
    id=$(basename "$svg" .svg)
    bg=$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1]))["backgrounds"][0]["id"])' "default/themes/$id/theme.json")
    for h in 1080 1440; do
        mkdir -p "$share/themes/$id/backgrounds/$bg/$h"
        cp "build/illustrations/$id/$h/frame-00.png" "$share/themes/$id/backgrounds/$bg/$h/"
    done
done
du -ch "$share"/themes/*/backgrounds | tail -1
du -sh "$share/themes" "$share/wallpaper"
# (Plymouth and the Limine menu stay gold for every theme: they run before anyone has logged in.)
# ── end Themes
# the public half of the repo signing key, for the installer
install -Dm644 repo/olymparch-signing.asc "$share/repo/olymparch-signing.asc"
# no Python byte-code from local test runs on the ISO
find "$share" -name __pycache__ -type d -prune -exec rm -rf -- {} +
# archiso gives every file mode 644 unless it is listed in file_permissions
for f in bin/olymparch-*; do
    printf 'file_permissions+=(["/usr/local/bin/%s"]="0:0:755")\n' "${f##*/}" >>profile/profiledef.sh
done
# the system commands the installer runs from the ISO itself (olymparch-hw), and their helpers
for f in system/bin/* system/lib/*; do
    printf 'file_permissions+=(["/usr/share/olymparch/%s"]="0:0:755")\n' "$f" >>profile/profiledef.sh
done
# Personal additions (OLYMPARCH_PERSONAL=DIR, never for releases): DIR is a tree laid over the new system's / (for
# example DIR/usr/local/bin/hent-alt). It rides along in /usr/share/olymparch/personal, the installer copies it in,
# and the ISO is named olymparch-personal-*, so it is never mistaken for the public one.
if [ -n "${OLYMPARCH_PERSONAL:-}" ]; then
    [ -d "$OLYMPARCH_PERSONAL" ] || { echo "OLYMPARCH_PERSONAL=$OLYMPARCH_PERSONAL is not a folder" >&2; exit 2; }
    mkdir -p "$share/personal"
    # regular files only (no links, devices or special bits)
    (cd "$OLYMPARCH_PERSONAL" && find . -type f -print0) | while IFS= read -r -d '' f; do
        if [ -x "$OLYMPARCH_PERSONAL/$f" ]; then m=755; else m=644; fi
        install -D -m "$m" -- "$OLYMPARCH_PERSONAL/$f" "$share/personal/${f#./}"
    done
    (cd "$OLYMPARCH_PERSONAL" && find . -type f -perm -u+x) | while IFS= read -r f; do
        printf 'file_permissions+=(["/usr/share/olymparch/personal/%s"]="0:0:755")\n' "${f#./}" >>profile/profiledef.sh
    done
    sed -i 's/^iso_name=.*/iso_name="olymparch-personal"/' profile/profiledef.sh
fi
mkarchiso -v -r -w work -o out profile
rm -rf -- profile
ls -lh out/*.iso | tail -1
