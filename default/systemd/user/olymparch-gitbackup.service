[Unit]
Description=Olymparch: backup to your GitHub repository, when it is on and due (Settings → Backup)
After=network-online.target

[Service]
Type=oneshot
# not while a game runs (game mode); the timer tries again next time
ExecCondition=/bin/sh -c '! test -e "%t/olymparch/gaming"'
ExecStart=/usr/bin/olymparch-gitbackup run --if-due
Nice=10
IOSchedulingClass=idle
