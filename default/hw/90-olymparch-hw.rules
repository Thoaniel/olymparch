# Hotplug: a device that a hardware rule knows starts olymparch-hw-notify@RULE in the user's session.
# Generated by olymparch-hw udev-rules; do not edit. Slow work never runs here (no RUN+=).
ACTION!="add", GOTO="olymparch_hw_end"
ENV{MODALIAS}=="", GOTO="olymparch_hw_end"
ENV{MODALIAS}=="usb:v*p*d*dcE0dsc01dp01*", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="olymparch-hw-notify@bluetooth.service"
