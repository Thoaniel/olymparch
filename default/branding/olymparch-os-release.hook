# The filesystem package owns /usr/lib/os-release and resets it to Arch on every update: put Olymparch back.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
Description = Olymparch: setting os-release
When = PostTransaction
Exec = /usr/bin/install -m644 /usr/share/olymparch/branding/os-release /usr/lib/os-release
