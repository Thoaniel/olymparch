// The switch in Settings is the consent: the active, local admin (wheel) user may run settings-apply without a
// password. settings-apply takes a fixed list of actions and values only (lid, connectivity, DNS, MAC, Bluetooth mode, snapshots).
polkit.addRule(function (action, subject) {
    if (action.id == "org.olymparch.settings-apply" && subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
