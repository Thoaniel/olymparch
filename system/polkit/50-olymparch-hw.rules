// The Install button is the consent: the active, local admin (wheel) user may run hw-apply without a
// password. hw-apply takes rule IDs only and installs just what a rule matching this machine asks for.
polkit.addRule(function (action, subject) {
    if (action.id == "org.olymparch.hw-apply" && subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
