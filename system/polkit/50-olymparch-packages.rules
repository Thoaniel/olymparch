// The menu's confirm step is the consent: the active, local admin (wheel) user may run the package helper without
// a password. /usr/lib/olymparch/packages only installs one official-repository package by name (never the AUR, a
// file or a URL) or removes one you installed yourself (never a system package). See the helper for its rules.
polkit.addRule(function (action, subject) {
    if (action.id == "org.olymparch.packages" && subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
