#!/bin/bash
# pkexec helper behind one-click app offers (the «Install Transmission» button): pkexec /usr/lib/olymparch/install-app APP
# Takes an app ID from the fixed list below, never a package name or a path, and installs only those packages
# from the configured repositories. Everything is logged to /var/log/olymparch-install-app.log.
set -euo pipefail
export PATH=/usr/bin LC_ALL=C
[ "$(id -u)" = 0 ] || { echo "install-app: run through pkexec" >&2; exit 1; }
[ $# = 1 ] || { echo "bruk: install-app APP" >&2; exit 2; }
case $1 in
    torrent) pkgs=(transmission-gtk) ;;
    backup) pkgs=(git openssh age) ;;   # Settings → Backup (olymparch-gitbackup)
    screen-reader) pkgs=(orca) ;;   # Settings → Accessibility → Install the screen reader
    # Settings rows that need a program Olymparch doesn't install (official Arch repositories only)
    nightlight) pkgs=(hyprsunset) ;;   # display.night_light
    tailscale) pkgs=(tailscale) ;;     # network.tailscale
    # ── the app catalog (default/menu/catalog.json: every «install» there is one of these) and web apps ──
    webapps) pkgs=(chromium) ;;        # olymparch-webapp: web apps and cloud gaming run in Chromium
    lutris) pkgs=(lutris) ;;
    moonlight) pkgs=(moonlight-qt) ;;
    minecraft) pkgs=(prismlauncher) ;;
    neovim) pkgs=(neovim) ;;
    helix) pkgs=(helix) ;;
    zed) pkgs=(zed) ;;
    shell-tools) pkgs=(fzf zoxide ripgrep starship) ;;
    btop) pkgs=(btop) ;;
    lazygit) pkgs=(lazygit) ;;
    lazydocker) pkgs=(lazydocker) ;;
    obsidian) pkgs=(obsidian) ;;
    alacritty) pkgs=(alacritty) ;;
    kitty) pkgs=(kitty) ;;
    ghostty) pkgs=(ghostty) ;;
    discord) pkgs=(discord) ;;
    spotify) pkgs=(spotify-launcher) ;;
    obs) pkgs=(obs-studio) ;;
    code) pkgs=(code) ;;
    # AUR packages only from Olymparch's own signed repo [olymparch] (repo/packages.tsv), never from the AUR here
    localsend) pkgs=(localsend-bin) ;;
    # ── end of the catalog ──
    *) echo "install-app: ukjent app" >&2; exit 2 ;;
esac
case $1 in
    localsend) grep -qx '\[olymparch\]' /etc/pacman.conf || { echo "install-app: $1 trenger pakkebrønnen [olymparch]" >&2; exit 3; } ;;
esac
exec </dev/null 9>/run/olymparch-install-app.lock
flock 9
{
    printf '\n== %s install-app %s (uid %s)\n' "$(date '+%F %T')" "$1" "${PKEXEC_UID:-?}"
    for _ in $(seq 60); do [ -e /var/lib/pacman/db.lck ] || break; sleep 2; done   # another install is running
    pacman -S --noconfirm --needed -- "${pkgs[@]}"
    # Neovim gets Olymparch's small default config (your own ~/.config/nvim wins)
    if [ "$1" = neovim ] && [ ! -e /etc/xdg/nvim/init.lua ] && [ -f /usr/share/olymparch/nvim/init.lua ]; then
        install -Dm644 /usr/share/olymparch/nvim/init.lua /etc/xdg/nvim/init.lua
    fi
} >>/var/log/olymparch-install-app.log 2>&1
