#!/bin/bash
# Virus check of new downloads (started by olymparch-downloads.path when ~/Downloads changes). Only file types
# that can do harm, at low priority. A notification when something is found, and also when the check itself
# fails, so a silent result always means "checked and clean".
set -uo pipefail
dir=$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")
state=${XDG_STATE_HOME:-$HOME/.local/state}/olymparch/downloads.seen
mkdir -p "${state%/*}"
[ -e "$state" ] || touch -d @0 "$state"
sleep 3   # let the browser finish renaming the file
# The new mark is taken before looking, and only replaces the old one after a successful check: nothing that
# arrives during the check, and nothing from a failed check, is ever marked as seen.
mark=$(mktemp "${state}.XXXXXX")
trap 'rm -f -- "$mark"' EXIT
mapfile -t new < <(find "$dir" -maxdepth 1 -type f -newer "$state" ! -name '.*' ! -name '*.part' ! -name '*.crdownload' \
    \( -iname '*.exe' -o -iname '*.msi' -o -iname '*.zip' -o -iname '*.7z' -o -iname '*.rar' -o -iname '*.tar*' \
       -o -iname '*.iso' -o -iname '*.appimage' -o -iname '*.sh' -o -iname '*.pdf' -o -iname '*.jar' -o -iname '*.bat' \
       -o -iname '*.ps1' -o -iname '*.deb' -o -iname '*.rpm' -o -perm -u+x \) 2>/dev/null)
[ ${#new[@]} -gt 0 ] || { mv -f -- "$mark" "$state"; exit 0; }

warn_unchecked() {
    notify-send -u critical -a Olymparch "Nedlastingen ble ikke virussjekket" \
        "$1 Filene er ikke sjekket: ${new[*]##*/}"
    exit 1
}
command -v clamscan >/dev/null || warn_unchecked "ClamAV er ikke installert."
out=$(nice -n 19 ionice -c 3 clamscan --no-summary --infected -- "${new[@]}" 2>&1)
code=$?
# clamscan: 0 = clean, 1 = something found, anything else = the check failed (no database, unreadable file …)
case $code in
    0) ;;
    1) while IFS= read -r f; do
           notify-send -u critical -a Olymparch "Virus funnet i en nedlasting" \
               "${f##*/} ser farlig ut. Ikke åpne den. Den ligger i ${f%/*}."
       done < <(sed -n 's/: .* FOUND$//p' <<<"$out") ;;
    *) warn_unchecked "Virussjekken feilet (kode $code)." ;;
esac
mv -f -- "$mark" "$state"
