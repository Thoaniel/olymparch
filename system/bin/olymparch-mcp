# ── packages: search; install = the one-click catalog helper; removal and updates in a terminal the user sees
PKG = r"[a-z0-9][a-z0-9@._+-]{0,63}"


def catalog():
    for p in ("/usr/share/olymparch/menu/catalog.json", os.path.join(HERE, "../../default/menu/catalog.json")):
        if os.path.isfile(p):
            with open(p, encoding="utf-8") as f:
                return json.load(f).get("apps", [])
    return []


@tool("packages_search", "read", "Search packages", "Søk etter pakker", "Search the Arch repositories (pacman -Ss).",
      {"query": S(64, PKG)}, ("query",), open_world=True)
def t_pkg_search(a, s):
    rc, out, err = run(["pacman", "-Ss", "--", a["query"]], timeout=60, limit=65536)
    if rc not in (0, 1):
        raise ToolError(err.strip())
    return text("\n".join(out.splitlines()[:300]) or L("nothing found", "fant ingenting"))


@tool("packages_catalog", "read", "Optional apps", "Valgfrie apper",
      "The apps Olymparch offers with one click (the menu's catalog): app id, name, installed or not.")
def t_pkg_catalog(a, s):
    lines = []
    for x in catalog():
        nf = (x.get("needs_file") or "").replace("~", HOME, 1)
        installed = (x.get("needs") and have(x["needs"])) or (nf and os.path.exists(nf))
        lines.append(f"{x.get('install') or '-'}\t{(x.get('name') or {}).get('nb' if NB else 'en', x.get('id'))}\t"
                     f"{'installed' if installed else 'not installed'}")
    return text("\n".join(lines))


@tool("package_install", "sensitive", "Install an app", "Installer en app",
      "Install one app from packages_catalog by its app id (the same as the menu's Install button: "
      "pkexec /usr/lib/olymparch/install-app ID, official repositories only). Never a package name.",
      {"app": S(40, r"[a-z0-9-]{1,40}")}, ("app",), open_world=True, idempotent=True)
def t_pkg_install(a, s):
    if a["app"] not in {x.get("install") for x in catalog() if x.get("install")}:
        raise ToolError(L("not an app id from packages_catalog", "ikke en app-id fra packages_catalog"))
    return ran(run(["pkexec", "/usr/lib/olymparch/install-app", a["app"]], timeout=1800))


