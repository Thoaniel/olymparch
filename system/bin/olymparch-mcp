# ── screen: screenshot, OCR, colour (olymparch-tool's programs)
def _grab(scale):
    time.sleep(0.6)   # the approval card is gone from the screen first
    rc, png, err = run(["grim", "-s", str(scale), "-t", "png", "-"], timeout=20, limit=16 << 20, binary=True)
    if rc != 0 or not png.startswith(b"\x89PNG"):
        raise ToolError(err.strip() or "grim failed")
    return png


@tool("screenshot", "sensitive", "Take a screenshot", "Ta et skjermbilde",
      "A picture of the whole screen (half size, PNG). Everything visible is included: the user approves each one.",
      {"scale": {"type": "number", "minimum": 0.25, "maximum": 1, "description": "default 0.5"}}, open_world=True)
def t_screenshot(a, s):
    png = _grab(a.get("scale", 0.5))
    if len(png) > 8 << 20:
        raise ToolError("the screenshot is larger than 8 MB; use a smaller scale")
    return {"content": [{"type": "image", "data": base64.b64encode(png).decode(), "mimeType": "image/png"}]}


@tool("ocr_screen", "sensitive", "Read text on the screen", "Les tekst på skjermen",
      "The text on the whole screen (tesseract, English + Norwegian).", open_world=True)
def t_ocr(a, s):
    png = _grab(1)
    rc, out, err = run(["tesseract", "stdin", "stdout", "-l", "eng+nor"], data=png, timeout=90, limit=65536)
    if rc != 0:
        raise ToolError(err.strip() or "tesseract failed")
    return text(out.strip())


@tool("colour_pick", "change", "Pick a colour", "Velg en farge",
      "The user clicks a point on the screen (hyprpicker); returns #rrggbb. Waits up to 60 s.")
def t_colour(a, s):
    rc, out, err = run(["hyprpicker", "-f", "hex"], timeout=60)
    m = re.search(r"#?([0-9a-fA-F]{6})\s*$", out)
    if rc != 0 or not m:
        raise ToolError(err.strip() or L("no colour picked", "ingen farge valgt"))
    return text("#" + m.group(1).lower())


@tool("clipboard_read", "sensitive", "Read the clipboard", "Les utklippstavlen",
      "The text on the clipboard now (at most 64 KB). Never what a password manager marked as secret.", open_world=True)
def t_clipboard(a, s):
    rc, types, err = run(["wl-paste", "--list-types"])
    if rc != 0:
        raise ToolError(L("the clipboard is empty", "utklippstavlen er tom"))
    types = types.split()
    if "x-kde-passwordManagerHint" in types:
        raise ToolError(L("the clipboard holds a password; not shown", "utklippstavlen har et passord; vises ikke"))
    for t in ("text/plain;charset=utf-8", "UTF8_STRING", "text/plain"):
        if t in types:
            rc, out, err = run(["wl-paste", "--no-newline", "--type", t], limit=65536)
            if rc == 0:
                return text(out)
    raise ToolError(L("the clipboard holds no text", "utklippstavlen har ingen tekst"))


