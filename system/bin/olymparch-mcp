# ── files: read and list only, inside the home folder, never hidden files or folders (.ssh, .gnupg, .config …),
#    never key or password stores, never through a symlink that leads out. TOCTOU: the file is opened without
#    following a symlink and must be the same inode that was checked.
SECRET_FILES = re.compile(r"(^id_[a-z0-9]+(\.pub)?$|\.(kdbx|kdb|pem|key|p12|pfx|gpg|age|asc|keystore|jks|ovpn)$|"
                          r"^(credentials|secrets?|passwords?)(\.[a-z]+)?$)", re.I)


def home_path(p):
    if "\x00" in p or len(p) > 4096:
        raise ToolError("bad path")
    if p == "~" or p == "":
        p = HOME
    elif p.startswith("~/"):
        p = os.path.join(HOME, p[2:])
    elif not p.startswith("/"):
        p = os.path.join(HOME, p)
    real = os.path.realpath(p)
    for candidate in (os.path.normpath(p), real):
        rel = os.path.relpath(candidate, HOME)
        if rel == ".":
            continue
        if rel.startswith("..") or os.path.isabs(rel):
            raise ToolError(L("only files in your home folder", "bare filer i hjemmemappen"))
        for part in rel.split(os.sep):
            if part.startswith("."):
                raise ToolError(L("hidden files and folders are off limits", "skjulte filer og mapper er ikke tillatt"))
        if SECRET_FILES.search(os.path.basename(candidate)):
            raise ToolError(L("key and password files are off limits", "nøkkel- og passordfiler er ikke tillatt"))
    return real


def _display(path):
    return "~" + path[len(HOME):] if path.startswith(HOME) else path


@tool("files_list", "read", "List a folder", "Vis en mappe",
      "Files and folders in a folder in the home folder (not hidden ones): name, kind, size. ~ is the home folder.",
      {"path": S(1024, desc="like ~/Documents")}, open_world=True)
def t_files_list(a, s):
    p = home_path(a.get("path") or "~")
    if not os.path.isdir(p):
        raise ToolError(L("not a folder", "ikke en mappe"))
    rows = []
    try:
        with os.scandir(p) as it:
            for e in it:
                if e.name.startswith(".") or SECRET_FILES.search(e.name):
                    continue
                try:
                    st = e.stat(follow_symlinks=False)
                except OSError:
                    continue
                kind = "link" if stat.S_ISLNK(st.st_mode) else "dir" if stat.S_ISDIR(st.st_mode) else "file"
                rows.append((e.name, kind, st.st_size))
                if len(rows) >= 500:
                    break
    except PermissionError:
        raise ToolError(L("no access", "ingen tilgang")) from None
    rows.sort(key=lambda r: (r[1] != "dir", r[0].lower()))
    return text(f"{_display(p)}:\n" + "\n".join(f"{k}\t{n}\t{sz}" for n, k, sz in rows))


@tool("files_read", "sensitive", "Read a file", "Les en fil",
      "A text file in the home folder (not hidden ones, not key or password files), at most 256 KB per call; "
      "offset and max_bytes page through bigger files.",
      {"path": S(1024, minlen=1), "offset": I(0, 1 << 40), "max_bytes": I(1, 262144, "default 65536")}, ("path",),
      summary=lambda a: short(a.get("path", ""), 120), open_world=True)
def t_files_read(a, s):
    p = home_path(a["path"])
    try:
        before = os.stat(p)
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as e:
        raise ToolError(e.strerror or "cannot open") from None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or (st.st_dev, st.st_ino) != (before.st_dev, before.st_ino):
            raise ToolError(L("not a regular file", "ikke en vanlig fil"))
        os.lseek(fd, a.get("offset", 0), os.SEEK_SET)
        data = os.read(fd, a.get("max_bytes", 65536))
    finally:
        os.close(fd)
    if b"\x00" in data:
        raise ToolError(L("a binary file; only text can be read", "en binærfil; bare tekst kan leses"))
    more = a.get("offset", 0) + len(data) < st.st_size
    return text(data.decode("utf-8", "replace") + (f"\n[… {st.st_size} bytes in all; continue with offset "
                                                   f"{a.get('offset', 0) + len(data)}]" if more else ""))


# ──────────────────────────────────────────────────────────────────────────────────────────────── resources
def resources():
    return [
        {"uri": "olymparch://settings/schema", "name": "settings-schema", "title": "Olymparch settings schema",
         "description": "Every setting: key, page, type, options, limits, labels (en/nb).", "mimeType": "application/json"},
        {"uri": "olymparch://system/summary", "name": "system-summary", "title": "System summary",
         "description": "Version, CPU, GPU, memory, kernel, disk, monitors.", "mimeType": "text/plain"},
    ]


def read_resource(uri):
    if uri == "olymparch://settings/schema":
        with open(schema_path(), encoding="utf-8") as f:
            return {"uri": uri, "mimeType": "application/json", "text": f.read()}
    if uri == "olymparch://system/summary":
        rc, out, err = settings("about")
        return {"uri": uri, "mimeType": "text/plain", "text": out if rc == 0 else err}
    return None


# ──────────────────────────────────────────────────────────────────────────────────────────────── approval
CLIENT_NAME = re.compile(r"[^a-z0-9._-]+")


def client_key(name):
    n = CLIENT_NAME.sub("-", (name or "").lower()).strip("-.")[:40]
    return n if n and n[0].isalnum() else "unknown"


def policy(session, t):
    """→ (decision, why) for a call: allow | ask | deny."""
    if setting("ai.enabled", True) is not True:
        return "deny", "off"
    if session.client_name in (setting("ai.blocked_clients", []) or []):
        return "deny", "blocked"
    pol = {p[0]: p[1] for p in (setting("ai.policy", []) or []) if isinstance(p, list) and len(p) == 2}.get(t.name)
    pol = pol or ("always" if t.risk == "read" else "ask")
    if pol == "never":
        return "deny", "policy never"
    if pol == "always":
        return "allow", "policy always" if t.risk != "read" else "read"
    if [session.client_id, t.name] in (setting("ai.grants", []) or []):
        return "allow", "always grant"
    return "ask", ""


def qs():
    return os.environ.get("OLYMPARCH_MCP_QS") or shutil.which("qs") or "/usr/bin/qs"   # OLYMPARCH_MCP_QS: tests only


_card_lock = threading.Lock()


def ask_user(session, t, summary, req=None):
    """The card in the shell; → (decision, why). The answer comes back as a file the shell writes in our private
    runtime folder, named by a random id; nothing the agent can reach writes there."""
    if not RUN:
        return "deny", "no XDG_RUNTIME_DIR"
    if not _card_lock.acquire(timeout=APPROVAL_SECONDS):   # one card per server at a time
        return "deny", "busy"
    rid = secrets.token_hex(16)
    try:
        private_dir(RUN)
        private_dir(ANSWERS)
        answer = os.path.join(ANSWERS, rid)
        session.pending.add(rid)
        rc, out, err = run([qs(), "ipc", "-p", SHELL_DIR, "call", "mcp", "ask", rid, session.client_name,
                            session.transport, t.name, t.title[1 if NB else 0], t.risk, summary[:300]], timeout=10)
        state = out.strip()
        if rc != 0 or state not in ("shown", "game", "off"):
            return "deny", "no approval card (is the desktop running?)"
        if state == "game":
            return "deny", "game mode"
        if state == "off":
            return "deny", "off"
        deadline = time.monotonic() + APPROVAL_SECONDS
        token = (req or {}).get("progressToken")
        if token is not None and session.notify:
            session.notify({"jsonrpc": "2.0", "method": "notifications/progress", "params": {
                "progressToken": token, "progress": 0, "message": L("Waiting for the user's approval on the desktop …",
                                                                  "Venter på godkjenning i skrivebordet …")}})
        while time.monotonic() < deadline:
            time.sleep(0.15)
            if session.is_cancelled((req or {}).get("id")):
                run([qs(), "ipc", "-p", SHELL_DIR, "call", "mcp", "cancel", rid], timeout=10)
                return "deny", "cancelled by the client"
            try:
                fd = os.open(answer, os.O_RDONLY | os.O_NOFOLLOW)
            except FileNotFoundError:
                continue
            except OSError:
                break
            try:
                data = os.read(fd, 128).decode("ascii", "replace").split()
            finally:
                os.close(fd)
                os.unlink(answer)
            if len(data) == 2 and data[0] == rid and data[1] in ("once", "always", "deny"):
                if data[1] == "always":
                    rc, _, err = settings("add", "ai.grants", f"{session.client_id} {t.name}")
                    if rc != 0:
                        log(f"could not store the grant: {err.strip()}")
                    return "allow", "approved always"
                return ("allow", "approved once") if data[1] == "once" else ("deny", "denied by the user")
            break
        run([qs(), "ipc", "-p", SHELL_DIR, "call", "mcp", "cancel", rid], timeout=10)
        return "deny", "timeout"
    finally:
        session.pending.discard(rid)
        try:
            os.unlink(os.path.join(ANSWERS, rid))
        except OSError:
            pass
        _card_lock.release()


# ──────────────────────────────────────────────────────────────────────────────────────────────── protocol
class RpcError(Exception):
    def __init__(self, code, message, data=None):
        super().__init__(message)
        self.code, self.message, self.data = code, message, data


class Session:
    def __init__(self, transport):
        self.transport = transport
        self.client_name, self.client_title = "unknown", ""
        self.initialized = False
        self.protocol = PROTOCOLS[0]
        self.pending = set()
        self.calls = []            # times of recent calls (rate limit)
        self.asks = []             # times of recent cards
        self.denials = {}          # tool → (consecutive denials, cooldown until)
        self.last = time.monotonic()
        self.lock = threading.Lock()
        self.cancelled = set()      # JSON-RPC ids the client cancelled (notifications/cancelled)
        self.notify = None          # stdio: send a notification (progress while a card waits)

    def is_cancelled(self, rid):
        return rid is not None and rid in self.cancelled

    @property
    def client_id(self):
        return f"{self.client_name}@{self.transport}"

    def rate(self, kind, limit, window):
        now = time.monotonic()
        with self.lock:
            lst = self.asks if kind == "ask" else self.calls
            lst[:] = [x for x in lst if now - x < window]
            if len(lst) >= limit:
                return False
            lst.append(now)
            return True

    def cancel_cards(self):
        for rid in list(self.pending):
            run([qs(), "ipc", "-p", SHELL_DIR, "call", "mcp", "cancel", rid], timeout=5)


def call_tool(session, params, req_id=None):
    name = params.get("name")
    args = params.get("arguments", {})
    if not isinstance(name, str) or name not in TOOLS:
        audit(session, short(str(name), 48), "", "refused", "unknown tool")
        raise RpcError(-32602, f"Unknown tool: {short(str(name), 48)}")
    t = TOOLS[name]
    if args is None:
        args = {}
    try:
        check(t.schema, args)
    except BadArgs as e:
        audit(session, name, "", "refused", f"invalid arguments: {e}")
        raise RpcError(-32602, f"Invalid arguments for {name}: {e}") from None
    summary = summarize(name, args)
    if not session.rate("call", 30, 10):
        audit(session, name, summary, "refused", "rate limit")
        return {"content": [{"type": "text", "text": "Too many calls; wait a few seconds."}], "isError": True}
    # What can never work is refused before any card: a key the agent may not set, a path outside what it may read
    try:
        if name in ("settings_set", "settings_reset"):
            _settable(args["key"])
        if name in ("files_read", "files_list"):
            home_path(args.get("path") or "~")
    except ToolError as e:
        audit(session, name, summary, "refused", str(e))
        return {"content": [{"type": "text", "text": str(e)}], "isError": True,
                "structuredContent": {"denied": True, "reason": "not allowed"}}
    decision, why = policy(session, t)
    if decision == "ask":
        count, until = session.denials.get(name, (0, 0))
        if until > time.monotonic():
            decision, why = "deny", "cooldown after repeated denials"
        elif not session.rate("ask", 6, 60):
            decision, why = "deny", "too many approval requests"
        else:
            meta = params.get("_meta") if isinstance(params.get("_meta"), dict) else {}
            tok = meta.get("progressToken")
            decision, why = ask_user(session, t, summary, {"id": req_id, "progressToken": tok if isinstance(tok, (str, int)) and not isinstance(tok, bool) else None})
            if decision == "deny" and why in ("denied by the user", "timeout"):
                count += 1
                session.denials[name] = (count, time.monotonic() + 120 if count >= 3 else 0)
            elif decision == "allow":
                session.denials.pop(name, None)
    if decision != "allow":
        audit(session, name, summary, f"denied ({why})", "")
        msg = {
            "game mode": L("Denied: the user is playing a game. Do not ask again until they are back.",
                           "Avvist: brukeren spiller nå. Ikke spør igjen før de er tilbake."),
            "timeout": L("Denied: the user did not answer within 60 s.", "Avvist: brukeren svarte ikke innen 60 s."),
            "off": L("Denied: AI agents are switched off in Settings → AI agents.", "Avvist: AI-agenter er slått av i Innstillinger → AI-agenter."),
        }.get(why, L(f"Denied ({why}). Ask the user in the chat what to do instead; do not retry at once.",
                     f"Avvist ({why}). Spør brukeren i chatten hva du skal gjøre i stedet; ikke prøv igjen med en gang."))
        return {"content": [{"type": "text", "text": msg}], "isError": True,
                "structuredContent": {"denied": True, "reason": why}}
    try:
        result = t.fn(args, session)
        size = sum(len(c.get("text", "")) + len(c.get("data", "")) for c in result.get("content", []))
        audit(session, name, summary, f"allowed ({why})", f"ok ({size} bytes)")
        return result
    except ToolError as e:
        audit(session, name, summary, f"allowed ({why})", f"error: {e}")
        return {"content": [{"type": "text", "text": str(e)}], "isError": True}
    except Exception as e:   # a bug here must not kill the server
        log(f"{name}: {type(e).__name__}: {e}")
        audit(session, name, summary, f"allowed ({why})", f"error: internal {type(e).__name__}")
        return {"content": [{"type": "text", "text": f"internal error ({type(e).__name__})"}], "isError": True}


INSTRUCTIONS = (
    "Olymparch is the user's Arch Linux gaming desktop (Hyprland). These tools control it. Prefer them over shell "
    "commands, never use sudo yourself. read tools run at once; change and sensitive tools show the user an approval "
    "card and may be denied: then stop and ask the user in the chat. Settings: read the resource "
    "olymparch://settings/schema before settings_set. Troubleshooting: start with system_doctor.")


def handle(session, msg):
    """One JSON-RPC message → the response (a dict) or None for notifications and responses."""
    if isinstance(msg, list):
        raise RpcError(-32600, "batches are not supported")
    if not isinstance(msg, dict) or msg.get("jsonrpc") != "2.0":
        raise RpcError(-32600, "not a JSON-RPC 2.0 message")
    if "method" not in msg:
        return None   # a response to a request of ours (we send none): ignored
    method = msg["method"]
    is_request = "id" in msg
    rid = msg.get("id")
    if is_request and not ((isinstance(rid, str) and len(rid) <= 200) or (isinstance(rid, int) and not isinstance(rid, bool))):
        raise RpcError(-32600, "id must be a string or an integer")
    if not isinstance(method, str) or len(method) > 100:
        raise RpcError(-32600, "bad method")
    params = msg.get("params", {})
    if params is None:
        params = {}
    if not isinstance(params, dict):
        raise RpcError(-32602, "params must be an object")
    if not is_request:
        if method == "notifications/initialized":
            session.initialized = True
        elif method == "notifications/cancelled":   # stop waiting for the card; the call is not run, no answer is sent
            r = params.get("requestId")
            if (isinstance(r, str) and len(r) <= 200) or (isinstance(r, int) and not isinstance(r, bool)):
                with session.lock:
                    session.cancelled.add(r)
                    if len(session.cancelled) > 1000:
                        session.cancelled.clear()
        return None   # notifications/cancelled and others: nothing to do
    result = dispatch(session, method, params, rid)
    if session.is_cancelled(rid):
        return None
    return {"jsonrpc": "2.0", "id": rid, "result": result}


def dispatch(session, method, params, rid=None):
    if method == "initialize":
        info = params.get("clientInfo") or {}
        if not isinstance(info, dict) or not isinstance(info.get("name", ""), str):
            raise RpcError(-32602, "clientInfo.name must be text")
        session.client_name = client_key(info.get("name"))
        session.client_title = info.get("title") if isinstance(info.get("title"), str) else ""
        want = params.get("protocolVersion")
        session.protocol = want if want in PROTOCOLS else PROTOCOLS[0]
        remember_client(session)
        if setting("ai.enabled", True) is not True:
            audit(session, "initialize", "", "refused", "switched off")
            raise RpcError(-32001, L("Olymparch's MCP server is switched off (Settings → AI agents)",
                                     "Olymparchs MCP-server er slått av (Innstillinger → AI-agenter)"))
        if session.client_name in (setting("ai.blocked_clients", []) or []):
            audit(session, "initialize", "", "refused", "blocked client")
            raise RpcError(-32001, L("this client is blocked in Settings → AI agents", "denne klienten er blokkert i Innstillinger → AI-agenter"))
        session.initialized = True   # lenient: some clients send tools/list before notifications/initialized
        audit(session, "initialize", f"protocol {short(str(want), 20)}", "connected", "ok")
        return {"protocolVersion": session.protocol,
                "capabilities": {"tools": {"listChanged": False}, "resources": {"subscribe": False, "listChanged": False}},
                "serverInfo": {"name": "olymparch", "title": "Olymparch", "version": VERSION},
                "instructions": INSTRUCTIONS}
    if method == "ping":
        return {}
    if not session.initialized:
        raise RpcError(-32002, "not initialized: send initialize first")
    if method == "tools/list":
        return {"tools": [t.listing() for t in TOOLS.values()]}
    if method == "tools/call":
        return call_tool(session, params, rid)
    if method == "resources/list":
        return {"resources": resources()}
    if method == "resources/templates/list":
        return {"resourceTemplates": []}
    if method == "resources/read":
        uri = params.get("uri")
        r = read_resource(uri) if isinstance(uri, str) else None
        if not r:
            raise RpcError(-32002, "Resource not found", {"uri": short(str(uri), 80)})
        return {"contents": [r]}
    raise RpcError(-32601, f"Method not found: {short(method, 60)}")


def respond(session, raw):
    """bytes of one message → bytes of the response, or None."""
    try:
        msg = json.loads(raw)
    except (ValueError, UnicodeDecodeError):
        return {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error"}}
    rid = msg.get("id") if isinstance(msg, dict) else None
    if isinstance(rid, (bool, float, dict, list)):
        rid = None
    try:
        return handle(session, msg)
    except RpcError as e:
        if isinstance(msg, dict) and "method" in msg and "id" not in msg:
            return None   # never answer a notification, not even with an error
        err = {"code": e.code, "message": e.message}
        if e.data is not None:
            err["data"] = e.data
        return {"jsonrpc": "2.0", "id": rid, "error": err}
    except Exception as e:
        log(f"internal error: {type(e).__name__}: {e}")
        return {"jsonrpc": "2.0", "id": rid, "error": {"code": -32603, "message": "Internal error"}}


# ──────────────────────────────────────────────────────────────────────────────────────────────── stdio
def serve_stdio():
    session = Session("stdio")
    out_lock = threading.Lock()
    workers = threading.BoundedSemaphore(4)
    threads = []

    def send(obj):
        if obj is None:
            return
        data = (json.dumps(obj, ensure_ascii=False) + "\n").encode()
        with out_lock:
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()

    session.notify = send

    def work(raw):
        try:
            send(respond(session, raw))
        finally:
            workers.release()

    inp = sys.stdin.buffer
    while True:
        line = inp.readline(MAX_MESSAGE + 1)
        if not line:
            break
        if len(line) > MAX_MESSAGE and not line.endswith(b"\n"):
            while True:   # skip the rest of the oversized line
                more = inp.readline(MAX_MESSAGE)
                if not more or more.endswith(b"\n"):
                    break
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "message too large"}})
            continue
        if not line.strip():
            continue
        if b'"tools/call"' in line:   # may wait for the user: in a thread, so ping and the rest still answer
            if not workers.acquire(blocking=False):
                try:
                    rid = json.loads(line).get("id")
                except (ValueError, AttributeError):
                    rid = None
                send({"jsonrpc": "2.0", "id": rid if isinstance(rid, (str, int)) and not isinstance(rid, bool) else None,
                      "error": {"code": -32000, "message": "busy: too many calls at once"}})
                continue
            th = threading.Thread(target=work, args=(line,), daemon=True)
            th.start()
            threads.append(th)
            threads[:] = [x for x in threads if x.is_alive()]
        else:
            send(respond(session, line))
    session.cancel_cards()
    for th in threads:
        th.join(timeout=1)


# ──────────────────────────────────────────────────────────────────────────────────────────────── HTTP
def ensure_token():
    if not RUN:
        raise SystemExit("olymparch-mcp: XDG_RUNTIME_DIR is not set; the HTTP endpoint needs it for the token")
    private_dir(RUN)
    try:
        fd = os.open(TOKEN, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        os.write(fd, (secrets.token_urlsafe(32) + "\n").encode())
        os.close(fd)
    except FileExistsError:
        pass
    st = os.lstat(TOKEN)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise SystemExit(f"olymparch-mcp: {TOKEN} is not a private file of yours; remove it")
    with open(TOKEN, encoding="ascii") as f:
        return f.read().strip()


class Http(BaseHTTPRequestHandler):
    server_version = "olymparch-mcp"
    sys_version = ""
    protocol_version = "HTTP/1.1"
    timeout = 30

    def log_message(self, *a):   # never log requests (headers carry the token)
        pass

    def reply(self, code, body=None, headers=None):
        data = b"" if body is None else (json.dumps(body, ensure_ascii=False).encode() if not isinstance(body, bytes) else body)
        self.send_response(code)
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        if body is not None:
            self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        if code >= 400:   # never read on after a refusal (the body may still be on its way)
            self.close_connection = True
            self.send_header("Connection", "close")
        self.end_headers()
        if data and self.command != "HEAD":
            self.wfile.write(data)

    def gate(self):
        """Host, Origin, path and token, before anything is read. → True to go on."""
        port = self.server.server_address[1]
        hosts = {f"127.0.0.1:{port}", f"localhost:{port}", f"[::1]:{port}"}
        if (self.headers.get("Host") or "") not in hosts:
            self.reply(403, {"error": "bad Host"})
            return False
        origin = self.headers.get("Origin")
        if origin is not None and origin not in {f"http://{h}" for h in hosts}:
            self.reply(403, {"error": "bad Origin"})
            return False
        if self.path.split("?")[0] != "/mcp":
            self.reply(404, {"error": "not found"})
            return False
        auth = self.headers.get("Authorization") or ""
        given = auth[7:].strip() if auth.startswith("Bearer ") else ""
        if not given or not hmac.compare_digest(given.encode(), self.server.token.encode()):
            with self.server.lock:
                now = time.monotonic()
                self.server.failures = [t for t in self.server.failures if now - t < 60] + [now]
                slow = len(self.server.failures) > 10
            if slow:
                time.sleep(1)
            self.reply(401, {"error": "token required"}, {"WWW-Authenticate": 'Bearer realm="olymparch-mcp"'})
            return False
        return True

    def session(self):
        sid = self.headers.get("Mcp-Session-Id")
        if not sid:
            self.reply(400, {"error": "Mcp-Session-Id required"})
            return None
        with self.server.lock:
            s = self.server.sessions.get(sid)
        if not s:
            self.reply(404, {"error": "unknown session"})
            return None
        s.last = time.monotonic()
        return s

    def do_GET(self):
        if self.gate():
            self.reply(405, {"error": "no server-sent events; POST JSON-RPC to /mcp"}, {"Allow": "POST, DELETE"})

    def do_DELETE(self):
        if not self.gate():
            return
        s = self.session()
        if s:
            with self.server.lock:
                self.server.sessions.pop(self.headers.get("Mcp-Session-Id"), None)
            s.cancel_cards()
            self.reply(204)

    def do_PUT(self):
        if self.gate():
            self.reply(405, {"error": "method not allowed"}, {"Allow": "POST, DELETE"})

    do_PATCH = do_OPTIONS = do_HEAD = do_PUT

    def do_POST(self):
        self.connection.settimeout(30)
        if not self.gate():
            return
        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        if ctype != "application/json":
            return self.reply(415, {"error": "Content-Type must be application/json"})
        accept = self.headers.get("Accept") or ""
        if "application/json" not in accept and "*/*" not in accept:
            return self.reply(406, {"error": "Accept must include application/json"})
        try:
            length = int(self.headers.get("Content-Length") or "-1")
        except ValueError:
            length = -1
        if length < 0:
            return self.reply(411, {"error": "Content-Length required"})
        if length > MAX_MESSAGE:
            return self.reply(413, {"error": "message too large"})
        raw = self.rfile.read(length)
        try:
            msg = json.loads(raw)
        except (ValueError, UnicodeDecodeError):
            return self.reply(400, {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error"}})
        version = self.headers.get("MCP-Protocol-Version")
        if isinstance(msg, dict) and msg.get("method") == "initialize":
            s = Session("http")
            resp = respond(s, raw)
            if resp and "result" in resp:
                sid = secrets.token_urlsafe(24)
                with self.server.lock:
                    now = time.monotonic()
                    for k in [k for k, v in self.server.sessions.items() if now - v.last > 3600]:
                        del self.server.sessions[k]
                    if len(self.server.sessions) >= MAX_SESSIONS:
                        return self.reply(503, {"error": "too many sessions"})
                    self.server.sessions[sid] = s
                return self.reply(200, resp, {"Mcp-Session-Id": sid})
            return self.reply(200 if resp else 202, resp)
        s = self.session()
        if not s:
            return
        if version is not None and version not in PROTOCOLS:
            return self.reply(400, {"error": "unsupported MCP-Protocol-Version"})
        resp = respond(s, raw)
        if resp is None:
            return self.reply(202)
        self.reply(200, resp)


def listener(port):
    """The socket systemd passed us (olymparch-mcp.socket), else our own; both 127.0.0.1 only."""
    if os.environ.get("LISTEN_PID") == str(os.getpid()) and os.environ.get("LISTEN_FDS") == "1":
        sock = socket.socket(fileno=3)
        addr = sock.getsockname()
        if addr[0] not in ("127.0.0.1", "::1"):
            raise SystemExit(f"olymparch-mcp: refusing to serve on {addr[0]}: 127.0.0.1 only")
        return sock, True
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(("127.0.0.1", port))
    sock.listen(16)
    return sock, False


def serve_http(port):
    if setting("ai.enabled", True) is not True:
        raise SystemExit("olymparch-mcp: switched off in Settings → AI agents")
    token = ensure_token()
    sock, activated = listener(port)

    class Server(ThreadingHTTPServer):
        daemon_threads = True

    srv = Server(("127.0.0.1", port), Http, bind_and_activate=False)
    srv.socket.close()
    srv.socket = sock
    srv.server_address = sock.getsockname()[:2]
    srv.token, srv.sessions, srv.lock, srv.failures = token, {}, threading.Lock(), []
    srv.timeout = 60
    log(f"listening on http://127.0.0.1:{srv.server_address[1]}/mcp (token in {TOKEN})")
    if activated:   # started by the socket: stop after 30 idle minutes; the socket starts us again
        def idle():
            while True:
                time.sleep(60)
                with srv.lock:
                    busy = any(time.monotonic() - s.last < 1800 for s in srv.sessions.values())
                if not busy and time.monotonic() - srv.started > 1800:
                    srv.shutdown()
                    return
        srv.started = time.monotonic()
        threading.Thread(target=idle, daemon=True).start()
    srv.serve_forever()


# ──────────────────────────────────────────────────────────────────────────────────────────────── registration
SKILLS = ("olymparch", "olymparch-settings", "olymparch-look", "olymparch-windows-apps", "olymparch-packages",
          "olymparch-troubleshooting")
HERMES_BEGIN = "# >>> olymparch-mcp (added by olymparch-mcp register; olymparch-mcp unregister removes it)"
HERMES_END = "# <<< olymparch-mcp"


def exe():
    return EXE if os.path.isfile(EXE) else SELF


def skills_src():
    if os.path.isdir(SKILLS_SRC):
        return SKILLS_SRC
    return os.path.realpath(os.path.join(HERE, "../../default/skills"))


def load_manifest():
    try:
        with open(MANIFEST, encoding="utf-8") as f:
            m = json.load(f)
            return m if isinstance(m, dict) else {}
    except (OSError, ValueError):
        return {}


def save_manifest(m):
    private_dir(STATE)
    tmp = MANIFEST + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(m, f, indent=1, sort_keys=True)
    os.replace(tmp, MANIFEST)


def atomic_write(path, text_):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, f".{os.path.basename(path)}.olymparch-{os.getpid()}")
    mode = stat.S_IMODE(os.stat(path).st_mode) if os.path.exists(path) else 0o600
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text_)
    os.replace(tmp, path)


def hermes_add(path, command):
    """~/.hermes/config.yaml, mcp_servers: our entry as a marked block; the rest of the file is left as it is."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    if any(HERMES_BEGIN in l for l in lines):
        return "already"
    top = next((i for i, l in enumerate(lines) if re.match(r"^mcp_servers:\s*(#.*)?$", l)), None)
    if any(re.match(r"^mcp_servers:\s*\S", l) and not re.match(r"^mcp_servers:\s*#", l) for l in lines):
        return "skipped: mcp_servers is not a block mapping; add it yourself"
    indent = "  "
    if top is not None:
        for l in lines[top + 1:]:
            if l.strip() and not l.lstrip().startswith("#"):
                m = re.match(r"^(\s+)\S", l)
                if m:
                    indent = m.group(1)
                break
        # an olymparch entry of the user's own under mcp_servers
        i = top + 1
        while i < len(lines) and (not lines[i].strip() or lines[i].startswith((" ", "\t", "#"))):
            if re.match(rf"^{indent}olymparch\s*:", lines[i]):
                return "exists (yours; left alone)"
            i += 1
    block = [indent + HERMES_BEGIN, f"{indent}olymparch:", f"{indent * 2}command: {json.dumps(command)}",
             f"{indent * 2}args: []", indent + HERMES_END]
    if top is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines += ["mcp_servers:  " + HERMES_BEGIN.replace("# >>>", "# >>> key:")] + block
    else:
        lines[top + 1:top + 1] = block
    atomic_write(path, "\n".join(lines) + "\n")
    return "added"


def hermes_remove(path):
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return "gone"
    out, skip = [], False
    for l in lines:
        if HERMES_BEGIN.replace("# >>>", "# >>> key:") in l:
            continue   # the mcp_servers: line we added ourselves
        if HERMES_BEGIN in l:
            skip = True
            continue
        if skip:
            if HERMES_END in l:
                skip = False
            continue
        out.append(l)
    if out != lines:
        while out and not out[-1].strip():
            out.pop()
        atomic_write(path, "\n".join(out) + "\n")
        return "removed"
    return "gone"


def link_skills(base, m, key):
    src = skills_src()
    done = m.setdefault(key, [])
    out = []
    for name in SKILLS:
        target, link = os.path.join(src, name), os.path.join(base, name)
        if not os.path.isfile(os.path.join(target, "SKILL.md")):
            continue
        if os.path.islink(link):
            if os.path.realpath(link) == os.path.realpath(target):
                if link not in done:
                    done.append(link)
                continue
            out.append(f"{link}: exists (yours; left alone)")
            continue
        if os.path.exists(link):
            out.append(f"{link}: exists (yours; left alone)")
            continue
        os.makedirs(base, exist_ok=True)
        os.symlink(target, link)
        done.append(link)
    return out


def register(auto):
    if auto and (setting("ai.enabled", True) is not True or setting("ai.auto_register", True) is not True):
        print(L("automatic registration is off (Settings → AI agents)", "automatisk registrering er av (Innstillinger → AI-agenter)"))
        return 0
    if RUN:
        try:
            ensure_token()
        except SystemExit as e:
            log(str(e))
    m = load_manifest()
    lines = []
    command = exe()
    # Claude Code: the documented CLI, user scope (it keeps it in ~/.claude.json)
    if have("claude"):
        if run(["claude", "mcp", "get", "olymparch"], timeout=60)[0] == 0:
            lines.append("Claude Code: " + ("registered" if m.get("claude") else "exists (yours; left alone)"))
        else:
            rc, out, err = run(["claude", "mcp", "add", "--scope", "user", "--transport", "stdio", "olymparch", "--", command], timeout=60)
            if rc == 0:
                m["claude"] = True
            lines.append("Claude Code: " + ("added (user scope)" if rc == 0 else f"failed: {short(err or out, 100)}"))
        lines += link_skills(os.path.join(HOME, ".claude/skills"), m, "claude_skills")
    # Hermes Agent: ~/.hermes/config.yaml, mcp_servers (the documented format), skills in ~/.hermes/skills
    if have("hermes"):
        hermes_home = os.environ.get("HERMES_HOME") or os.path.join(HOME, ".hermes")
        try:
            r = hermes_add(os.path.join(hermes_home, "config.yaml"), command)
        except OSError as e:
            r = f"failed: {e}"
        if r == "added":
            m["hermes"] = os.path.join(hermes_home, "config.yaml")
        lines.append(f"Hermes Agent: {r}")
        lines += link_skills(os.path.join(hermes_home, "skills"), m, "hermes_skills")
    # OpenClaw: its own CLI writes ~/.openclaw/openclaw.json (mcp.servers.olymparch); skills in ~/.openclaw/skills
    if have("openclaw"):
        if run(["openclaw", "mcp", "show", "olymparch", "--json"], timeout=60)[0] == 0:
            lines.append("OpenClaw: " + ("registered" if m.get("openclaw") else "exists (yours; left alone)"))
        else:
            rc, out, err = run(["openclaw", "mcp", "set", "olymparch", json.dumps({"command": command, "args": []})], timeout=60)
            if rc == 0:
                m["openclaw"] = True
            lines.append("OpenClaw: " + ("added" if rc == 0 else f"failed (tried again at next login): {short(err or out, 100)}"))
        lines += link_skills(os.path.join(os.environ.get("OPENCLAW_STATE_DIR") or os.path.join(HOME, ".openclaw"), "skills"), m, "openclaw_skills")
    # Olympus (Zeus) finds /usr/bin/olymparch-mcp by itself ([mcp] autodetect); nothing to write
    if have("olympus") or os.path.exists(os.path.join(HOME, ".local/bin/olympus")):
        lines.append("Olympus (Zeus): " + L("finds olymparch-mcp by itself", "finner olymparch-mcp selv"))
    save_manifest(m)
    print("\n".join(lines) if lines else L("no agents found (claude, hermes, openclaw, olympus)",
                                           "fant ingen agenter (claude, hermes, openclaw, olympus)"))
    return 0


def unregister():
    m = load_manifest()
    lines = []
    if m.pop("claude", None) and have("claude"):
        rc, out, err = run(["claude", "mcp", "remove", "olymparch", "--scope", "user"], timeout=60)
        lines.append("Claude Code: " + ("removed" if rc == 0 else f"failed: {short(err or out, 100)}"))
    if m.get("hermes"):
        lines.append("Hermes Agent: " + hermes_remove(m.pop("hermes")))
    if m.pop("openclaw", None) and have("openclaw"):
        rc, out, err = run(["openclaw", "mcp", "unset", "olymparch"], timeout=60)
        lines.append("OpenClaw: " + ("removed" if rc == 0 else f"failed: {short(err or out, 100)}"))
    src = os.path.realpath(skills_src())
    for key in ("claude_skills", "hermes_skills", "openclaw_skills"):
        for link in m.pop(key, []):
            if os.path.islink(link) and os.path.realpath(link).startswith(src + os.sep):
                os.unlink(link)
                lines.append(f"{link}: removed")
    save_manifest(m)
    print("\n".join(lines) if lines else L("nothing was registered", "ingenting var registrert"))
    return 0


def apply_settings():
    enabled = setting("ai.enabled", True) is True
    http = setting("ai.http", True) is True
    if have("systemctl"):
        verb = ["enable", "--now"] if enabled and http else ["disable", "--now"]
        run(["systemctl", "--user", *verb, "olymparch-mcp.socket"], timeout=30)
        if not (enabled and http):
            run(["systemctl", "--user", "stop", "olymparch-mcp.service"], timeout=30)
    if setting("ai.auto_register", True) is True and enabled:
        return register(auto=True)
    if setting("ai.auto_register", True) is not True:
        return unregister()
    return 0


def status():
    m = load_manifest()
    print(f"{L('server', 'server')}: {L('on', 'på') if setting('ai.enabled', True) is True else L('off', 'av')}")
    print(f"stdio: {exe()}")
    state = run(["systemctl", "--user", "is-active", "olymparch-mcp.socket"])[1].strip() if have("systemctl") else "?"
    print(f"http: http://127.0.0.1:{PORT}/mcp ({state}); token: {TOKEN or '-'}")
    print(f"{L('registered with', 'registrert hos')}: " + (", ".join(k for k in ("claude", "hermes", "openclaw") if m.get(k)) or "-"))
    print(f"{L('audit log', 'logg')}: {AUDIT}")
    return 0


def show_audit(n):
    try:
        with open(AUDIT, encoding="utf-8") as f:
            rows = f.read().splitlines()[-n:]
    except FileNotFoundError:
        print(L("no calls yet", "ingen kall ennå"))
        return 0
    for r in reversed(rows):
        try:
            e = json.loads(r)
            print(f"{e['time'][5:16].replace('T', ' ')}  {e['client']}/{e['transport']}  {e['tool']}  "
                  f"{e['args'][:60]}  → {e['decision']}  {e['result'][:60]}".rstrip())
        except (ValueError, KeyError, TypeError):
            continue
    return 0


def main(argv):
    sub = argv[1] if len(argv) > 1 else "stdio"
    if sub in ("stdio", "--stdio"):
        serve_stdio()
    elif sub == "http":
        port = PORT
        if len(argv) > 3 and argv[2] == "--port" and argv[3].isdigit() and 1024 <= int(argv[3]) <= 65535:
            port = int(argv[3])
        serve_http(port)
    elif sub == "register":
        return register(auto="--auto" in argv)
    elif sub == "unregister":
        return unregister()
    elif sub == "apply":
        return apply_settings()
    elif sub == "status":
        return status()
    elif sub == "tools":
        for t in TOOLS.values():
            print(f"{t.name}\t{t.risk}\t{t.title[1 if NB else 0]}" if "--tsv" in argv else f"{t.name:18} {t.risk:9} {t.title[1 if NB else 0]}")
    elif sub == "audit":
        return show_audit(int(argv[2]) if len(argv) > 2 and argv[2].isdigit() else 30)
    elif sub == "clients":
        try:
            with open(SEEN, encoding="utf-8") as f:
                seen = json.load(f)
        except (OSError, ValueError):
            seen = {}
        for k, v in sorted(seen.items()):
            if isinstance(v, dict) and client_key(k) == k:
                print(f"{k}\t{v.get('last', 0)}\t{client_key(str(v.get('transport', '')))}")
    elif sub in ("-h", "--help", "help"):
        print(__doc__.split("\n\nSafety")[0])
    else:
        sys.stderr.write("usage: olymparch-mcp [stdio | http [--port N] | register [--auto] | unregister | apply | status | tools | audit [N] | clients]\n")
        return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
