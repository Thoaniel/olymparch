#!/usr/bin/env python3
"""olymparch-mcp: the whole of Olymparch as an MCP server, for AI agents (Claude Code, Hermes Agent, OpenClaw, Zeus in
Olympus) on this PC. Python 3 standard library only.

  olymparch-mcp                    MCP over stdin/stdout (what the agents start; protocol 2025-06-18)
  olymparch-mcp http [--port N]    MCP over streamable HTTP on 127.0.0.1 only, with a bearer token
                                   (olymparch-mcp.socket starts it at login; the token is in
                                   $XDG_RUNTIME_DIR/olymparch-mcp/token, 0600, never on a command line)
  olymparch-mcp register [--auto]  add the server and the skills to the agents that are installed (idempotent;
                                   --auto: only when Settings → AI agents → Register automatically is on)
  olymparch-mcp unregister         remove exactly what register added
  olymparch-mcp apply              Settings changed ai.*: the HTTP socket on/off, register/unregister
  olymparch-mcp status | tools [--tsv] | audit [N] | clients

Safety, in short (docs in default/skills/olymparch/SKILL.md and the comments below):
- Every tool maps onto an Olymparch command with a fixed argv; nothing runs through a shell, and there is no tool
  that runs a command of the agent's choosing. Every argument is checked against the tool's JSON schema first.
- Each tool has a risk: read | change | sensitive. change and sensitive ones wait for the user to answer a card in
  the shell (McpApproval.qml): «Tillat én gang», «Alltid for KLIENT/VERKTØY», «Avvis»; 60 s without an answer =
  denied; while a game runs the card is never shown and the call is denied at once. The card has no keyboard focus
  and is a layer surface: no tool here can focus, click or type into it.
- Settings → AI agents decides: the server on/off, blocked clients, a policy per tool (ask/always/never), the
  «always» grants (per client and tool), and shows the audit log (~/.local/state/olymparch/mcp-audit.log: client,
  tool, a summary of the arguments without secrets, the decision and the result, never file or clipboard content).
- The agents cannot change ai.* settings, accounts or backups through settings_set.
"""
import base64
import fcntl
import hmac
import json
import math
import os
import re
import secrets
import shutil
import socket
import stat
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

VERSION = "1.0"
PROTOCOLS = ("2025-06-18", "2025-11-25", "2025-03-26", "2024-11-05")   # the first is what we answer with otherwise
PORT = 47110
MAX_MESSAGE = 1 << 20          # bytes in one JSON-RPC message (stdio line or HTTP body)
APPROVAL_SECONDS = 60
try:   # tests make it shorter; it can never be longer
    APPROVAL_SECONDS = max(1, min(60, int(os.environ.get("OLYMPARCH_MCP_APPROVAL_SECONDS", "60"))))
except ValueError:
    pass
MAX_SESSIONS = 16              # HTTP
SHELL_DIR = "/usr/share/olymparch/shell"
SKILLS_SRC = "/usr/share/olymparch/skills"
EXE = "/usr/bin/olymparch-mcp"

SELF = os.path.realpath(__file__)
HERE = os.path.dirname(SELF)
HOME = os.path.realpath(os.path.expanduser("~"))
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "olymparch")
AUDIT = os.path.join(STATE, "mcp-audit.log")
SEEN = os.path.join(STATE, "mcp-clients.json")
MANIFEST = os.path.join(STATE, "mcp-registered.json")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or ""
RUN = os.path.join(RUNTIME, "olymparch-mcp") if RUNTIME else ""
TOKEN = os.path.join(RUN, "token") if RUN else ""
ANSWERS = os.path.join(RUN, "answers") if RUN else ""
NB = (os.environ.get("LANG") or "").startswith(("nb", "nn", "no"))


def L(en, nb):
    return nb if NB else en


def log(msg):  # stderr only: stdout belongs to the protocol
    sys.stderr.write("olymparch-mcp: " + msg + "\n")
    sys.stderr.flush()


# ──────────────────────────────────────────────────────────────────────────────────────────────── running commands
def cmd(name):
    """An Olymparch command next to this script (the repo, tests) or on PATH; a system tool on PATH."""
    if name.startswith("olymparch"):
        mine = os.path.join(HERE, name)
        if os.path.isfile(mine) and os.access(mine, os.X_OK):
            return mine
    return shutil.which(name) or name


def have(name):
    return shutil.which(name) is not None or (name.startswith("olymparch") and os.path.isfile(os.path.join(HERE, name)))


def run(argv, timeout=30, data=None, limit=262144, binary=False):
    """argv as a list, never a shell. → (exit code, stdout, stderr); stdout capped at LIMIT bytes."""
    try:
        p = subprocess.run(argv, input=data, capture_output=True, timeout=timeout, cwd=HOME,
                           stdin=None if data is not None else subprocess.DEVNULL)
    except FileNotFoundError:
        return 127, (b"" if binary else ""), f"{argv[0]}: not installed"
    except subprocess.TimeoutExpired:
        return 124, (b"" if binary else ""), f"{os.path.basename(argv[0])}: timed out after {timeout} s"
    out = p.stdout[:limit]
    err = p.stderr[:4096].decode("utf-8", "replace")
    return p.returncode, (out if binary else out.decode("utf-8", "replace")), err


def detach(argv):
    """Start a program for the user (a terminal, an app) and don't wait for it."""
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, cwd=HOME)
        return True
    except OSError:
        return False


# ──────────────────────────────────────────────────────────────────────────────────────────────── settings
def settings(*args, timeout=30):
    return run([cmd("olymparch-settings"), *args], timeout=timeout)


def setting(key, default=None):
    rc, out, _ = settings("get", key)
    if rc != 0:
        return default
    out = out.strip()
    if out in ("true", "false"):
        return out == "true"
    if out.startswith("["):
        try:
            return json.loads(out)
        except ValueError:
            return default
    return out


def schema_path():
    p = os.environ.get("OLYMPARCH_SETTINGS_SCHEMA") or "/usr/share/olymparch/settings/schema.json"
    if not os.path.isfile(p):
        p = os.path.join(HERE, "../../default/settings/schema.json")
    return p


def schema():
    with open(schema_path(), encoding="utf-8") as f:
        return json.load(f)


# Keys an agent may never set: its own permissions, the account, backups (where data goes), the terminal command.
DENIED_KEYS = re.compile(r"^(ai|account|backup)\.|^apps\.terminal$|^keyboard\.custom_keys$")

# ──────────────────────────────────────────────────────────────────────────────────────────────── secrets & audit
SECRET_KEY = re.compile(r"pass|token|secret|auth|cookie|api_?key|private", re.I)
SECRET_VALUE = re.compile(r"[A-Za-z0-9+/_=-]{32,}")


def short(v, n=60):
    s = v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)
    s = SECRET_VALUE.sub("***", s.replace("\n", " ").replace("\t", " "))
    return s if len(s) <= n else s[: n - 1] + "…"


def summarize(tool, args):
    """The arguments as one short line for the card and the log: never content, never secrets."""
    t = TOOLS.get(tool)
    if t and t.summary:
        return t.summary(args)
    parts = []
    for k, v in (args or {}).items():
        parts.append(f"{k}=***" if SECRET_KEY.search(k) else f"{k}={short(v)}")
    return ", ".join(parts)[:300]


def private_dir(path):
    """mkdir -p PATH with mode 0700, and refuse a symlink or a folder that is not ours."""
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise OSError(f"{path} is not a private folder of yours")
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)
    return path


_audit_lock = threading.Lock()


def audit(session, tool, summary, decision, result):
    entry = {"time": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "client": session.client_name,
             "transport": session.transport, "tool": tool, "args": summary, "decision": decision,
             "result": short(result, 160)}
    line = json.dumps(entry, ensure_ascii=False) + "\n"
    with _audit_lock:
        try:
            private_dir(STATE)
            fd = os.open(AUDIT, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX)
                if os.fstat(fd).st_size > 1 << 20:   # 1 MB, then one old copy
                    os.replace(AUDIT, AUDIT + ".1")
                    os.close(fd)
                    fd = os.open(AUDIT, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
                    fcntl.flock(fd, fcntl.LOCK_EX)
                os.write(fd, line.encode())
            finally:
                os.close(fd)
        except OSError as e:
            log(f"audit log: {e}")


def remember_client(session):
    """~/.local/state/olymparch/mcp-clients.json: who connected, for Settings → AI agents → Clients."""
    try:
        private_dir(STATE)
        try:
            with open(SEEN, encoding="utf-8") as f:
                seen = json.load(f)
            if not isinstance(seen, dict):
                seen = {}
        except (OSError, ValueError):
            seen = {}
        seen[session.client_name] = {"last": int(time.time()), "transport": session.transport,
                                     "title": short(session.client_title, 40)}
        if len(seen) > 50:
            for k in sorted(seen, key=lambda k: seen[k].get("last", 0))[:-50]:
                del seen[k]
        tmp = SEEN + f".{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(seen, f)
        os.replace(tmp, SEEN)
    except OSError:
        pass


# ──────────────────────────────────────────────────────────────────────────────────────────────── argument checks
CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")       # \t and \n only where a field says multiline
CONTROL_LINE = re.compile(r"[\x00-\x1f\x7f]")


class BadArgs(Exception):
    pass


def check(schema_, value, where="arguments"):
    """A small JSON Schema subset: object (properties, required, additionalProperties false), string (minLength,
    maxLength, pattern, enum, x-multiline), integer, number, boolean. Every tool schema uses only these."""
    t = schema_.get("type")
    if t == "object":
        if not isinstance(value, dict):
            raise BadArgs(f"{where}: expected an object")
        props = schema_.get("properties", {})
        for k in value:
            if k not in props:
                raise BadArgs(f"{where}: unknown argument «{short(k, 40)}»")
        for k in schema_.get("required", []):
            if k not in value:
                raise BadArgs(f"{where}: «{k}» is required")
        for k, v in value.items():
            check(props[k], v, k)
        return
    if t == "string":
        if not isinstance(value, str):
            raise BadArgs(f"{where}: expected text")
        if len(value) < schema_.get("minLength", 0) or len(value) > schema_.get("maxLength", 1000):
            raise BadArgs(f"{where}: length must be {schema_.get('minLength', 0)}–{schema_.get('maxLength', 1000)}")
        if (CONTROL if schema_.get("x-multiline") else CONTROL_LINE).search(value):
            raise BadArgs(f"{where}: control characters are not allowed")
        if "enum" in schema_ and value not in schema_["enum"]:
            raise BadArgs(f"{where}: expected one of {', '.join(schema_['enum'])}")
        if "pattern" in schema_ and not re.fullmatch(schema_["pattern"], value):
            raise BadArgs(f"{where}: not a valid value")
        return
    if t in ("integer", "number"):
        ok = isinstance(value, int) and not isinstance(value, bool)
        if t == "number":
            ok = ok or (isinstance(value, float) and math.isfinite(value))
        if not ok:
            raise BadArgs(f"{where}: expected {'a whole number' if t == 'integer' else 'a number'}")
        if value < schema_.get("minimum", -math.inf) or value > schema_.get("maximum", math.inf):
            raise BadArgs(f"{where}: must be {schema_.get('minimum')}–{schema_.get('maximum')}")
        return
    if t == "boolean":
        if not isinstance(value, bool):
            raise BadArgs(f"{where}: expected true or false")
        return
    raise BadArgs(f"{where}: unsupported schema")


# ──────────────────────────────────────────────────────────────────────────────────────────────── tools
class Tool:
    def __init__(self, name, risk, title, fn, description, props, required, summary, hints):
        self.name, self.risk, self.title, self.fn = name, risk, title, fn
        self.description, self.summary, self.hints = description, summary, hints
        self.schema = {"type": "object", "properties": props, "required": list(required), "additionalProperties": False}

    def listing(self):
        h = self.hints
        return {
            "name": self.name,
            "title": self.title[0],
            "description": f"[{self.risk}] " + self.description + (
                "" if self.risk == "read" else " The user must approve this call on their screen (up to 60 s); a "
                "denial is final for this request: do not retry it at once."),
            "inputSchema": public_schema(self.schema),
            # destructiveHint follows the risk (true = sensitive, false = change), as Olympus reads it
            "annotations": {"title": self.title[0], "readOnlyHint": self.risk == "read",
                            "destructiveHint": self.risk == "sensitive", "idempotentHint": h.get("idempotent", False),
                            "openWorldHint": h.get("open_world", False), "risk": self.risk},
            "risk": self.risk,
            "_meta": {"risk": self.risk, "olymparch/risk": self.risk},
        }


TOOLS = {}


def public_schema(sch):
    """The schema as clients see it: without our own x-… keywords."""
    if isinstance(sch, dict):
        return {k: public_schema(v) for k, v in sch.items() if not k.startswith("x-")}
    return sch


def tool(name, risk, title_en, title_nb, description, props=None, required=(), summary=None, **hints):
    assert risk in ("read", "change", "sensitive") and re.fullmatch(r"[a-z][a-z0-9_]{0,47}", name)

    def deco(fn):
        TOOLS[name] = Tool(name, risk, (title_en, title_nb), fn, description, props or {}, required, summary, hints)
        return fn
    return deco


class ToolError(Exception):
    """A tool ran but failed: returned to the agent as a result with isError."""


def text(s):
    return {"content": [{"type": "text", "text": s if s.strip() else L("(nothing)", "(ingenting)")}]}


def ran(rc_out_err, ok_codes=(0,)):
    rc, out, err = rc_out_err
    if rc not in ok_codes:
        raise ToolError((err.strip() or out.strip() or f"exit code {rc}")[:2000])
    return text(out.rstrip() + (("\n" + err.strip()) if err.strip() and rc != 0 else ""))


def S(maxlen=200, pattern=None, desc="", enum=None, minlen=0, multiline=False):
    d = {"type": "string", "maxLength": maxlen, "minLength": minlen}
    if pattern:
        d["pattern"] = pattern
    if enum:
        d["enum"] = list(enum)
    if desc:
        d["description"] = desc
    if multiline:
        d["x-multiline"] = True
    return d


def I(lo, hi, desc=""):
    return {"type": "integer", "minimum": lo, "maximum": hi, **({"description": desc} if desc else {})}


KEY = r"[a-z][a-z0-9_]*\.[a-z0-9_.]+(@[A-Za-z0-9_.-]{1,40})?"
ADDRESS = r"0x[0-9a-f]{1,16}"

# ── system
@tool("system_info", "read", "System information", "Systeminformasjon",
      "Olymparch version, CPU, graphics, memory, kernel, disk and monitors (olymparch-settings about).")
def t_system_info(a, s):
    return ran(settings("about"))


@tool("system_doctor", "read", "Check the system", "Sjekk systemet",
      "Runs olymparch doctor: one ✓/✗ line per check (Hyprland, shell, sound, settings, disk space, snapshots, "
      "network, failed services). Use it first when something is wrong.")
def t_doctor(a, s):
    rc, out, err = run([cmd("olymparch-doctor")], timeout=90)
    if rc == 127:
        raise ToolError(err)
    return text(out)


@tool("hardware_plan", "read", "Hardware and drivers", "Maskinvare og drivere",
      "What olymparch-hw found (CPU, GPU, rules that match, drivers they need): olymparch-hw plan --summary.")
def t_hw(a, s):
    return ran(run([cmd("olymparch-hw"), "plan", "--summary"], timeout=60))


# ── settings
@tool("settings_list", "read", "List settings", "Vis innstillinger",
      "Every setting: key, value, page, label. Optionally only one page (display, audio, appearance, keyboard, "
      "notifications, …). Read the resource olymparch://settings/schema for types, options and limits.",
      {"page": S(32, r"[a-z_]{1,32}", "a page id, such as appearance")})
def t_settings_list(a, s):
    return ran(settings("list", *([a["page"]] if a.get("page") else [])))


@tool("settings_get", "read", "Read a setting", "Les en innstilling",
      "The value of one setting (yours, or the default). Per-monitor keys take @OUTPUT, like display.scale@DP-1.",
      {"key": S(80, KEY)}, ("key",))
def t_settings_get(a, s):
    return ran(settings("get", a["key"]))


def _settable(key):
    if DENIED_KEYS.search(key):
        raise ToolError(L(f"{key} can only be changed by the user in Settings", f"{key} kan bare endres av brukeren i Innstillinger"))


@tool("settings_set", "change", "Change a setting", "Endre en innstilling",
      "Store and apply one setting through olymparch-settings (validated against the schema; a bad value is "
      "refused). Values are text: on/off for switches, numbers as digits. Not allowed: ai.*, account.*, backup.*, "
      "apps.terminal and your own shortcuts.",
      {"key": S(80, KEY), "value": S(200, desc="the new value as text")}, ("key", "value"),
      summary=lambda a: f"{a.get('key')} = {'***' if SECRET_KEY.search(a.get('key', '')) else short(a.get('value', ''), 80)}",
      idempotent=True)
def t_settings_set(a, s):
    _settable(a["key"])
    rc, out, err = settings("set", a["key"], a["value"], timeout=120)
    if rc != 0:
        raise ToolError(err.strip().replace("olymparch-settings: ", "") or f"exit code {rc}")
    return text(out.strip() or L(f"{a['key']} is now {a['value']}", f"{a['key']} er nå {a['value']}"))


@tool("settings_reset", "change", "Reset a setting", "Tilbakestill en innstilling",
      "Put one setting back to its default.", {"key": S(80, KEY)}, ("key",), idempotent=True)
def t_settings_reset(a, s):
    _settable(a["key"])
    return ran(settings("reset", a["key"], timeout=120))


# ── look: themes and backgrounds
@tool("themes_list", "read", "List themes", "Vis temaer",
      "The themes (built-in and installed) as JSON, and which one is in use (olymparch-theme list --json).")
def t_themes(a, s):
    if not have("olymparch-theme"):
        raise ToolError(L("themes need olymparch-theme (update Olymparch)", "temaer trenger olymparch-theme (oppdater Olymparch)"))
    return ran(run([cmd("olymparch-theme"), "list", "--json"]))


@tool("theme_set", "change", "Change theme", "Bytt tema", "Use a theme by its id (from themes_list).",
      {"id": S(40, r"[a-z0-9][a-z0-9_-]{0,39}")}, ("id",), idempotent=True)
def t_theme_set(a, s):
    if not have("olymparch-theme"):
        raise ToolError(L("themes need olymparch-theme (update Olymparch)", "temaer trenger olymparch-theme (oppdater Olymparch)"))
    return ran(run([cmd("olymparch-theme"), "set", a["id"]], timeout=60))


def _wallpaper_entry():
    for e in schema().get("settings", []):
        if e.get("key") == "appearance.wallpaper":
            return e
    raise ToolError("appearance.wallpaper is missing from the schema")


@tool("backgrounds_list", "read", "List backgrounds", "Vis bakgrunner",
      "The live wallpaper choices (appearance.wallpaper) and the one in use.")
def t_backgrounds(a, s):
    e = _wallpaper_entry()
    cur = setting("appearance.wallpaper", e.get("default"))
    lines = [f"{'*' if o['value'] == cur else ' '} {o['value']}\t{o['label'].get('nb' if NB else 'en', o['value'])}"
             for o in e.get("options", [])]
    return text("\n".join(lines))


@tool("background_set", "change", "Change background", "Bytt bakgrunn",
      "Use one of the wallpaper choices from backgrounds_list.", {"value": S(40, r"[a-z0-9_-]{1,40}")}, ("value",),
      idempotent=True)
def t_background_set(a, s):
    if a["value"] not in [o["value"] for o in _wallpaper_entry().get("options", [])]:
        raise ToolError(L("not one of the backgrounds (backgrounds_list)", "ikke en av bakgrunnene (backgrounds_list)"))
    return ran(settings("set", "appearance.wallpaper", a["value"]))


# ── windows and workspaces (Hyprland). Only real windows (hyprctl clients): the shell's layers (bar, notifications,
#    the approval card) are not windows and can never be focused, moved or closed from here.
def hypr_json(what):
    rc, out, err = run(["hyprctl", "-j", what])
    if rc != 0:
        raise ToolError(err.strip() or "Hyprland is not running")
    try:
        return json.loads(out)
    except ValueError:
        raise ToolError("hyprctl gave no JSON") from None


def hypr_dispatch(lua):
    rc, out, err = run(["hyprctl", "dispatch", lua])
    if rc != 0 or out.strip().lower().startswith(("error", "invalid", "unknown")):
        raise ToolError((err.strip() or out.strip() or "dispatch failed")[:400])


def _window(address):
    for c in hypr_json("clients"):
        if isinstance(c, dict) and c.get("address") == address and c.get("mapped", True):
            return c
    raise ToolError(L(f"no window {address} (windows_list)", f"ingen vindu {address} (windows_list)"))


@tool("windows_list", "read", "List windows", "Vis vinduer",
      "Open windows: address, app class, title, workspace, monitor, floating, fullscreen, focused.", open_world=True)
def t_windows(a, s):
    out = []
    for c in hypr_json("clients"):
        if not isinstance(c, dict) or not c.get("mapped", True):
            continue
        out.append({"address": c.get("address"), "class": c.get("class"), "title": short(c.get("title") or "", 120),
                    "workspace": (c.get("workspace") or {}).get("id"), "monitor": c.get("monitor"),
                    "floating": c.get("floating"), "fullscreen": bool(c.get("fullscreen")),
                    "focused": c.get("focusHistoryID") == 0})
    return {"content": [{"type": "text", "text": json.dumps(out, ensure_ascii=False, indent=1)}],
            "structuredContent": {"windows": out}}


@tool("workspaces_list", "read", "List workspaces", "Vis arbeidsflater",
      "Workspaces with their monitor and number of windows, and the active one.")
def t_workspaces(a, s):
    ws = [{"id": w.get("id"), "name": w.get("name"), "monitor": w.get("monitor"), "windows": w.get("windows")}
          for w in hypr_json("workspaces") if isinstance(w, dict)]
    active = hypr_json("activeworkspace").get("id")
    res = {"workspaces": ws, "active": active}
    return {"content": [{"type": "text", "text": json.dumps(res, ensure_ascii=False)}], "structuredContent": res}


@tool("window_focus", "change", "Focus a window", "Gi et vindu fokus", "Focus a window by its address (windows_list).",
      {"address": S(18, ADDRESS)}, ("address",), summary=lambda a: a.get("address", ""), idempotent=True)
def t_window_focus(a, s):
    c = _window(a["address"])
    hypr_dispatch(f'hl.dsp.focus({{ window = "address:{a["address"]}" }})')
    return text(L(f"focused {c.get('class')}", f"fokus på {c.get('class')}"))


@tool("window_move", "change", "Move a window", "Flytt et vindu", "Move a window to workspace 1–10.",
      {"address": S(18, ADDRESS), "workspace": I(1, 10)}, ("address", "workspace"), idempotent=True)
def t_window_move(a, s):
    c = _window(a["address"])
    hypr_dispatch(f'hl.dsp.window.move({{ workspace = {int(a["workspace"])}, window = "address:{a["address"]}" }})')
    return text(L(f"moved {c.get('class')} to workspace {a['workspace']}", f"flyttet {c.get('class')} til arbeidsflate {a['workspace']}"))


@tool("window_close", "change", "Close a window", "Lukk et vindu",
