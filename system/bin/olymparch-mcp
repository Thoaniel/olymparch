# ── apps: the same .desktop entries the menu shows
def desktop_entries():
    dirs = [os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "applications")]
    for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":"):
        if d:
            dirs.append(os.path.join(d, "applications"))
    dirs += ["/var/lib/flatpak/exports/share/applications", os.path.join(HOME, ".local/share/flatpak/exports/share/applications")]
    found = {}
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for root, _, files in os.walk(d):
            for f in files:
                if not f.endswith(".desktop"):
                    continue
                rel = os.path.relpath(os.path.join(root, f), d).replace("/", "-")
                if rel in found:
                    continue   # the first directory wins, like the menu
                found[rel] = os.path.join(root, f)
    apps = {}
    for app_id, path in found.items():
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                head = fh.read(65536)
        except OSError:
            continue
        fields, section = {}, None
        for line in head.splitlines():
            if line.startswith("["):
                section = line.strip()
                continue
            if section == "[Desktop Entry]" and "=" in line:
                k, v = line.split("=", 1)
                fields.setdefault(k.strip(), v.strip())
        if fields.get("Type") != "Application" or fields.get("NoDisplay") == "true" or fields.get("Hidden") == "true":
            continue
        name = fields.get("Name[nb]" if NB else "Name") or fields.get("Name") or app_id
        apps[app_id] = {"id": app_id, "name": short(name, 60), "comment": short(fields.get("Comment", ""), 100), "path": path}
    return apps


@tool("apps_list", "read", "List apps", "Vis apper", "Apps in the menu: id (the .desktop file), name, comment.",
      {"query": S(60, desc="only apps whose name or id contains this")})
def t_apps(a, s):
    q = (a.get("query") or "").lower()
    apps = sorted((x for x in desktop_entries().values() if q in x["name"].lower() or q in x["id"].lower()),
                  key=lambda x: x["name"].lower())[:300]
    return text("\n".join(f"{x['id']}\t{x['name']}\t{x['comment']}" for x in apps))


@tool("app_launch", "change", "Start an app", "Start en app", "Start an app from the menu by its id (apps_list).",
      {"id": S(120, r"[A-Za-z0-9._+-]{1,112}\.desktop")}, ("id",), open_world=True)
def t_app_launch(a, s):
    app = desktop_entries().get(a["id"])
    if not app:
        raise ToolError(L("no such app (apps_list)", "fant ikke appen (apps_list)"))
    if have("gio") and detach(["gio", "launch", app["path"]]):
        return text(L(f"started {app['name']}", f"startet {app['name']}"))
    if have("gtk-launch") and detach(["gtk-launch", a["id"]]):
        return text(L(f"started {app['name']}", f"startet {app['name']}"))
    raise ToolError("neither gio nor gtk-launch is installed")


