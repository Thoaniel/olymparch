@tool("updates_check", "read", "Check for updates", "Se etter oppdateringer",
      "Which packages can be updated (checkupdates with its own database copy: nothing on the system changes).",
      open_world=True)
def t_updates(a, s):
    if not have("checkupdates"):
        raise ToolError("checkupdates (pacman-contrib) is missing")
    db = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "olymparch/checkup-db")
    os.makedirs(db, exist_ok=True)
    env_rc = subprocess.run(["checkupdates"], capture_output=True, timeout=180, cwd=HOME, stdin=subprocess.DEVNULL,
                            env={**os.environ, "CHECKUPDATES_DB": db})
    if env_rc.returncode == 2:
        return text(L("no updates", "ingen oppdateringer"))
    if env_rc.returncode != 0:
        raise ToolError(env_rc.stderr.decode("utf-8", "replace")[:400] or "checkupdates failed")
    return text(env_rc.stdout.decode("utf-8", "replace")[:65536])


