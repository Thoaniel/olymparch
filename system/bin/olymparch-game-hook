#!/bin/bash
# Games without launch options. Called by Hyprland and gamemoded, never by hand:
#   olymparch-game-hook window ADDRESS [PID]   a window opened: is it a game? Then register it with gamemode
#   olymparch-game-hook start | end            gamemode's [custom] hooks: spillmodus on/off (returns at once)
# A game is found by its process tree and environment, not the window class (Wine-Wayland games have none):
# Steam's `reaper SteamLaunch AppId=N`, SteamAppId/STEAM_COMPAT_APP_ID, HEROIC_APP_NAME, umu-run, an emulator,
# or a program in ~/.config/olymparch/games.conf.
set -euo pipefail
share=/usr/share/olymparch/games
conf=${XDG_CONFIG_HOME:-$HOME/.config}/olymparch/games.conf
run=${XDG_RUNTIME_DIR:-/tmp}/olymparch/games
log=${XDG_STATE_HOME:-$HOME/.local/state}/olymparch/games.log
mkdir -p "$run" "${log%/*}"
say() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$log"; }

listed() {  # listed NAME FILE...: NAME is a line in one of the files (comments and blanks ignored)
    local name=$1; shift
    [ -n "$name" ] && grep -qxF -- "$name" < <(sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$@" 2>/dev/null)
}

uid=$(id -u)
mine() {  # mine PID: a live process of this user. Nothing of another user's is ever read or registered.
    [[ $1 =~ ^[0-9]+$ ]] && [ "$1" -gt 1 ] && [ "$(stat -c %u "/proc/$1" 2>/dev/null)" = "$uid" ]
}

# find_game PID: walk up from the window's process. Prints "KIND APPID PID" for the first match.
# The walk stops at the first process that is not ours (the login, root daemons).
find_game() {
    local p=$1 comm cmd env id exe
    while mine "$p"; do
        comm=$(<"/proc/$p/comm")
        case $comm in
            steam | steamwebhelper | Hyprland | quickshell | qs) return 1 ;;   # the Steam client itself, the desktop
        esac
        cmd=$(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null || true)
        if [ "$comm" = reaper ] && [[ $cmd == *SteamLaunch* && $cmd =~ AppId=([0-9]{1,10})( |$) ]]; then
            echo "steam ${BASH_REMATCH[1]} $p"; return 0
        fi
        env=$(tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null || true)
        id=$(sed -nE 's/^(SteamAppId|STEAM_COMPAT_APP_ID)=([0-9]{1,10})$/\2/p' <<<"$env" | grep -vx 0 | head -n 1 || true)
        if [ -n "$id" ]; then echo "steam $id $p"; return 0; fi
        if grep -q '^HEROIC_APP_NAME=.' <<<"$env"; then echo "heroic - $p"; return 0; fi
        if [[ $cmd == *umu-run* ]]; then echo "umu - $p"; return 0; fi
        exe=$(readlink "/proc/$p/exe" 2>/dev/null || true)
        if listed "$comm" "$share/emulators.conf" || listed "${exe##*/}" "$share/emulators.conf"; then
            echo "emu - $p"; return 0
        fi
        if listed "$comm" "$conf" || listed "${exe##*/}" "$conf"; then echo "user - $p"; return 0; fi
        p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null || echo 0)
    done
    return 1
}

register() {  # register PID: gamemoded keeps it until the process is gone (checked every 5 s)
    busctl --user call com.feralinteractive.GameMode /com/feralinteractive/GameMode \
        com.feralinteractive.GameMode RegisterGameByPID ii $$ "$1" >/dev/null 2>&1
}

spillmodus() {  # spillmodus on|off, in the background: gamemoded waits for us (script_timeout 10 s)
    local state=$1
    (
        qs ipc -p /usr/share/olymparch/shell call olymparch gamemode "$state" >/dev/null 2>&1 || true
        # Other parts (Olympus unloads its local model) drop an executable here; called with start|end
        for h in /etc/olymparch/game.d/* "${XDG_CONFIG_HOME:-$HOME/.config}"/olymparch/game.d/*; do
            [ -x "$h" ] && timeout 30 "$h" "$([ "$state" = on ] && echo start || echo end)" >/dev/null 2>&1 &
        done
        wait
    ) </dev/null >/dev/null 2>&1 &
    disown
}

case ${1:-} in
    window)
        addr=${2:-} pid=${3:-}
        if ! [[ $pid =~ ^[0-9]+$ ]] || [ "$pid" -le 1 ]; then
            pid=$(hyprctl clients | awk -v a="Window ${addr#0x} " 'index($0, a) == 1 {f = 1} f && $1 == "pid:" {print $2; exit}')
        fi
        [[ ${pid:-} =~ ^[0-9]+$ ]] || exit 0
        if ! mine "$pid"; then say "ignored window=$addr pid=$pid: not this user's process"; exit 0; fi
        read -r kind appid gpid < <(find_game "$pid") || exit 0
        [[ $appid == - || $appid =~ ^[0-9]{1,10}$ ]] || exit 0
        say "game: $kind appid=$appid window=$addr pid=$pid (found at $gpid)"
        # The window's own process is the game; it is what gamemode should tune
        { mine "$pid" && register "$pid"; } || say "gamemode: could not register $pid"
        # The Proton watcher needs to know this game reached a window
        [ "$appid" != - ] && date +%s >"$run/$appid.window"
        ;;
    start) say "spillmodus on"; spillmodus on ;;
    end) say "spillmodus off"; spillmodus off ;;
    *) echo "bruk: olymparch-game-hook window ADRESSE [PID] | start | end" >&2; exit 2 ;;
esac
