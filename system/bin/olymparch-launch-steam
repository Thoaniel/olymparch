#!/bin/bash
# Start Steam the Olymparch way (the Steam menu entry runs this):
# 1. Proton changes queued since Steam last ran go into its config.vdf (Steam rewrites that file when it exits).
# 2. The watcher that notices games crashing early (olymparch-game watch) starts.
# 3. Steam runs under MangoHud: every game gets it, hidden until Shift+F12. No global MANGOHUD=1, which crashes
#    some Vulkan apps outside games.
set -euo pipefail
if ! pgrep -u "$(id -u)" -x steam >/dev/null; then
    olymparch-proton apply || true
fi
setsid -f olymparch-game watch </dev/null >/dev/null 2>&1
user_conf=${XDG_CONFIG_HOME:-$HOME/.config}/MangoHud/MangoHud.conf
settings_conf=${XDG_CONFIG_HOME:-$HOME/.config}/olymparch/MangoHud.conf   # Settings → Games (shown, FPS cap)
if [ ! -f "$user_conf" ] && [ -f "$settings_conf" ]; then
    export MANGOHUD_CONFIGFILE=$settings_conf
elif [ ! -f "$user_conf" ] && [ -f /usr/share/olymparch/games/MangoHud.conf ]; then
    export MANGOHUD_CONFIGFILE=/usr/share/olymparch/games/MangoHud.conf
fi
mangohud=$(olymparch-settings get games.mangohud 2>/dev/null || echo hidden)
# Settings → Games → gamescope: Steam (and so every game) runs nested in gamescope, MangoHud through its mangoapp
if [ "$(olymparch-settings get games.gamescope 2>/dev/null)" = true ] && command -v gamescope >/dev/null; then
    if [ "$mangohud" != off ] && command -v mangoapp >/dev/null; then exec gamescope --mangoapp -e -- /usr/bin/steam "$@"; fi
    exec gamescope -e -- /usr/bin/steam "$@"
fi
mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/olymparch/mangohud"
if [ "$mangohud" != off ] && command -v mangohud >/dev/null; then exec mangohud /usr/bin/steam "$@"; fi
exec /usr/bin/steam "$@"
