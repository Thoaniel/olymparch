#!/usr/bin/lua
-- olymparch-settings: read, change and apply Olymparch settings. The Settings window, Zeus and you use the same
-- command. Values live in ~/.config/olymparch/settings.json; what each key does is in the schema
-- (/usr/share/olymparch/settings/schema.json). Lua because Hyprland already needs it: no extra packages.
--
--   olymparch-settings get KEY                 value (yours, or the default)
--   olymparch-settings set KEY VALUE [--try S] store and apply; --try applies live and reverts after S seconds
--   olymparch-settings keep | revert           answer a --try
--   olymparch-settings reset KEY               back to the default
--   olymparch-settings list [PAGE]             key, value, page, (coming) for every setting
--   olymparch-settings apply [KEY]             write every file again (or the files for KEY) and apply live
--   olymparch-settings run KEY                 run an action (Update now, doctor …)
--   olymparch-settings open [PAGE]             open the Settings window
--   olymparch-settings profiles                the saved layout of every monitor combination (* = in use)
--   olymparch-settings monitors-changed        apply the layout for the monitors connected now (Hyprland runs it)
--   olymparch-settings items KEY [--scan]      Wi-Fi networks, Bluetooth devices; pick KEY ID connects
--   olymparch-settings choices KEY | missing   what a choice can be here; settings this machine can't use
--   olymparch-settings view NAME              disks, libraries, mounts, subvolumes, snapshots, kernel, overdrive,
--                                             firmware, games, proton, proton-games, zeus (read-only)
--   olymparch-settings zeus-install | zeus-setup   in a terminal (Settings → Zeus); never downloads a model
--   olymparch-settings about | files | check | pending | wired
-- Per-monitor keys take the output after @, such as display.scale@DP-1.

local HOME = os.getenv("HOME") or "."
local CONFIG = os.getenv("XDG_CONFIG_HOME") or (HOME .. "/.config")
local RUNTIME = os.getenv("XDG_RUNTIME_DIR") or (HOME .. "/.local/state/olymparch")   -- never a shared /tmp
local SELF = arg[0]

local function script_dir() return (SELF:match("^(.*)/[^/]*$") or ".") end
local ZEUS_COMMIT = "741dbb0520f3ebffed781d2e0b135e37d1e42d64"   -- the Olympus release the installer uses too
local SCHEMA = os.getenv("OLYMPARCH_SETTINGS_SCHEMA") or "/usr/share/olymparch/settings/schema.json"
do -- running from the repo (tests): use the schema next to it
    local f = io.open(SCHEMA)
    if f then f:close() else SCHEMA = script_dir() .. "/../../default/settings/schema.json" end
end
local FILES = {
    settings = CONFIG .. "/olymparch/settings.json",
    hypr = CONFIG .. "/olymparch/hypr.lua",
    monitors = CONFIG .. "/olymparch/monitors.lua",
    idle = CONFIG .. "/hypr/hypridle.conf",
    hyprland = CONFIG .. "/hypr/hyprland.lua",
    pending = RUNTIME .. "/olymparch-settings-pending.json",
}

local function die(msg, code) io.stderr:write("olymparch-settings: " .. msg .. "\n"); os.exit(code or 1) end

---------------------------------------------------------------------------------------------------- JSON
local json = {}
do
    local esc = { ['"'] = '\\"', ["\\"] = "\\\\", ["\b"] = "\\b", ["\f"] = "\\f", ["\n"] = "\\n", ["\r"] = "\\r", ["\t"] = "\\t" }
    local function str(s) return '"' .. s:gsub('[%c"\\]', function(c) return esc[c] or string.format("\\u%04x", c:byte()) end) .. '"' end
    function json.value(v)
        local t = type(v)
        if t == "string" then return str(v)
        elseif t == "boolean" then return tostring(v)
        elseif t == "number" then
            if math.type(v) == "integer" or (v == math.floor(v) and math.abs(v) < 1e15) then return string.format("%d", v) end
            return string.format("%.14g", v)
        elseif v == nil then return "null" end
        die("cannot write " .. t .. " as JSON")
    end
    -- settings.json is one flat object: one key per line, sorted, so it diffs well
    function json.flat(obj)
        local keys = {}
        for k in pairs(obj) do keys[#keys + 1] = k end
        table.sort(keys)
        local out = {}
        for i, k in ipairs(keys) do out[i] = "  " .. str(k) .. ": " .. json.value(obj[k]) end
        return #out > 0 and ("{\n" .. table.concat(out, ",\n") .. "\n}\n") or "{}\n"
    end
    function json.decode(s)
        local pos = 1
        local function ws() pos = s:find("[^ \t\r\n]", pos) or #s + 1 end
        local value
        local function err(what) error(("JSON: %s at byte %d"):format(what, pos), 0) end
        local function string_()
            local out, i = {}, pos + 1
            while true do
                local c = s:sub(i, i)
                if c == "" then err("unterminated string") end
                if c == '"' then pos = i + 1; return table.concat(out) end
                if c == "\\" then
                    local n = s:sub(i + 1, i + 1)
                    local map = { b = "\b", f = "\f", n = "\n", r = "\r", t = "\t", ['"'] = '"', ["\\"] = "\\", ["/"] = "/" }
                    if map[n] then out[#out + 1] = map[n]; i = i + 2
                    elseif n == "u" then
                        local cp = tonumber(s:sub(i + 2, i + 5), 16) or err("bad \\u")
                        i = i + 6
                        if cp >= 0xD800 and cp <= 0xDBFF and s:sub(i, i + 1) == "\\u" then
                            local lo = tonumber(s:sub(i + 2, i + 5), 16)
                            cp = 0x10000 + (cp - 0xD800) * 0x400 + (lo - 0xDC00)
                            i = i + 6
                        end
                        out[#out + 1] = utf8.char(cp)
                    else err("bad escape") end
                else
                    local j = s:find('["\\]', i) or #s + 1
                    out[#out + 1] = s:sub(i, j - 1); i = j
                end
            end
        end
        function value()
            ws()
            local c = s:sub(pos, pos)
            if c == "{" then
                local obj = {}
                pos = pos + 1; ws()
                if s:sub(pos, pos) == "}" then pos = pos + 1; return obj end
                while true do
                    ws()
                    if s:sub(pos, pos) ~= '"' then err("expected key") end
                    local k = string_()
                    ws()
                    if s:sub(pos, pos) ~= ":" then err("expected :") end
                    pos = pos + 1
                    obj[k] = value()
                    ws()
                    local d = s:sub(pos, pos); pos = pos + 1
                    if d == "}" then return obj end
                    if d ~= "," then err("expected , or }") end
                end
            elseif c == "[" then
                local arr = {}
                pos = pos + 1; ws()
                if s:sub(pos, pos) == "]" then pos = pos + 1; return arr end
                while true do
                    arr[#arr + 1] = value()
                    ws()
                    local d = s:sub(pos, pos); pos = pos + 1
                    if d == "]" then return arr end
                    if d ~= "," then err("expected , or ]") end
                end
            elseif c == '"' then return string_()
            elseif s:sub(pos, pos + 3) == "true" then pos = pos + 4; return true
            elseif s:sub(pos, pos + 4) == "false" then pos = pos + 5; return false
            elseif s:sub(pos, pos + 3) == "null" then pos = pos + 4; return nil
            else
                local num = s:match("^-?%d+%.?%d*[eE]?[-+]?%d*", pos)
                if not num or num == "" then err("unexpected " .. (c ~= "" and c or "end")) end
                pos = pos + #num
                return math.tointeger(tonumber(num)) or tonumber(num)
            end
        end
        local v = value()
        ws()
        if pos <= #s then err("trailing data") end
        return v
    end
end

---------------------------------------------------------------------------------------------------- files
local function read(path)
    local f = io.open(path, "rb")
    if not f then return nil end
    local s = f:read("a"); f:close()
    return s
end
local function sh_quote(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end
local function capture(cmd)
    local p = io.popen(cmd .. " 2>/dev/null")
    if not p then return "" end
    local s = p:read("a") or ""; p:close()
    return s
end
-- atomic: a crash never leaves half a file. The temp file is made by mktemp next to the target (same directory,
-- unpredictable name), so nobody can plant a symlink for it.
local function write(path, text)
    local dir, name = path:match("^(.*)/([^/]+)$")
    os.execute("mkdir -p " .. sh_quote(dir))
    local tmp = capture("mktemp " .. sh_quote(dir .. "/." .. name .. ".XXXXXX")):gsub("%s+$", "")
    if tmp == "" then die("cannot write " .. path) end
    local f = assert(io.open(tmp, "wb"))
    f:write(text); f:close()
    if not os.rename(tmp, path) then os.remove(tmp); die("cannot write " .. path) end
end
local function have(cmd) return os.execute("command -v " .. cmd .. " >/dev/null 2>&1") == true end

local schema
do
    local text = read(SCHEMA) or die("schema not found: " .. SCHEMA)
    local ok, v = pcall(json.decode, text)
    if not ok then die(SCHEMA .. ": " .. v) end
    schema = v
end
local byKey = {}
for _, s in ipairs(schema.settings) do byKey[s.key] = s end

-- Is V a valid value for setting S (on OUTPUT)? Everything that ends up in Lua, conf files or commands passes
-- here first, whether it came from the command line, settings.json (hand-edited, Zeus) or the pending file.
local PATTERNS = {   -- strings from the hardware, and free text that goes into Hyprland
    ["monitor.resolutions"] = "^%d+x%d+$", ["monitor.rates"] = "^%d+%.?%d*$", monitors = "^[%w_.-]+$",
    ["audio.sinks"] = "^[%w_.:-]*$", ["audio.sources"] = "^[%w_.:-]*$",
    ["display.position"] = "^%-?%d+x%-?%d+$", ["keyboard.variant"] = "^[%w_,-]*$", ["keyboard.model"] = "^[%w_-]*$",
    ["keyboard.options"] = "^[%w_,:-]*$",
}
-- Shortcuts (keys.*): "SUPER + SHIFT + G" — modifiers from MODS, then one key name. "" = no shortcut.
-- A key without a modifier is only allowed for keys that type nothing (F1, Print, XF86…).
local MODS = { SUPER = 1, CTRL = 2, ALT = 3, SHIFT = 4 }
local function combo_parts(v)
    if v == "" then return {}, nil end
    local parts = {}
    for p in (v .. "+"):gmatch("%s*([^+]-)%s*%+") do parts[#parts + 1] = p end
    if #parts == 0 or #parts > 5 then return nil end
    local key = table.remove(parts)
    local seen = {}
    for i, m in ipairs(parts) do
        m = m:upper():gsub("^CONTROL$", "CTRL"):gsub("^MOD4$", "SUPER"):gsub("^WIN$", "SUPER")
        if not MODS[m] or seen[m] then return nil end
        seen[m] = true; parts[i] = m
    end
    if not key:match("^[%w_]+$") and not key:match("^mouse:%d+$") or #key > 32 then return nil end
    if #parts == 0 and not (key:match("^[Ff]%d+$") or key:match("^XF86") or key:upper() == "PRINT" or key:upper() == "PAUSE") then return nil end
    table.sort(parts, function(a, b) return MODS[a] < MODS[b] end)
    return parts, key
end
local function combo_text(v)  -- canonical: mods in a fixed order, letters upper case
    local mods, key = combo_parts(v)
    if not mods then return nil end
    if not key then return "" end
    if #key == 1 or not key:match("^XF86") then key = key:upper() end
    mods[#mods + 1] = key
    return table.concat(mods, " + ")
end

local function valid(s, v, out)
    if out and not out:match("^[%w_.-]+$") then return false, "bad output name" end
    if s.widget == "keys" then
        return type(v) == "string" and combo_text(v) == v, "expected a shortcut like SUPER + SHIFT + G"
    end
    if s.readonly or s.type == "action" then return false, "cannot be set" end
    if s.type == "bool" then return type(v) == "boolean", "expected on or off" end
    if s.type == "number" then
        if type(v) ~= "number" or v ~= v then return false, "expected a number" end
        if (s.min and v < s.min) or (s.max and v > s.max) then return false, ("outside %s–%s"):format(s.min, s.max) end
        return true
    end
    if type(v) ~= "string" then return false, "expected text" end
    if s.options_from == "desktop" then   -- default apps: a desktop file name, or "" for the system's choice
        return v == "" or (#v <= 120 and v:match("^[%w_.%-]+%.desktop$") ~= nil), "expected a .desktop file name"
    end
    for _, o in ipairs(s.options or {}) do if o.value == v then return true end end
    if s.type == "choice" and not s.options_from then
        local list = {}
        for _, o in ipairs(s.options or {}) do list[#list + 1] = o.value end
        return false, "expected one of " .. table.concat(list, ", ")
    end
    local pat = PATTERNS[s.key] or PATTERNS[s.options_from or ""]
    if s.key == "display.position" and v == "auto" then return true end
    if pat then return v:match(pat) ~= nil, "not a valid value" end
    return #v <= 200 and not v:find("[%c\\]"), "text must be one line, without control characters"
end

local function load_values()
    local text = read(FILES.settings)
    if not text or text:match("^%s*$") then return {} end
    local ok, v = pcall(json.decode, text)
    if not ok or type(v) ~= "table" then die(FILES.settings .. " is not valid JSON (" .. tostring(v) .. "); fix or delete it") end
    for k, x in pairs(v) do   -- drop what the schema doesn't allow, so it can never reach a file or a command
        local base, out = k:match("^([^@]+)@?(.*)$")
        local s = byKey[base]
        local good, why = false, "unknown setting"
        if s and (out ~= "") == (s.per == "monitor") then good, why = valid(s, x, out ~= "" and out or nil) end
        if not good then
            io.stderr:write(("olymparch-settings: ignoring %s in %s: %s\n"):format(k, FILES.settings, why))
            v[k] = nil
        end
    end
    return v
end
local SHELL = "/usr/share/olymparch/shell"
local function shell_call_target(target, ...)  -- one of the running shell's IpcHandlers
    if not os.getenv("WAYLAND_DISPLAY") then return end
    local args = {}
    for i, a in ipairs({ ... }) do args[i] = sh_quote(a) end
    os.execute("qs ipc -p " .. SHELL .. " call " .. sh_quote(target) .. " " .. table.concat(args, " ") .. " >/dev/null 2>&1")
end
local function shell_call(...)  -- the running shell's IpcHandler "settings"
    if not os.getenv("WAYLAND_DISPLAY") then return end
    local args = {}
    for i, a in ipairs({ ... }) do args[i] = sh_quote(a) end
    os.execute("qs ipc -p " .. SHELL .. " call settings " .. table.concat(args, " ") .. " >/dev/null 2>&1")
end
local function save_values(v)
    write(FILES.settings, json.flat(v))
    shell_call("reload")   -- the shell also watches the file; this makes it immediate
end

-- KEY or KEY@OUTPUT → schema entry, output
local function entry(key)
    local base, out = key:match("^([^@]+)@(.+)$")
    base = base or key
    local s = byKey[base] or die("unknown setting: " .. base .. " (olymparch-settings list shows them all)", 2)
    if s.per == "monitor" and not out then die(base .. " is per monitor: use " .. base .. "@OUTPUT (hyprctl monitors)", 2) end
    if s.per ~= "monitor" and out then die(base .. " is not per monitor", 2) end
    return s, out
end

local function value_of(values, key)
    local v = values[key]
    if v ~= nil then return v end
    return byKey[key:match("^[^@]+")].default
end

-- text from the command line → typed value, checked against the schema
local function parse(s, text)
    if s.readonly or s.type == "action" then die(s.key .. " cannot be set", 2) end
    if s.type == "bool" then
        local t = ({ ["true"] = true, on = true, ["1"] = true, yes = true, ["false"] = false, off = false, ["0"] = false, no = false })[text:lower()]
        if t == nil then die(s.key .. ": expected on or off", 2) end
        return t
    elseif s.type == "number" then
        local n = tonumber(text) or die(s.key .. ": expected a number", 2)
        if (s.min and n < s.min) or (s.max and n > s.max) then die(("%s: %s is outside %s–%s"):format(s.key, text, s.min, s.max), 2) end
        return math.tointeger(n) or n
    end
    if s.widget == "keys" then return combo_text(text) or text end
    return text
end
local function checked(s, out, text)
    local v = parse(s, text)
    local ok, why = valid(s, v, out)
    if not ok then die(("%s: %s"):format(s.key, why), 2) end
    return v
end

-- Every key combination a shortcut setting takes ("SUPER + 1" … for one with `each`), as comparable text
local function combos(s, v)
    local list = {}
    local function add(c)
        local mods, key = combo_parts(c)
        if mods and key then
            table.sort(mods, function(a, b) return MODS[a] < MODS[b] end)
            mods[#mods + 1] = key:lower()
            list[#list + 1] = table.concat(mods, " + ")
        end
    end
    if v == "" then return list end
    if s.each then for _, e in ipairs(s.each) do add(v .. " + " .. e) end else add(v) end
    return list
end
-- nil, or the setting that already uses one of the combinations S would take with V
local function shortcut_conflict(s, v, values)
    local mine = {}
    for _, c in ipairs(combos(s, v)) do mine[c] = true end
    for _, o in ipairs(schema.settings) do
        if o.key ~= s.key and o.ready and o.apply.key == "bind" then
            for _, c in ipairs(combos(o, value_of(values, o.key))) do
                if mine[c] then return o, c end
            end
        end
    end
end

---------------------------------------------------------------------------------------------------- Hyprland
local function lua_value(v)
    if type(v) == "string" then
        if v:match("^-?%d+%.?%d*$") then return v end   -- numeric choices (follow_mouse "1") are numbers to Hyprland
        return string.format("%q", v)
    end
    return json.value(v)
end
local function lua_table(path, v)  -- "decoration.blur.enabled", false → { decoration = { blur = { enabled = false } } }
    local parts = {}
    for p in path:gmatch("[^.]+") do parts[#parts + 1] = p end
    local s = lua_value(v)
    for i = #parts, 1, -1 do s = "{ " .. parts[i] .. " = " .. s .. " }" end
    return s
end
local function hyprctl_eval(code)
    if os.getenv("HYPRLAND_INSTANCE_SIGNATURE") then os.execute("hyprctl eval " .. sh_quote(code) .. " >/dev/null 2>&1") end
end

local function hypr_lines(values)  -- the user's hypr and cursor settings, as Lua
    local lines = {}
    for _, s in ipairs(schema.settings) do
        local v = values[s.key]
        if v ~= nil and s.apply.via == "hypr" and s.apply.key ~= "bind" then
            lines[#lines + 1] = "hl.config(" .. lua_table(s.apply.key, v) .. ")   -- " .. s.key
        elseif v ~= nil and s.apply.key == "bind" and s.ready and v ~= s.default then
            lines[#lines + 1] = ("    [%q] = %q,"):format(s.key, v)
        elseif v ~= nil and s.apply.via == "cursor" then
            local n = math.tointeger(tonumber(v)) or 24
            lines[#lines + 1] = ('hl.env("XCURSOR_SIZE", "%d")   -- %s'):format(n, s.key)
            lines[#lines + 1] = ('hl.env("HYPRCURSOR_SIZE", "%d")'):format(n)
        end
    end
    local first, last
    for i, l in ipairs(lines) do if l:match('^    %["keys%.') then first = first or i; last = i end end
    if first then   -- shortcuts moved in Settings; an older olymparch.lua without olymparch_keys skips them
        table.insert(lines, last + 1, "})")
        table.insert(lines, first, ';(rawget(_G, "olymparch_keys") or function() end)({')
    end
    local term = values["apps.terminal"]
    if term ~= nil and term ~= "" then lines[#lines + 1] = ("hl.env(\"OLYMPARCH_TERMINAL\", %q)   -- apps.terminal"):format(term) end
    return lines
end

local function monitors_now()
    if not os.getenv("HYPRLAND_INSTANCE_SIGNATURE") then return {} end
    local ok, v = pcall(json.decode, capture("hyprctl monitors -j"))
    return ok and v or {}
end
local function monitor_spec(values, out, override)
    local function get(k)
        local key = "display." .. k .. "@" .. out
        if override and override.key == key then return override.value end
        return value_of(values, key)
    end
    local res, rate = get("resolution"), get("refresh")
    local mode = "preferred"
    if res ~= "preferred" then
        mode = res .. (rate ~= "preferred" and ("@" .. rate) or "")
    elseif rate ~= "preferred" then   -- a rate alone needs the resolution in use
        for _, m in ipairs(monitors_now()) do
            if m.name == out then mode = ("%dx%d@%s"):format(m.width, m.height, rate) end
        end
    end
    local vrr = ({ off = 0, always = 1, fullscreen = 2 })[get("vrr")] or 2
    local parts = { ("output = %q"):format(out), ("mode = %q"):format(mode), ("position = %q"):format(get("position")),
        "scale = " .. (tonumber(get("scale")) or 1), "vrr = " .. vrr }
    if get("bitdepth") == "10" then parts[#parts + 1] = "bitdepth = 10" end
    return "hl.monitor({ " .. table.concat(parts, ", ") .. " })"
end
local function configured_outputs(values)
    local seen, list = {}, {}
    for k in pairs(values) do
        local base, out = k:match("^(display%.[%w_]+)@(.+)$")
        if base and not seen[out] then seen[out] = true; list[#list + 1] = out end
    end
    table.sort(list)
    return list
end

local HEADER = "-- Written by olymparch-settings (Settings, Super+comma). Change it there or with `olymparch settings`;\n" ..
    "-- edits here are overwritten. Your own lines belong in ~/.config/hypr/hyprland.lua.\n"
local LOADER_MARK = "olymparch/monitors.lua and hypr.lua"
local LOADER = "-- Settings (Super+comma) writes " .. LOADER_MARK .. "; lines further down still win\n" ..
    "for _, f in ipairs({ \"monitors\", \"hypr\" }) do\n" ..
    "    local ok, err = pcall(dofile, (os.getenv(\"XDG_CONFIG_HOME\") or os.getenv(\"HOME\") .. \"/.config\") .. \"/olymparch/\" .. f .. \".lua\")\n" ..
    "    if not ok and not tostring(err):find(\"No such file\") then error(err) end\n" ..
    "end\n"

-- hyprland.lua must load our files right after the defaults. Older installs wrote the layout there; move it here.
local function ensure_loader(values)
    local text = read(FILES.hyprland)
    if not text then
        text = 'package.path = "/usr/share/olymparch/hypr/?.lua;" .. package.path\nrequire("olymparch")\n'
    end
    local changed = false
    local layout = text:match('\nhl%.config%(%{ input = %{ kb_layout = "([^"]*)" %} %}%)\n?')
    if layout then
        text = text:gsub('\nhl%.config%(%{ input = %{ kb_layout = "[^"]*" %} %}%)\n?', "\n", 1)
        if values["keyboard.layout"] == nil and layout ~= byKey["keyboard.layout"].default then
            values["keyboard.layout"] = layout
            save_values(values)
        end
        changed = true
    end
    if not text:find(LOADER_MARK, 1, true) then
        local a, b = text:find('require%("olymparch"%)[^\n]*\n?')
        if b then text = text:sub(1, b) .. (text:sub(b, b) == "\n" and "" or "\n") .. LOADER .. text:sub(b + 1)
        else text = text .. "\n" .. LOADER end
        changed = true
    end
    if changed then write(FILES.hyprland, text) end
    return layout ~= nil
end

local function write_hypr(values)
    local lines = hypr_lines(values)
    write(FILES.hypr, HEADER .. (#lines > 0 and table.concat(lines, "\n") .. "\n" or ""))
end
local function write_monitors(values)
    local lines = {}
    for _, out in ipairs(configured_outputs(values)) do lines[#lines + 1] = monitor_spec(values, out) end
    write(FILES.monitors, HEADER .. (#lines > 0 and table.concat(lines, "\n") .. "\n" or ""))
end

local function write_idle(values)
    local lock = math.floor(tonumber(value_of(values, "account.lock_minutes")) or 0)
    local off = math.floor(tonumber(value_of(values, "power.screen_off_minutes")) or 0)
    local sleep = math.floor(tonumber(value_of(values, "power.suspend")) or 0)
    local t = { "# Written by olymparch-settings (Settings → Account and lock, Power). Delete it to use",
        "# /usr/share/olymparch/idle/hypridle.conf again. Apps, video and games that inhibit idle stop these timers.",
        "general {",
        "    lock_cmd = olymparch-lock",
        "    before_sleep_cmd = loginctl lock-session",
        "    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = \"enable\" })'",
        "}" }
    if lock > 0 then
        t[#t + 1] = ""
        t[#t + 1] = "listener {"
        t[#t + 1] = ("    timeout = %d                      # %d min: lock"):format(lock * 60, lock)
        t[#t + 1] = "    on-timeout = loginctl lock-session"
        t[#t + 1] = "}"
    end
    if off > 0 then
        t[#t + 1] = ""
        t[#t + 1] = "listener {"
        t[#t + 1] = ("    timeout = %d                      # %d min: screens off"):format(off * 60, off)
        t[#t + 1] = "    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = \"disable\" })'"
        t[#t + 1] = "    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = \"enable\" })'"
        t[#t + 1] = "}"
    end
    if sleep > 0 then   -- before_sleep_cmd above locks first
        t[#t + 1] = ""
        t[#t + 1] = "listener {"
        t[#t + 1] = ("    timeout = %d                      # %d min: sleep"):format(sleep * 60, sleep)
        t[#t + 1] = "    on-timeout = systemctl suspend"
        t[#t + 1] = "}"
    end
    write(FILES.idle, table.concat(t, "\n") .. "\n")
    if have("hypridle") and os.getenv("WAYLAND_DISPLAY") then
        os.execute("pkill -x hypridle; setsid -f hypridle -c " .. sh_quote(FILES.idle) .. " >/dev/null 2>&1")
    end
end

local function audio_node(name)  -- node.name → PipeWire id
    local ok, dump = pcall(json.decode, capture("pw-dump"))
    if not ok then return nil end
    for _, o in ipairs(dump or {}) do
        local p = o.info and o.info.props
        if p and p["node.name"] == name then return o.id end
    end
end

---------------------------------------------------------------------------------------------------- apply
-- Every applier handles one apply.via. The coverage test checks these against the schema.
local appliers = {}
appliers["shell"] = function() end    -- the shell watches settings.json itself
appliers["stored"] = function() end   -- read by the tool that needs it
appliers["info"] = function() end
appliers["hypr"] = function(s, values, key)
    ensure_loader(values)
    write_hypr(values)
    if s.apply.key ~= "bind" then hyprctl_eval("hl.config(" .. lua_table(s.apply.key, value_of(values, key)) .. ")")
    elseif os.getenv("HYPRLAND_INSTANCE_SIGNATURE") then os.execute("hyprctl reload >/dev/null 2>&1") end   -- binds: the whole config again
end
appliers["cursor"] = function(s, values, key)
    ensure_loader(values)
    write_hypr(values)
    if os.getenv("HYPRLAND_INSTANCE_SIGNATURE") then
        os.execute(("hyprctl setcursor Adwaita %d >/dev/null 2>&1"):format(math.tointeger(tonumber(value_of(values, key))) or 24))
    end
end
appliers["monitor"] = function(s, values, key, override)
    ensure_loader(values)
    if not override then write_monitors(values) end
    local out = key:match("@(.+)$")
    hyprctl_eval(monitor_spec(values, out, override))
    shell_call_target("shell", "screens")   -- panels on a moved output are rebuilt
end
appliers["idle"] = function(s, values) write_idle(values) end
appliers["audio"] = function(s, values, key)
    local name = value_of(values, key)
    if name == "" then return end
    local id = audio_node(name) or die("no audio device called " .. name .. " (wpctl status -n)")
    os.execute(("wpctl set-default %d"):format(math.tointeger(id) or die("bad PipeWire id")))
end
appliers["action"] = function(s)
    os.execute("setsid -f sh -c " .. sh_quote(s.apply.command) .. " >/dev/null 2>&1")
end

-- ── devices, apps and events (every value below was checked by valid() before it gets here)
appliers["bluetooth"] = function(s, values, key)   -- bluetooth.enabled
    local on = value_of(values, key) == true
    if on then os.execute("rfkill unblock bluetooth >/dev/null 2>&1") end
    if have("bluetoothctl") then os.execute("timeout 5 bluetoothctl power " .. (on and "on" or "off") .. " >/dev/null 2>&1") end
end
appliers["power"] = function(s, values, key)       -- power.profile (power-profiles-daemon)
    if have("powerprofilesctl") then os.execute("powerprofilesctl set " .. sh_quote(value_of(values, key)) .. " >/dev/null 2>&1") end
end
-- default apps: our lines in [Default Applications] of ~/.config/mimeapps.list ("" = the system's choice again)
appliers["mime"] = function(s, values, key)
    local path = CONFIG .. "/mimeapps.list"
    local app, types = value_of(values, key), {}
    for _, t in ipairs(s.apply.types) do types[t] = true end
    local out, section, done = {}, nil, false
    local function add_ours()
        if app ~= "" then for _, t in ipairs(s.apply.types) do out[#out + 1] = t .. "=" .. app end end
        done = true
    end
    for line in ((read(path) or "") .. "\n"):gmatch("([^\n]*)\n") do
        local sec = line:match("^%[(.+)%]%s*$")
        if sec then
            section = sec
            out[#out + 1] = line
            if sec == "Default Applications" and not done then add_ours() end
        else
            local t = line:match("^([^=]+)=")
            if not (section == "Default Applications" and t and types[t]) then out[#out + 1] = line end
        end
    end
    if not done and app ~= "" then
        if #out > 0 and out[#out] ~= "" then out[#out + 1] = "" end
        out[#out + 1] = "[Default Applications]"
        add_ours()
    end
    while #out > 0 and out[#out] == "" do out[#out] = nil end
    write(path, table.concat(out, "\n") .. "\n")
end
appliers["terminal"] = function(s, values)         -- apps.terminal: the terminal shortcut starts $OLYMPARCH_TERMINAL
    ensure_loader(values)
    write_hypr(values)
    if os.getenv("HYPRLAND_INSTANCE_SIGNATURE") then os.execute("hyprctl reload >/dev/null 2>&1") end
end
-- The only units Settings may switch or configure. The schema names them; anything else is refused, so no
-- value, file or schema edit can make this run systemctl on another unit. All of it is --user: no root.
local USER_UNITS = { ["olymparch-downloads.path"] = true, ["olymparch-heat-check.timer"] = true, ["olymparch-disk-check.service"] = true }
local function allowed_unit(u)
    if not USER_UNITS[u] then die("unit not allowed: " .. tostring(u), 5) end
    return u
end
-- a user unit on or off: masked in ~/.config/systemd/user, which also wins over the global enable
appliers["unit"] = function(s, values, key)
    local on = value_of(values, key) == true
    for _, u in ipairs(s.apply.units) do
        allowed_unit(u)
        if on then os.execute(("systemctl --user unmask %s >/dev/null 2>&1; systemctl --user start %s >/dev/null 2>&1"):format(sh_quote(u), sh_quote(u)))
        else os.execute(("systemctl --user mask --now %s >/dev/null 2>&1"):format(sh_quote(u))) end
    end
end
-- a number for a user unit, as Environment= in a drop-in next to it
appliers["dropin"] = function(s, values, key)
    local n = math.tointeger(value_of(values, key)) or die("expected a whole number")
    if not (s.apply.key or ""):match("^OLYMPARCH_[A-Z_]+$") then die("bad variable: " .. tostring(s.apply.key), 5) end
    local dir = CONFIG .. "/systemd/user/" .. allowed_unit(s.apply.unit) .. ".d"
    write(dir .. "/olymparch-settings.conf", ("# Written by olymparch-settings (%s)\n[Service]\nEnvironment=%s=%d\n"):format(s.key, s.apply.key, n))
    os.execute("systemctl --user daemon-reload >/dev/null 2>&1")
end
-- MangoHud for games started through olymparch-launch-steam: Olymparch's MangoHud.conf with your choices, in
-- ~/.config/olymparch/MangoHud.conf (your own ~/.config/MangoHud/MangoHud.conf, if you have one, still wins).
-- «off» is read by olymparch-launch-steam, which then starts Steam without MangoHud. From the next Steam start.
appliers["mangohud"] = function(s, values)
    local mode = value_of(values, "games.mangohud")
    local cap = math.tointeger(value_of(values, "games.fps_cap")) or 0
    local base = read("/usr/share/olymparch/games/MangoHud.conf") or "toggle_hud=Shift_L+F12\nfps\nframetime\n"
    local out = { "# Written by olymparch-settings (Settings → Games) from /usr/share/olymparch/games/MangoHud.conf" }
    for line in base:gmatch("[^\n]+") do
        if not line:match("^no_display%s*$") and not line:match("^fps_limit") and not line:match("^#") then out[#out + 1] = line end
    end
    if mode ~= "shown" then out[#out + 1] = "no_display" end
    if cap > 0 then out[#out + 1] = ("fps_limit=%d"):format(cap) end
    write(CONFIG .. "/olymparch/MangoHud.conf", table.concat(out, "\n") .. "\n")
end
-- session variables for games (from the next login): ~/.config/environment.d/olymparch-games.conf
appliers["envd"] = function(s, values)
    local gb = math.tointeger(value_of(values, "games.shader_cache")) or 10
    write(CONFIG .. "/environment.d/olymparch-games.conf",
        ("# Written by olymparch-settings (Settings → Games)\nMESA_SHADER_CACHE_MAX_SIZE=%dG\n__GL_SHADER_DISK_CACHE_SIZE=%d\n"):format(gb, gb * 1024 * 1024 * 1024))
end
appliers["brightness"] = function(s, values, key)   -- the built-in screen (laptops)
    if have("brightnessctl") then
        os.execute(("brightnessctl -q set %d%% >/dev/null 2>&1"):format(math.tointeger(value_of(values, key)) or 100))
    end
end
-- System files (/etc): only through the pkexec helper, which takes these actions and values and nothing else
-- (system/lib/settings-apply has the same list; tests/settings-coverage compares them).
local HELPER = "/usr/lib/olymparch/settings-apply"
local SYSTEM_ACTIONS = {
    lid = { suspend = true, lock = true, ignore = true },
    connectivity = { on = true, off = true },
    ["bt-mode"] = { dual = true, le = true, bredr = true },
    ["bt-fast"] = { on = true, off = true },
    dns = { auto = true, cloudflare = true, quad9 = true },
    ["mac-random"] = { on = true, off = true },
}
local SYSTEM_RANGES = {   -- whole numbers from MIN to MAX (settings-apply has the same globs)
    snapshots = { 2, 50 },
}
local function system_allowed(act, v)
    if SYSTEM_ACTIONS[act] then return SYSTEM_ACTIONS[act][v] == true end
    local r, n = SYSTEM_RANGES[act], math.tointeger(tonumber(v))
    return r ~= nil and n ~= nil and tostring(n) == v and n >= r[1] and n <= r[2]
end
appliers["system"] = function(s, values, key)
    local v = value_of(values, key)
    if type(v) == "boolean" then v = v and "on" or "off" end
    if type(v) == "number" then v = tostring(math.tointeger(v) or v) end
    local act = s.apply.action
    if type(v) ~= "string" or not system_allowed(act, v) then die(("%s: %s is not allowed"):format(key, tostring(v)), 5) end
    if not io.open(HELPER) then die(HELPER .. " is missing (olymparch update)", 3) end
    if not os.execute("pkexec " .. HELPER .. " " .. sh_quote(act) .. " " .. sh_quote(v) .. " >/dev/null 2>&1") then
        die(key .. ": not changed (the system said no)", 3)
    end
end
-- headset switch: /etc/pipewire/pipewire-pulse.conf.d/50-olymparch-switch-on-connect.conf loads the module unless
-- olymparch.switch-on-connect is false; this drop-in says so. pactl changes the running server too.
appliers["headset"] = function(s, values, key)
    local on = value_of(values, key) == true
    local path = CONFIG .. "/pipewire/pipewire-pulse.conf.d/90-olymparch-settings.conf"
    if on then os.remove(path)
    else write(path, "# Written by olymparch-settings (audio.headset_switch)\npulse.properties = { olymparch.switch-on-connect = false }\n") end
    if have("pactl") then
        local loaded = capture("pactl list modules short"):find("module%-switch%-on%-connect") ~= nil
        if on and not loaded then os.execute("pactl load-module module-switch-on-connect >/dev/null 2>&1")
        elseif not on and loaded then os.execute("pactl unload-module module-switch-on-connect >/dev/null 2>&1") end
    end
end

local function apply(key, values, override)
    local s = entry(key)
    local fn = appliers[s.apply.via] or die("no way to apply " .. s.apply.via)
    fn(s, values, key, override)
end

---------------------------------------------------------------------------------------------------- try / keep / revert
local function load_pending()
    local text = read(FILES.pending)
    if not text then return nil end
    local ok, v = pcall(json.decode, text)
    if not ok or type(v) ~= "table" or type(v.key) ~= "string" or type(v.token) ~= "string" then return nil end
    local base, out = v.key:match("^([^@]+)@?(.*)$")
    local s = byKey[base]
    if not s or not valid(s, v.value, out ~= "" and out or nil) then return nil end
    return v
end

local function revert(token)
    local p = load_pending()
    if not p or (token and p.token ~= token) then return false end
    os.remove(FILES.pending)
    apply(p.key, load_values())   -- settings.json never changed: apply what it says
    return true
end

---------------------------------------------------------------------------------------------------- monitor combinations
-- Every set of connected monitors remembers its layout (display.profiles). The key is the monitors' descriptions
-- (make, model, serial) sorted, never the port names, and the layout is stored per description, so a monitor keeps
-- its place when it moves to another port. Settings → Displays saves the layout for the combination in use;
-- Hyprland's monitor.added/removed events run `olymparch-settings monitors-changed`, which applies the saved one.
FILES.profiles = CONFIG .. "/olymparch/display-profiles.json"
local PER_MONITOR = {}   -- "resolution", "scale", … : the per-monitor display settings
for _, s in ipairs(schema.settings) do
    if s.per == "monitor" and s.key:match("^display%.") then PER_MONITOR[#PER_MONITOR + 1] = s.key:sub(9) end
end

local function json_pretty(v, indent)   -- nested tables, keys sorted, so the file diffs well
    indent = indent or ""
    if type(v) ~= "table" then return json.value(v) end
    local keys = {}
    for k in pairs(v) do keys[#keys + 1] = k end
    table.sort(keys)
    if #keys == 0 then return "{}" end
    local inner, out = indent .. "  ", {}
    for i, k in ipairs(keys) do out[i] = inner .. json.value(tostring(k)) .. ": " .. json_pretty(v[k], inner) end
    return "{\n" .. table.concat(out, ",\n") .. "\n" .. indent .. "}"
end

-- connected monitors (also disabled ones): { name = "DP-1", id = "Dell Inc. DELL U2720Q 1234" }, sorted by id
local function connected()
    if not os.getenv("HYPRLAND_INSTANCE_SIGNATURE") then return {} end
    local ok, v = pcall(json.decode, capture("hyprctl monitors all -j"))
    local list, count = {}, {}
    for _, m in ipairs(ok and type(v) == "table" and v or {}) do
        local name = type(m.name) == "string" and m.name or ""
        if name:match("^[%w_.-]+$") then
            local id = type(m.description) == "string" and m.description:gsub("[%c\\]", ""):sub(1, 200) or ""
            if id:match("^%s*$") then id = name end
            list[#list + 1] = { name = name, id = id }
        end
    end
    table.sort(list, function(a, b) return a.id == b.id and a.name < b.name or a.id < b.id end)
    for _, m in ipairs(list) do   -- two identical monitors without a serial: the second is «… #2»
        count[m.id] = (count[m.id] or 0) + 1
        if count[m.id] > 1 then m.id = m.id .. " #" .. count[m.id] end
    end
    return list
end
local function combo_key(mons)
    local ids = {}
    for i, m in ipairs(mons) do ids[i] = m.id end
    return table.concat(ids, " + ")
end

-- display-profiles.json: { "current": KEY, "profiles": { KEY: { MONITOR-ID: { "scale": "1.5", … } } } }. Hand
-- edits are welcome, so every value is checked against the schema again before it is used.
local function load_profiles()
    local ok, v = pcall(json.decode, read(FILES.profiles) or "{}")
    if not ok or type(v) ~= "table" then v = {} end
    local clean = { current = type(v.current) == "string" and v.current or nil, profiles = {} }
    for key, prof in pairs(type(v.profiles) == "table" and v.profiles or {}) do
        if type(key) == "string" and type(prof) == "table" then
            local p = {}
            for id, layout in pairs(prof) do
                if type(id) == "string" and type(layout) == "table" then
                    p[id] = {}
                    for _, k in ipairs(PER_MONITOR) do
                        local x = layout[k]
                        if x ~= nil and valid(byKey["display." .. k], x, "check") then p[id][k] = x end
                    end
                end
            end
            clean.profiles[key] = p
        end
    end
    return clean
end
local function save_profiles(data) write(FILES.profiles, json_pretty(data) .. "\n") end

-- the layout in settings.json for these monitors, by monitor ID
local function snapshot(values, mons)
    local prof = {}
    for _, m in ipairs(mons) do
        prof[m.id] = {}
        for _, k in ipairs(PER_MONITOR) do prof[m.id][k] = values["display." .. k .. "@" .. m.name] end
    end
    return prof
end

-- Settings → Displays changed something: remember it for the monitors connected now
local function save_combination(values)
    if value_of(values, "display.profiles") == false then return end
    local mons = connected()
    if #mons == 0 then return end
    local data, key = load_profiles(), combo_key(mons)
    data.profiles[key] = snapshot(values, mons)
    data.current = key
    save_profiles(data)
end

local function notify_new_combination()
    local nb = (os.getenv("LANG") or ""):match("^n[bno]")
    local title = nb and "Ny skjermkombinasjon" or "New monitor combination"
    local body = nb and "Åpne Skjermer for å ordne den. Oppsettet huskes til neste gang de samme skjermene kobles til."
        or "Open Displays to arrange it. The layout is remembered for the next time these monitors are connected."
    local button = nb and "Åpne Skjermer" or "Open Displays"
    local script = ('a=$(notify-send -a Olymparch -w --action=open=%s %s %s); [ "$a" = open ] && exec %s open display')
        :format(sh_quote(button), sh_quote(title), sh_quote(body), sh_quote(SELF))
    os.execute("setsid -f sh -c " .. sh_quote(script) .. " >/dev/null 2>&1 </dev/null")
end

-- the monitors changed: put the saved layout for this combination in place, or start a new one at the defaults
local function monitors_changed()
    -- a dock or a KVM switch sends several events at once: only the last one within a second does the work
    local stamp = RUNTIME .. "/olymparch-monitors-event"
    local token = ("%d%06d"):format(os.time(), math.random(0, 999999))
    write(stamp, token)
    os.execute("sleep 1")
    if read(stamp) ~= token then return "superseded" end
    local values = load_values()
    if value_of(values, "display.profiles") == false then return "off" end
    local mons = connected()
    if #mons == 0 then return "no monitors" end
    local data, key = load_profiles(), combo_key(mons)
    if data.current == nil then   -- the first time: the layout in use is this combination's
        data.profiles[key] = data.profiles[key] or snapshot(values, mons)
        data.current = key
        save_profiles(data)
        return "first " .. key
    end
    if data.current == key then return "same " .. key end
    local prof = data.profiles[key]
    for k in pairs(values) do
        if k:match("^display%.[%w_]+@") and byKey[k:match("^[^@]+")].per == "monitor" then values[k] = nil end
    end
    -- a new combination starts at preferred modes and automatic positions; a monitor it shares with the one before
    -- keeps its scale, VRR and colour depth
    local before = data.profiles[data.current] or {}
    for _, m in ipairs(mons) do
        local layout = prof and prof[m.id] or {}
        if not prof and before[m.id] then
            for _, k in ipairs({ "scale", "vrr", "bitdepth" }) do layout[k] = before[m.id][k] end
        end
        for k, v in pairs(layout) do values["display." .. k .. "@" .. m.name] = v end
    end
    save_values(values)
    ensure_loader(values)
    write_monitors(values)
    for _, m in ipairs(mons) do hyprctl_eval(monitor_spec(values, m.name)) end
    shell_call_target("shell", "screens")
    data.current = key
    if not prof then data.profiles[key] = snapshot(values, mons) end
    save_profiles(data)
    if not prof then notify_new_combination(); return "new " .. key end
    return "restored " .. key
end

---------------------------------------------------------------------------------------------------- commands
local cmd = arg[1]
local function label(s)
    local lang = (os.getenv("LANG") or ""):match("^n[bno]") and "nb" or "en"
    return s.label[lang] or s.label.en
end

if cmd == "get" then
    local key = arg[2] or die("usage: get KEY", 2)
    entry(key)
    local v = value_of(load_values(), key)
    print(type(v) == "string" and v or json.value(v))

elseif cmd == "set" then
    local key, text = arg[2], arg[3]
    if not key or not text then die("usage: set KEY VALUE [--try SECONDS]", 2) end
    local s, out = entry(key)
    local v = checked(s, out, text)
    local try = arg[4] == "--try" and (tonumber(arg[5]) or 15) or nil
    local values = load_values()
    if s.installed and v ~= "" and not have(v) then die(("%s: %s is not installed"):format(s.key, v), 2) end
    if s.apply.key == "bind" then
        local o, c = shortcut_conflict(s, v, values)
        if o then
            local nb = (os.getenv("LANG") or ""):match("^n[bno]")
            die((nb and "%s er allerede «%s» (%s)" or "%s is already «%s» (%s)"):format(c:upper(), label(o), o.key), 4)
        end
    end
    if try then
        revert()   -- one question at a time
        local token = ("%d%06d"):format(os.time(), math.random(0, 999999))
        write(FILES.pending, json.flat({ key = key, value = v, token = token, deadline = os.time() + try }))
        apply(key, values, { key = key, value = v })
        os.execute(("setsid -f sh -c %s >/dev/null 2>&1"):format(sh_quote(("sleep %d; exec %s revert --token %s"):format(try, sh_quote(SELF), token))))
        print("pending " .. token)
    elseif s.apply.via == "system" then   -- /etc: remembered only once the helper has done it
        values[key] = v
        apply(key, values)
        save_values(values)
    else
        values[key] = v
        save_values(values)
        apply(key, values)
        if key:match("^display%..+@") then save_combination(values) end
    end

elseif cmd == "keep" then
    local p = load_pending() or die("nothing to keep")
    os.remove(FILES.pending)
    local values = load_values()
    values[p.key] = p.value
    save_values(values)
    apply(p.key, values)
    if p.key:match("^display%..+@") then save_combination(values) end
    print("kept " .. p.key)

elseif cmd == "revert" then
    local token = arg[2] == "--token" and arg[3] or nil
    print(revert(token) and "reverted" or "nothing to revert")

elseif cmd == "pending" then
    local p = load_pending()
    if p then io.write(json.flat(p)) end

elseif cmd == "reset" then
    local key = arg[2] or die("usage: reset KEY", 2)
    entry(key)
    local values = load_values()
    values[key] = nil
    save_values(values)
    apply(key, values)
    if key:match("^display%..+@") then save_combination(values) end

elseif cmd == "list" then
    local page = arg[2]
    local values = load_values()
    for _, s in ipairs(schema.settings) do
        if not page or s.page == page then
            local shown = {}
            if s.per == "monitor" then
                for k in pairs(values) do if k:match("^[^@]+") == s.key then shown[#shown + 1] = k end end
                table.sort(shown)
                if #shown == 0 then shown = { s.key } end
            else
                shown = { s.key }
            end
            for _, k in ipairs(shown) do
                local v; if s.type ~= "action" then v = value_of(values, k) end
                print(("%-40s %-24s %-14s %s%s"):format(k, v == nil and "" or (v == false and "false" or tostring(v or "")),
                    s.page, label(s), s.ready and "" or "  (coming)"))
            end
        end
    end

elseif cmd == "apply" then
    local values = load_values()
    ensure_loader(values)
    if arg[2] then apply(arg[2], values) else
        save_values(values)
        write_hypr(values)
        write_monitors(values)
        if values["account.lock_minutes"] ~= nil or values["power.screen_off_minutes"] ~= nil or values["power.suspend"] ~= nil then write_idle(values) end
        if os.getenv("HYPRLAND_INSTANCE_SIGNATURE") then os.execute("hyprctl reload >/dev/null 2>&1") end
    end

elseif cmd == "run" then
    local s = entry(arg[2] or die("usage: run KEY", 2))
    if s.type ~= "action" then die(s.key .. " is not an action", 2) end
    if not s.ready then die(s.key .. " is not ready yet", 3) end
    if s.output then os.exit(os.execute(s.apply.command:gsub("^olymparch%-settings ", sh_quote(SELF) .. " ")) and 0 or 1) end
    apply(s.key, {})

elseif cmd == "about" then
    local os_release = read("/usr/lib/os-release") or read("/etc/os-release") or ""
    local function field(k) return os_release:match("\n" .. k .. '="?([^"\n]*)') or os_release:match("^" .. k .. '="?([^"\n]*)') end
    print("version=" .. (field("PRETTY_NAME") or "Olymparch") .. " " .. (field("VERSION_ID") or field("BUILD_ID") or ""))
    print("cpu=" .. ((read("/proc/cpuinfo") or ""):match("model name%s*:%s*([^\n]+)") or "?"))
    local gpus = {}
    for l in capture("lspci"):gmatch("[^\n]+") do
        local g = l:match("VGA compatible controller: (.+)") or l:match("3D controller: (.+)") or l:match("Display controller: (.+)")
        if g then gpus[#gpus + 1] = g end
    end
    print("gpu=" .. (#gpus > 0 and table.concat(gpus, "; ") or "?"))
    local kb = tonumber((read("/proc/meminfo") or ""):match("MemTotal:%s*(%d+)")) or 0
    print(("memory=%.1f GB"):format(kb / 1024 / 1024))
    print("kernel=" .. capture("uname -r"):gsub("%s+$", ""))
    print("disk=" .. capture("df -h --output=avail,size / | tail -n 1"):gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s+", " free of "))
    local mons = {}
    for _, m in ipairs(monitors_now()) do mons[#mons + 1] = ("%s %dx%d@%.0f ×%s"):format(m.name, m.width, m.height, m.refreshRate, m.scale) end
    print("monitors=" .. table.concat(mons, ", "))
    print("hyprland=" .. (capture("hyprctl version -j"):match('"tag":%s*"([^"]+)"') or "?"))

elseif cmd == "monitors-changed" then
    print(monitors_changed())

elseif cmd == "profiles" then
    local data = load_profiles()
    local keys = {}
    for k in pairs(data.profiles) do keys[#keys + 1] = k end
    table.sort(keys)
    for _, k in ipairs(keys) do
        print((k == data.current and "* " or "  ") .. k)
        local ids = {}
        for id in pairs(data.profiles[k]) do ids[#ids + 1] = id end
        table.sort(ids)
        for _, id in ipairs(ids) do
            local parts = {}
            for _, s in ipairs(PER_MONITOR) do
                local v = data.profiles[k][id][s]
                if v ~= nil then parts[#parts + 1] = s .. "=" .. tostring(v) end
            end
            print("    " .. id .. ": " .. (#parts > 0 and table.concat(parts, " ") or "default"))
        end
    end

-- ── lists the window shows as rows you click: Wi-Fi networks, Bluetooth devices.
--   items KEY [--scan]   one per line: ID <tab> STATE (on, saved, new) <tab> NAME <tab> DETAIL; or "! MESSAGE"
--   pick KEY ID          connect / disconnect what was clicked
elseif cmd == "items" or cmd == "pick" then
    local key = arg[2] or die("usage: " .. cmd .. " KEY …", 2)
    local function clean(t) return ((t or ""):gsub("%c", " ")) end
    if cmd == "pick" then   -- what was clicked is checked before anything else runs
        local id = arg[3] or die("usage: pick KEY ID", 2)
        if key == "network.wifi" and (#id > 32 or id == "" or id:find("%c")) then die("not a network name", 2) end
        if key == "bluetooth.devices" and not id:match("^%x%x:%x%x:%x%x:%x%x:%x%x:%x%x$") then die("not a device address", 2) end
    end
    if key == "network.wifi" then
        if not have("nmcli") then print("! nonm NetworkManager (nmcli) is not installed"); os.exit(0) end
        -- security as a class: open, wep or wpa (WPA2/WPA3/OWE/802.1X). A saved network is only joined through its
        -- own connection (by UUID), and only when an access point with that name offers the same class: an open
        -- or WEP twin of a WPA network is never joined in its place.
        local function class_of_scan(sec)
            if sec == "" or sec == "--" then return "open" end
            if sec:find("WEP") and not sec:find("WPA") then return "wep" end
            return "wpa"
        end
        local function class_of_keymgmt(km)
            if km == "" then return "open" end
            if km == "none" or km == "ieee8021x" then return "wep" end
            return "wpa"   -- wpa-psk, sae, wpa-eap, owe …
        end
        local function wifi_list()
            local list = {}
            for l in capture("nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID device wifi list --rescan no"):gmatch("[^\n]+") do
                local inuse, signal, sec, ssid = l:match("^([^:]*):(%d*):([^:]*):(.*)$")
                ssid = ssid and ssid:gsub("\\:", ":"):gsub("\\\\", "\\")
                if ssid and ssid ~= "" and #ssid <= 32 and not ssid:find("%c") then
                    list[#list + 1] = { ssid = ssid, on = inuse == "*", signal = tonumber(signal) or 0, class = class_of_scan(sec) }
                end
            end
            return list
        end
        local saved = {}   -- SSID → { uuid, class }
        for l in capture("nmcli -t -f UUID,TYPE connection show"):gmatch("[^\n]+") do
            local uuid = l:match("^([%x-]+):802%-11%-wireless$")
            if uuid then
                local g = capture("nmcli -t -g 802-11-wireless.ssid,802-11-wireless-security.key-mgmt connection show uuid " .. sh_quote(uuid))
                local ssid, km = g:match("^([^\n]*)\n([^\n]*)")
                if ssid and ssid ~= "" then saved[ssid] = { uuid = uuid, class = class_of_keymgmt(km or "") } end
            end
        end
        local function offers(ssid, class)
            for _, n in ipairs(wifi_list()) do if n.ssid == ssid and n.class == class then return true end end
            return false
        end
        if cmd == "items" then
            if capture("nmcli -t -f TYPE device"):find("wifi") == nil then print("! nowifi no Wi-Fi adapter"); os.exit(0) end
            if arg[3] == "--scan" then os.execute("nmcli device wifi rescan >/dev/null 2>&1; sleep 3") end
            local seen = {}
            for _, n in ipairs(wifi_list()) do
                if not seen[n.ssid] then
                    seen[n.ssid] = true
                    local sv = saved[n.ssid]
                    local twin = sv and not offers(n.ssid, sv.class)
                    print(table.concat({ n.ssid, n.on and "on" or (sv and not twin) and "saved" or "new", n.ssid,
                        n.signal .. "%" .. (n.class ~= "open" and " · 🔒" or "") .. (twin and " · ⚠ not the saved network's security" or "") }, "\t"))
                end
            end
        else
            local ssid = arg[3] or die("usage: pick network.wifi SSID", 2)
            if #ssid > 32 or ssid:find("%c") then die("not a network name", 2) end
            local net
            for _, n in ipairs(wifi_list()) do if n.ssid == ssid and (not net or n.on) then net = n end end
            if net and net.on then
                local sv = saved[ssid]
                os.exit(os.execute("nmcli connection down " .. (sv and ("uuid " .. sh_quote(sv.uuid)) or ("id " .. sh_quote(ssid))) .. " >/dev/null 2>&1") and 0 or 1)
            end
            local sv = saved[ssid]
            if sv then
                if not offers(ssid, sv.class) then
                    die(("%s: the saved network uses %s, but %s nearby does not; not connecting (forget it in nmtui if it really changed)"):format(ssid, sv.class, ssid), 3)
                end
                os.exit(os.execute("nmcli connection up uuid " .. sh_quote(sv.uuid) .. " >/dev/null 2>&1") and 0 or 1)
            end
            if net and net.class == "open" then os.exit(os.execute("nmcli device wifi connect " .. sh_quote(ssid) .. " >/dev/null 2>&1") and 0 or 1) end
            -- a password is needed: nmtui asks for it in a terminal, so it never passes through a command line
            os.execute("setsid -f foot -e nmtui connect " .. sh_quote(ssid) .. " >/dev/null 2>&1")
        end
    elseif key == "bluetooth.devices" then
        local function bt(args) return capture("timeout 5 bluetoothctl " .. args) end
        if not have("bluetoothctl") then print("! nobluez Bluetooth (bluez) is not installed: no adapter was found"); os.exit(0) end
        local show = bt("show")
        if not show:find("Controller") then print("! nobt no Bluetooth adapter"); os.exit(0) end
        local function set_of(args)
            local t = {}
            for mac in bt(args):gmatch("Device (%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)") do t[mac] = true end
            return t
        end
        if cmd == "items" then
            if not show:find("Powered: yes") then print("! btoff Bluetooth is off"); os.exit(0) end
            if arg[3] == "--scan" then os.execute("timeout 12 bluetoothctl --timeout 10 scan on >/dev/null 2>&1") end
            local paired, connected = set_of("devices Paired"), set_of("devices Connected")
            for mac, name in bt("devices"):gmatch("Device (%x%x:%x%x:%x%x:%x%x:%x%x:%x%x) ([^\n]*)") do
                print(table.concat({ mac, connected[mac] and "on" or paired[mac] and "saved" or "new", clean(name), mac }, "\t"))
            end
        else
            local mac = arg[3] or die("usage: pick bluetooth.devices MAC", 2)
            if not mac:match("^%x%x:%x%x:%x%x:%x%x:%x%x:%x%x$") then die("not a device address", 2) end
            local q = sh_quote(mac)
            if set_of("devices Connected")[mac] then os.exit(os.execute("timeout 10 bluetoothctl disconnect " .. q .. " >/dev/null 2>&1") and 0 or 1) end
            if not set_of("devices Paired")[mac] then
                os.execute("timeout 25 bluetoothctl --timeout 20 pair " .. q .. " >/dev/null 2>&1")
                os.execute("timeout 5 bluetoothctl trust " .. q .. " >/dev/null 2>&1")
            end
            os.exit(os.execute("timeout 15 bluetoothctl connect " .. q .. " >/dev/null 2>&1") and 0 or 1)
        end
    else
        die(key .. " has no list", 2)
    end

-- wired network: what NetworkManager says (Settings → Network → Wired)
elseif cmd == "wired" then
    if not have("nmcli") then print("NetworkManager (nmcli) is not installed"); os.exit(0) end
    local any = false
    for l in capture("nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device"):gmatch("[^\n]+") do
        local dev, typ, state, conn = l:match("^([^:]*):([^:]*):([^:]*):(.*)$")
        if typ == "ethernet" then
            any = true
            local ip = capture("nmcli -g IP4.ADDRESS device show " .. sh_quote(dev)):match("[^\n|]+") or ""
            local speed = (read("/sys/class/net/" .. dev .. "/speed") or ""):match("%d+")
            print(("%s  %s%s%s%s"):format(dev, state, conn ~= "" and ("  " .. conn) or "", ip ~= "" and ("  " .. ip) or "",
                speed and tonumber(speed) > 0 and ("  " .. speed .. " Mb/s") or ""))
        end
    end
    if not any then print("no wired adapter") end

-- settings that need a program this machine doesn't have (the window hides them): one key per line
elseif cmd == "missing" then
    local function exists(f)   -- needs_file / unless_file: a fixed path from the schema; ~/ is the home folder
        local h = io.open((f:gsub("^~/", HOME .. "/")))
        if h then h:close() end
        return h ~= nil
    end
    for _, s in ipairs(schema.settings) do
        if (s.needs and not have(s.needs)) or (s.needs_file and not exists(s.needs_file))
            or (s.unless_file and exists(s.unless_file)) then print(s.key) end
    end

-- what a choice can be on this machine: VALUE <tab> LABEL per line (default apps, terminals)
elseif cmd == "choices" then
    local s = entry(arg[2] or die("usage: choices KEY", 2))
    local function clean_name(t) return (t:gsub("%c", " ")) end
    if s.options_from == "desktop" then
        local want = {}
        for _, t in ipairs(s.apply.types or {}) do want[t] = true end
        local seen = {}
        local dirs = { (os.getenv("XDG_DATA_HOME") or (HOME .. "/.local/share")) .. "/applications" }
        for d in (os.getenv("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"):gmatch("[^:]+") do dirs[#dirs + 1] = d .. "/applications" end
        for _, dir in ipairs(dirs) do
            for f in capture("ls -1 " .. sh_quote(dir)):gmatch("[^\n]+") do
                if f:match("^[%w_.%-]+%.desktop$") and not seen[f] then
                    seen[f] = true
                    local text = read(dir .. "/" .. f) or ""
                    local entry_ = text:match("%[Desktop Entry%](.-)\n%[") or text:match("%[Desktop Entry%](.*)") or ""
                    local mimes = entry_:match("\nMimeType=([^\n]*)") or ""
                    local hit = false
                    for m in mimes:gmatch("[^;]+") do if want[m] then hit = true end end
                    if hit and not entry_:find("\nNoDisplay=true") then
                        print(f .. "\t" .. clean_name(entry_:match("\nName=([^\n]*)") or f))
                    end
                end
            end
        end
    else
        for _, o in ipairs(s.options or {}) do
            if o.value == "" or not s.installed or have(o.value) then print(o.value .. "\t" .. label(o)) end
        end
    end

-- ── read-only views the window shows under a row (Disks, Hardware, Games, Zeus). Fixed commands only: nothing from
--   settings.json or the command line reaches a shell; paths found on disk are quoted.
elseif cmd == "view" then
    local name = arg[2] or die("usage: view NAME", 2)
    local lang = os.getenv("OLYMPARCH_LANG") or os.getenv("LC_ALL") or os.getenv("LC_MESSAGES") or os.getenv("LANG") or ""
    local nb = lang:match("^n[bno]") ~= nil
    local function L(en, no) return nb and no or en end
    local function out(s) s = (s or ""):gsub("%s+$", ""); if s ~= "" then print(s) end end
    local steam = HOME .. "/.local/share/Steam"
    local function libraries()   -- Steam library folders, from libraryfolders.vdf
        local libs, seen = {}, {}
        local vdf = read(steam .. "/steamapps/libraryfolders.vdf") or ""
        for raw in vdf:gmatch('"path"%s+"([^"\n]+)"') do
            local p = raw:gsub("\\\\", "\\")
            if not seen[p] and not p:find("%c") then seen[p] = true; libs[#libs + 1] = p end
        end
        if #libs == 0 and io.open(steam .. "/steamapps") then libs[1] = steam end
        return libs
    end
    local function games()   -- every installed Steam game: { id, name }
        local list = {}
        for _, lib in ipairs(libraries()) do
            for f in capture("ls -1 " .. sh_quote(lib .. "/steamapps")):gmatch("[^\n]+") do
                local id = f:match("^appmanifest_(%d+)%.acf$")
                local acf = id and read(lib .. "/steamapps/" .. f) or ""
                local gname = acf:match('"name"%s+"([^"\n]*)"') or ""
                if id and not (gname:match("^Proton") or gname:match("^Steam Linux Runtime") or gname:match("^Steamworks")) then
                    local acf = read(lib .. "/steamapps/" .. f) or ""
                    list[#list + 1] = { id = id, name = ((acf:match('"name"%s+"([^"\n]*)"') or id):gsub("%c", " ")) }
                end
            end
        end
        table.sort(list, function(a, b) return a.name:lower() < b.name:lower() end)
        return list
    end
    if name == "disks" then
        out(capture("lsblk -e 7 -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS"))
        print("")
        out(capture("df -h -x tmpfs -x devtmpfs -x efivarfs -x overlay --output=target,size,used,avail,pcent"))
        if capture("findmnt -no FSTYPE /"):find("btrfs") and have("btrfs") then
            print("")
            out(capture("btrfs filesystem df -h /"))
        end
    elseif name == "libraries" then
        local libs = libraries()
        if #libs == 0 then print(L("Steam has no game libraries yet", "Steam har ingen spillbibliotek ennå")) end
        for _, lib in ipairs(libs) do
            local d = capture("df -h --output=avail,size,target " .. sh_quote(lib) .. " | tail -n 1"):gsub("^%s+", ""):gsub("%s+$", "")
            local avail, size, target = d:match("^(%S+)%s+(%S+)%s+(.+)$")
            print(lib .. (avail and ("  (" .. avail .. L(" free of ", " ledig av ") .. size .. L(", on ", ", på ") .. target .. ")") or ""))
        end
        print("")
        print(L("Steam → Settings → Storage adds a library on another disk; disks in /etc/fstab are mounted at boot.",
                "Steam → Innstillinger → Lagring legger til et bibliotek på en annen disk; disker i /etc/fstab monteres ved oppstart."))
    elseif name == "mounts" then
        out(capture("findmnt -t btrfs,ext4,xfs,vfat,ntfs3,exfat -o TARGET,FSTYPE,OPTIONS"))
        print("")
        print(L("From /etc/fstab: change it as root, then restart", "Fra /etc/fstab: endres som root, deretter omstart"))
    elseif name == "subvolumes" then
        out(capture("findmnt -t btrfs -o TARGET,FSROOT,SOURCE"))
    elseif name == "snapshots" then
        local list = capture("snapper --no-dbus list 2>/dev/null || snapper list")
        if list:find("#") then out(list) else
            print(L("snapper needs root to list them: «Roll back» shows the list in a terminal",
                    "snapper trenger root for å vise dem: «Rull tilbake» viser listen i en terminal"))
        end
        local conf = read("/etc/snapper/configs/root")
        if conf then
            print("")
            for _, k in ipairs({ "SPACE_LIMIT", "NUMBER_LIMIT" }) do
                local v = conf:match("\n" .. k .. '="([^"\n]*)"')
                if v then print(k .. "=" .. v) end
            end
        end
    elseif name == "kernel" then
        print(L("running: ", "kjører: ") .. capture("uname -r"):gsub("%s+$", ""))
        local conf = read("/etc/olymparch/boot.conf") or ""
        local k = ("\n" .. conf):match('\nKERNEL="?([%w._-]+)')
        if k then print(L("boots by default: ", "starter som standard: ") .. k) end
        local found, seen = {}, {}
        for p in capture("cat /usr/lib/modules/*/pkgbase"):gmatch("[%w._-]+") do
            if not seen[p] then seen[p] = true; found[#found + 1] = p end
        end
        if #found > 0 then print(L("installed: ", "installert: ") .. table.concat(found, ", ")) end
        print("")
        print(L("The boot menu lists every installed kernel; linux-lts stays as a fallback",
                "Oppstartsmenyen viser alle installerte kjerner; linux-lts blir værende som reserve"))
    elseif name == "overdrive" then
        local mask = (read("/proc/cmdline") or ""):match("amdgpu%.ppfeaturemask=(%S+)")
        print(mask and (L("on: ", "på: ") .. "amdgpu.ppfeaturemask=" .. mask) or L("off (amdgpu.ppfeaturemask is not set)", "av (amdgpu.ppfeaturemask er ikke satt)"))
        print(L("Set in /etc/olymparch/boot.conf (CMDLINE) as root", "Settes i /etc/olymparch/boot.conf (CMDLINE) som root"))
    elseif name == "firmware" then
        if not have("fwupdmgr") then
            print(L("fwupd is not installed: firmware comes with linux-firmware and olymparch update",
                    "fwupd er ikke installert: fastvare kommer med linux-firmware og olymparch update"))
        else out(capture("timeout 30 fwupdmgr get-updates --no-unreported-check --no-metadata-check 2>&1")) end
    elseif name == "games" then
        local list = capture("olymparch-game list")
        if list:match("^%s*$") then list = read(CONFIG .. "/olymparch/games.conf") or "" end
        out(list)
        print("")
        print(L("Super+Shift+G counts the focused window's program as a game", "Super+Shift+G regner programmet i vinduet med fokus som et spill"))
    elseif name == "proton" then
        local tools = {}
        for _, lib in ipairs(libraries()) do
            for d in capture("ls -1 " .. sh_quote(lib .. "/steamapps/common")):gmatch("[^\n]+") do
                if d:match("^Proton") then tools[#tools + 1] = d end
            end
        end
        for d in capture("ls -1 " .. sh_quote(steam .. "/compatibilitytools.d")):gmatch("[^\n]+") do tools[#tools + 1] = d end
        print(L("Automatic: Valve's default, then the newest GE-Proton, then Proton Experimental after a crash",
                "Automatisk: Valves standard, så nyeste GE-Proton, så Proton Experimental etter krasj"))
        print(L("Installed: ", "Installert: ") .. (#tools > 0 and table.concat(tools, ", ") or L("none yet", "ingen ennå")))
    elseif name == "proton-games" then
        local list = games()
        if #list == 0 then print(L("No Steam games installed", "Ingen Steam-spill installert")) end
        for i, g in ipairs(list) do
            if i > 60 then print("…"); break end
            local tool = have("olymparch-proton") and capture("olymparch-proton get " .. g.id):gsub("%s+$", "") or ""
            print(("%-9s %-36s %s"):format(g.id, g.name, tool ~= "" and tool or "default"))
        end
        print("")
        print(L("Pin one: olymparch-proton set APPID TOOL (or default)", "Lås ett: olymparch-proton set APPID VERKTØY (eller default)"))
    elseif name == "zeus" then
        local oly = HOME .. "/.local/bin/olympus"
        if not io.open(oly) then
            print(L("Zeus is not installed. «Install Zeus» installs it; no AI model is downloaded.",
                    "Zeus er ikke installert. «Installer Zeus» installerer den; ingen AI-modell lastes ned."))
        else
            out(capture("timeout 10 " .. sh_quote(oly) .. " --version"))
            print("")
            out(capture("timeout 15 " .. sh_quote(oly) .. " modell"))   -- lists the models; changes nothing
        end
    else
        die("no view " .. name, 2)
    end

-- Settings → Zeus, in a terminal: install Zeus for this user only, or run its setup. Never downloads a model.
elseif cmd == "zeus-install" or cmd == "zeus-setup" then
    local oly = HOME .. "/.local/bin/olympus"
    local present = io.open(oly) ~= nil
    local function pause() io.write("\nEnter …"); io.read() end
    if cmd == "zeus-setup" then
        if not present then print("Zeus er ikke installert: Innstillinger → Zeus → Installer Zeus"); pause(); os.exit(1) end
        os.exit(os.execute(sh_quote(oly) .. " setup") and 0 or 1)
    end
    if present then print("Zeus er allerede installert (" .. oly .. ")"); pause(); os.exit(0) end
    if not have("uv") then print("uv mangler (olymparch update installerer det)"); pause(); os.exit(1) end
    print("Installerer Zeus bare for deg (~/.local/bin/olympus). Ingen AI-modell lastes ned.")
    local ok = os.execute("uv tool install " .. sh_quote("git+https://github.com/Thoaniel/olympus@" .. ZEUS_COMMIT))
    print(ok and "\nFerdig. «Sett opp» velger modell; ingenting lastes ned uten å spørre deg." or "\nInstallasjonen feilet.")
    pause()
    os.exit(ok and 0 or 1)

elseif cmd == "open" then
    if arg[2] then shell_call("page", arg[2]) else shell_call("open") end

elseif cmd == "files" then
    for _, k in ipairs({ "settings", "hypr", "monitors", "profiles", "idle", "hyprland" }) do
        local f = io.open(FILES[k])
        print(("%s %s"):format(f and "✓" or "·", FILES[k]))
        if f then f:close() end
    end

elseif cmd == "check" then
    local values = load_values()
    local bad = 0
    for k, v in pairs(values) do
        local base = k:match("^[^@]+")
        local s = byKey[base]
        if not s then print("unknown key: " .. k); bad = bad + 1
        elseif s.type == "bool" and type(v) ~= "boolean" then print(k .. ": not on/off"); bad = bad + 1
        elseif s.type == "number" and type(v) ~= "number" then print(k .. ": not a number"); bad = bad + 1 end
    end
    if bad > 0 then os.exit(1) end
    print("settings ok (" .. FILES.settings .. ")")

else
    io.write((read(SELF) or ""):match("^#![^\n]*\n(.-)\n\n"):gsub("%-%- ?", ""), "\n")
    os.exit(cmd and cmd ~= "help" and cmd ~= "--help" and 2 or 0)
end
