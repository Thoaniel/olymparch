#!/bin/bash
# Update the whole system the Olymparch way: check space, take a snapshot (pacman hook), update the keyring
# first, then everything else, then refresh the boot menu (pacman hook). Never answers yes on your behalf.
set -euo pipefail
# messages in English, or Norwegian for nb/nn/no (the shared rule: /usr/lib/olymparch/lang.sh)
. /usr/lib/olymparch/lang.sh 2>/dev/null || . "${BASH_SOURCE[0]%/*}/../lib/lang.sh" 2>/dev/null || L() { printf '%s' "$1"; }
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
free=$(df --output=avail -k / | tail -n 1)
(( free > 3 * 1024 * 1024 )) || { echo "$(L "Less than 3 GB free on /. Clean up first (Settings → Disks)." "Under 3 GB ledig på /. Rydd først (Innstillinger → Disker).")" >&2; exit 1; }
pacman -Sy --needed archlinux-keyring
pacman -Su
echo "$(L "Done. If something goes wrong, pick the previous snapshot in the boot menu." "Ferdig. Går noe galt, velg forrige øyeblikksbilde i oppstartsmenyen.")"
